<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      xUnit v3 test projects are stand-alone executables, not libraries. Omitting this
      produces a project that builds but discovers no tests.
    -->
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Documentation stays generated here even though test classes are not API surface:
      IDE0005 (unnecessary usings) only runs when GenerateDocumentationFile is true, and
      catching dead usings in tests is worth more than avoiding an unused XML file. CS1591 is
      suppressed instead, so missing doc comments on test methods are not errors.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Parley.Mcp is referenced so SeparationTests can load the agent server and assert that it
    contains no operator operation. Nothing here calls into it; the reference exists so the
    check can be made against the real binary rather than against a list somebody maintains.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Parley.Mcp\Parley.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Parley.Server\Parley.Server.csproj" />
    <ProjectReference Include="..\..\src\Parley.Transport\Parley.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Parley.Configuration\Parley.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Parley.Cli\Parley.Cli.csproj" />
  </ItemGroup>

  <!--
    Shared, not copied. It points this assembly's manifest resolution at an absent path; see the
    file's own remarks for what it found and why an empty variable does the opposite.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\ManifestIsolation.cs" Link="ManifestIsolation.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>


  <!-- See Directory.Packages.props: one banned symbol, and why. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\BrokerInboxDraining.cs" Link="BrokerInboxDraining.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\InboxCollection.cs" Link="InboxCollection.cs" />
  </ItemGroup>

</Project>
