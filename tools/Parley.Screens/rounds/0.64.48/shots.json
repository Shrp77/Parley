// The site's shot list for Parley 0.64.48 (screens-spec-0.64.48.md), as pages and the clicks before each capture.
// Paths may name {project}, {agent:role} and {exchange:label} from scenario.json.
{
  "theme": "dark",
  "scale": 1,
  "maximumBytes": 800000,
  "shots": [
    { "file": "conversation-tax-pricing.png", "width": 1440, "height": 1300,
      "path": "/Conversations/Detail?project={project}&id=tax-inclusive-pricing",
      "shows": "The tax-inclusive-pricing conversation from the top, vat-rules.md and the person's follow-up to inventory.",
      "storage": { "parley-convo-composer": "closed" }, "actions": [ { "scroll": "top" } ] },
    { "file": "conversation-gift-cards-blocked.png", "width": 1440, "height": 1000,
      "path": "/Conversations/Detail?project={project}&id=gift-cards",
      "shows": "website's request with the gift-card-page.png thumbnail, billing's blocked result, billing's question to the person.",
      "storage": { "parley-convo-composer": "closed" }, "actions": [ { "scroll": "top" } ] },
    { "file": "viewer.png", "width": 1440, "height": 1000,
      "path": "/Conversations/Detail?project={project}&id=gift-cards",
      "shows": "gift-card-page.png opened full size from its thumbnail.",
      "actions": [ { "click": "img[alt*='gift-card-page.png']" }, { "pause": 500 } ] },
    { "file": "media.png", "width": 1440, "height": 1000,
      "path": "/Conversations/Media?project={project}&id=gift-cards",
      "shows": "The Media view of gift-cards: gift-card-page.png placed by website, with its link to the conversation." },
    { "file": "inbox.png", "width": 1440, "height": 1000,
      "path": "/Inbox?scope={project}",
      "shows": "Waiting on you: billing's gift-cards question at the top, opened to show its reply box.",
      "actions": [ { "click": "details.dgrid-row > summary" } ] },
    { "file": "inbox-in-flight.png", "width": 1440, "height": 1000,
      "path": "/Inbox?scope={project}&view=flight",
      "shows": "In flight: exchange #12 to inventory, frozen and not running, with Ask to look now." },
    { "file": "inbox-closed.png", "width": 1440, "height": 1000,
      "path": "/Inbox?scope={project}&view=closed",
      "shows": "Closed: billing's refund-destination exchange #8, Answered." },
    { "file": "graph.png", "width": 1440, "height": 1000, "graph": true,
      "path": "/Conversations/Detail?project={project}&id=tax-inclusive-pricing",
      "shows": "The graph panel pinned beside the tax-inclusive-pricing conversation, the navigation rail folded to make room.",
      "storage": { "parley.nav": "collapsed", "parley-convo-composer": "closed" }, "actions": [ { "scroll": "top" } ] },
    { "file": "roadmaps.png", "width": 1440, "height": 1000,
      "path": "/Roadmaps?project={project}",
      "shows": "Move to net pricing (proposed by orders) above Launch gift cards (confirmed, none started)." },
    { "file": "files.png", "width": 1440, "height": 1000,
      "path": "/Projects/Files?project={project}",
      "shows": "vat-rules.md and gift-card-page.png with conversation, SHA-256 and who placed each." },
    { "file": "agents.png", "width": 1440, "height": 1000,
      "path": "/?tab=agents&project={project}",
      "shows": "Every agent with its owns line, machine and state: working, waiting on background work, open outside Parley, and inventory frozen." },
    { "file": "agent-page.png", "width": 1440, "height": 1000,
      "path": "/Projects/Agent?project={project}&agent={agent:inventory}",
      "shows": "inventory's page while frozen and not running: Start and Unfreeze." }
  ]
}
