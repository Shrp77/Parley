// Every page at two phone widths, for parley-screens audit.
{
  "theme": "light",
  "scale": 1,
  "maximumBytes": 0,
  "shots": [
    {
      "file": "inbox-360.png",
      "width": 360,
      "height": 740,
      "path": "/Inbox?scope={project}",
      "shows": "inbox at 360 wide",
      "storage": {
        "parley-convo-composer": "closed"
      }
    },
    {
      "file": "conversation-360.png",
      "width": 360,
      "height": 740,
      "path": "/Conversations/Detail?project={project}&id=UI-refresh-and-fixes-for-small-screens",
      "shows": "conversation at 360 wide",
      "storage": {
        "parley-convo-composer": "closed"
      }
    },
    {
      "file": "conversation-end-360.png",
      "width": 360,
      "height": 740,
      "path": "/Conversations/Detail?project={project}&id=UI-refresh-and-fixes-for-small-screens",
      "shows": "conversation-end at 360 wide",
      "storage": {
        "parley-convo-composer": "closed"
      },
      "actions": [
        {
          "scroll": "li.turn:last-of-type"
        },
        {
          "pause": 400
        }
      ]
    },
    {
      "file": "conversation-more-360.png",
      "width": 360,
      "height": 740,
      "path": "/Conversations/Detail?project={project}&id=UI-refresh-and-fixes-for-small-screens",
      "shows": "conversation-more at 360 wide",
      "storage": {
        "parley-convo-composer": "closed"
      },
      "actions": [
        {
          "click": ".rail-more > summary"
        },
        {
          "pause": 300
        }
      ]
    },
    {
      "file": "conversation-graph-360.png",
      "width": 360,
      "height": 740,
      "path": "/Conversations/Detail?project={project}&id=UI-refresh-and-fixes-for-small-screens",
      "shows": "conversation-graph at 360 wide",
      "storage": {
        "parley-convo-composer": "closed"
      },
      "actions": [
        {
          "click": ".rail-more > summary"
        },
        {
          "click": "[data-pg-open]"
        },
        {
          "pause": 800
        }
