<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The operator's way in, and a second binary rather than a flag on the first.

    SPEC.md 10.2 warns that an adapter surfacing an operator operation into an agent's tool set
    would breach 10.1, and the protections against that get progressively more structural:
    force_conclude is deliberately not conclude; OperatorConsole is deliberately not Broker; and
    this is deliberately not parley-mcp. An MCP client launches the server it was configured
    with, and the server it was configured with has no operator operation compiled into it.

    Not packable as a tool by accident: this is installed by a person on purpose, and the two
    commands are named apart so 'parley' and 'parley-mcp' cannot be confused in a launch
    configuration.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>parley</AssemblyName>
    <RootNamespace>Parley.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parley</ToolCommandName>
    <PackageId>Parley.Cli</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    Parley.Headless is the fleet supervisor behind `parley up`. It is referenced here, and no
    longer by the server, because keeping agents resident is an operator capability rather than
    something one agent's server does to its peers. SPEC.md section 10.2 keeps operator
    operations off the type an adapter is handed, and starting another agent's process is the
    clearest case of an operation that belongs on this side of that line.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Parley.Broker\Parley.Broker.csproj" />
    <ProjectReference Include="..\Parley.Client\Parley.Client.csproj" />
    <ProjectReference Include="..\Parley.Configuration\Parley.Configuration.csproj" />
    <ProjectReference Include="..\Parley.Headless\Parley.Headless.csproj" />
    <ProjectReference Include="..\Parley.Server\Parley.Server.csproj" />
    <ProjectReference Include="..\Parley.Web\Parley.Web.csproj" />
    <ProjectReference Include="..\Parley.Transport\Parley.Transport.csproj" />
  </ItemGroup>

  <!--
    `parley top`. Version lives in Directory.Packages.props, as central package management
    requires — a Version attribute here is a restore error, not a preference.
  -->
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

</Project>
