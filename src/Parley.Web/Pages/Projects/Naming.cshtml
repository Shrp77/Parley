@page
@model Parley.Web.Pages.Projects.NamingModel
@{
    ViewData["Title"] = $"Naming {Model.Project}";
}

<h1>Naming @Model.Project</h1>

@if (Model.NewName is { Length: > 0 } wanted)
{
    @if (Model.NewNameValid)
    {
        <p class="outcome" role="status">
            You asked for the name <strong>@wanted</strong>. Nothing has been changed. To use it, follow the steps
            below and give the terminal that name.
        </p>
    }
    else
    {
        <p class="unreachable" role="alert">
            <strong>@wanted</strong> is not a name a project can have. Nothing has been changed.
        </p>
    }
}

@if (Model.Named)
{
    <h2>Rename it</h2>

    <p>
        Rename is two steps on the terminal's project screen: remove the old name, then name the new one.
        Removing deletes nothing. It only forgets how this machine reaches the deployment.
    </p>

    <pre><code>parley</code></pre>

    <p>
        <strong>The new project does not get this project's conversations.</strong> They stay in the old store.
        Then return to <a href="/">the project list</a>.
    </p>
}
else
{
    <h2>Name it</h2>

    <p>This broker has no project name on this machine. Give it one:</p>

    <pre><code>parley</code></pre>

    <p>
        Naming creates a new project with its own store. <strong>It will not be the broker above</strong>, which keeps
        its own store. The new project appears on <a href="/">the project list</a> in its place.
    </p>
}
