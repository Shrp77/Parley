@page
@model Parley.Web.Pages.Projects.AgentModel
@using Parley.Core
@{
    ViewData["Refresh"] = "30";
    ViewData["Title"] = Model.Agent;
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}
else if (Model.Record is not { } agent)
{
    <h1>@Model.Agent</h1>
    @* Not an error. A name can leave the registry while a link to it is still on somebody's
       screen -- purged, or never registered at all -- and saying so is the answer. *@
    <p>This project has no agent by that name.</p>
}
else
{
    <h1 class="slot-@Palette.SlotFor(agent.Name)">
        <span class="who" aria-hidden="true">@Palette.BadgeFor(agent.Name)</span>
        @agent.Name.Value
    </h1>

    <p class="lede">
        @if (agent.Owns is { Length: > 0 } owns)
        {
            @owns
        }
        else
        {
            @* Never invent one. An absent statement is a fact about the deployment. *@
            <em>Has not stated what it owns.</em>
        }
    </p>

    @* Each fact names itself, and an (i) beside it says what it means and what else it could be (the person's feedback on
       feature 042). A fold-out, so it opens with no script. *@
    <table class="registry">
        <caption class="registry-caption">Registry entry</caption>
        <tbody>
            <tr>
                <th scope="row" abbr="State">State <details class="info-tip"><summary aria-label="What State means" title="What State means"><span class="icon" aria-hidden="true">info</span></summary><div class="info-text">What it is doing now. <b>Working</b>: a turn is running. <b>Background work running</b>: its turn ended while work it started still runs. <b>Stopped</b>: its last turn ended with work still owed. <b>Running</b> or <b>idle</b>: attached, with no turn running. <b>Startable</b>: nobody has it open, and its machine can start it. <b>Stranded</b>: its machine cannot be reached, so nothing can start it. <b>Open outside Parley</b>: somebody opened it themselves, so Parley cannot give it turns.</div></details></th>
                <td>@Parley.Client.Views.Activities.Now(agent, DateTimeOffset.UtcNow).Words</td>
            </tr>
            <tr>
                <th scope="row" abbr="Tier">Tier <details class="info-tip"><summary aria-label="What Tier means" title="What Tier means"><span class="icon" aria-hidden="true">info</span></summary><div class="info-text">How messages reach it. <b>Full</b>: a message can reach it in the middle of a turn. <b>Pull</b>: it sees messages only when it next collects them, so it is never interrupted. <b>Headless</b>: no session of its own; Parley asks it one question at a time and takes its reply.</div></details></th>
                <td>@agent.Tier</td>
            </tr>
            <tr>
                <th scope="row" abbr="Adapter">Adapter <details class="info-tip"><summary aria-label="What Adapter means" title="What Adapter means"><span class="icon" aria-hidden="true">info</span></summary><div class="info-text">The program that connects it to Parley. <b>mcp</b> is parley-mcp, run by an AI coding tool such as Claude Code. The console that seats you is <b>parley-console</b>, and Parley's own facilitator is <b>parley-facilitator</b>.</div></details></th>
                <td>@agent.Adapter</td>
            </tr>
            <tr>
                <th scope="row" abbr="Workspace">Workspace <details class="info-tip"><summary aria-label="What Workspace means" title="What Workspace means"><span class="icon" aria-hidden="true">info</span></summary><div class="info-text">The repository folder it works in, on its machine. Only you see this; other agents are never told it.</div></details></th>
                @* The operator's view, and only the operator's: §10.1's agents() withholds this
                   from a peer on purpose. *@
                <td>@(agent.Workspace is { Length: > 0 } where ? where : "not recorded")</td>
            </tr>
            <tr>
                <th scope="row" abbr="Connected">Connected <details class="info-tip"><summary aria-label="What Connected means" title="What Connected means"><span class="icon" aria-hidden="true">info</span></summary><div class="info-text">Whether its program is attached to Parley right now. <b>no</b> is the usual state of an agent nobody has open: messages for it wait until it next connects.</div></details></th>
                <td>@(agent.Connected ? "yes" : "no")</td>
            </tr>
        </tbody>
    </table>

    @if (Parley.Core.PersonSeat.Is(agent.Name))
    {
        @* The person's seat: a person is asked, never started, retired or purged, and owns no repository, so the rail offers
           no command for it. Said once instead. *@
        <p>This is you.</p>
    }
    else if (agent.Presence == AgentPresence.Running && agent.Unsupervised)
    {
        <p role="status"><strong>Left running.</strong> @Parley.Client.Rendering.StoppingWords.LeftRunning</p>
    }
}

@section Actions {
    @if (Model.Problem is not { Length: > 0 } && Model.Record is { } seat && Parley.Core.PersonSeat.Is(seat.Name))
    {
        @* The person's own seat: nothing to start, freeze or withdraw, but its conversations are still worth finding. *@
        <a class="rail-link" href="/Projects/Agents?project=@Model.Project&amp;participant=@seat.Name.Value" title="The conversations you are party to"><span class="icon" aria-hidden="true">chat_bubble</span><span class="rail-label">Conversations</span></a>
    }
    else if (Model.Problem is not { Length: > 0 } && Model.Record is { } agent)
    {
        @* This agent's commands, in the rail like every page's (feature 042), each named in a word or two (the person's
           feedback: "Owns", not "What this agent is responsible for"). Each still opens a page that describes the act before
           anything happens; Retire and Purge say there that they reach this project only. Owns sits first because it costs
           nothing and is what somebody is most often here for: one statement per agent, which the agent proposes and the
           person may override, both on the ownership page. *@
        <a class="rail-link" href="/Projects/Ownership?project=@Model.Project#agent-@agent.Name.Value" title="What this agent is responsible for"><span class="icon" aria-hidden="true">description</span><span class="rail-label">Owns</span></a>
        @if (agent.Presence == AgentPresence.Running && agent.Unsupervised)
        {
            @* A node that is gone started it, so nothing holds it: it cannot be stopped at the end of its turn, and it is
               not somebody's editor, so ending it is not taking their session. Starting another would put two models in one
               checkout, which is why Start is not offered. *@
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=kill&amp;subject=@agent.Name.Value"
               title="End its process now. What it is part-way through is lost. Unless it is frozen, the next work for it starts it again."><span class="icon" aria-hidden="true">close</span><span class="rail-label">Kill process</span></a>
        }
        else if (agent.Presence == AgentPresence.Running && !agent.OpenOutside && agent.Frozen)
        {
            @* Frozen, so its node already stops it once its turn ends, and the broker refuses a restart: neither is offered, as
               in the terminal. Unfreeze is below. *@
        }
        else if (agent.Presence == AgentPresence.Running && !agent.OpenOutside)
        {
            @* Only a process Parley started: one open outside Parley belongs to whoever opened it, and no node holds it. *@
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=restart&amp;subject=@agent.Name.Value"
               title="Stop it once its current turn is over and start it again."><span class="icon" aria-hidden="true">chevron_right</span><span class="rail-label">Restart</span></a>
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=stop&amp;subject=@agent.Name.Value"
               title="Stop it once its current turn is over. The next work for it starts it again."><span class="icon" aria-hidden="true">remove</span><span class="rail-label">Stop</span></a>
        }
        else
        {
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=start&amp;subject=@agent.Name.Value" title="Start it now."><span class="icon" aria-hidden="true">chevron_right</span><span class="rail-label">Start</span></a>
        }
        @if (agent.Status != AgentStatus.Retired && agent.Frozen)
        {
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=unfreeze&amp;subject=@agent.Name.Value"
               title="Let it be started again, by work waiting for it or by you."><span class="icon" aria-hidden="true">check</span><span class="rail-label">Unfreeze</span></a>
        }
        else if (agent.Status != AgentStatus.Retired)
        {
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=freeze&amp;subject=@agent.Name.Value"
               title="Stop it once its turn ends and keep anything from starting it until you unfreeze it, or until the broker next starts (a logon, a reboot, installing a new build, or a crash) unless you ask it to stay frozen through one. What it owes stays open."><span class="icon" aria-hidden="true">warning</span><span class="rail-label">Freeze</span></a>
        }
        <a class="rail-link" href="/Projects/Agents?project=@Model.Project&amp;participant=@agent.Name.Value" title="The conversations this agent is party to"><span class="icon" aria-hidden="true">chat_bubble</span><span class="rail-label">Conversations</span></a>
        @if (agent.Status == AgentStatus.Retired)
        {
            <a class="rail-link" href="/Projects/Act?project=@Model.Project&amp;action=reinstate&amp;subject=@agent.Name.Value"
               title="Route to it again in @Model.Project."><span class="icon" aria-hidden="true">add</span><span class="rail-label">Reinstate</span></a>
        }
        else
        {
            <a class="rail-link danger-link" href="/Projects/Act?project=@Model.Project&amp;action=retire&amp;subject=@agent.Name.Value"
               title="Take it off @Model.Project's roster. Its history stays and Reinstate brings it back. Other projects are not touched."><span class="icon" aria-hidden="true">remove</span><span class="rail-label">Retire</span></a>
        }
        <a class="rail-link danger-link" href="/Projects/Act?project=@Model.Project&amp;action=purge&amp;subject=@agent.Name.Value"
           title="Delete it from @Model.Project with every conversation it was in. Cannot be undone. Other projects are not touched."><span class="icon" aria-hidden="true">close</span><span class="rail-label">Purge</span></a>
    }
}
