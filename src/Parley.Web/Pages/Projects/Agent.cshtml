@page
@model Parley.Web.Pages.Projects.AgentModel
@using Parley.Core
@{
    ViewData["Refresh"] = "30";
    ViewData["Title"] = Model.Agent;
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

<nav class="page-links" aria-label="This project">
    <a href="/?tab=agents&amp;project=@Model.Project">Agents in @Model.Project</a>
    <a href="/Projects/Agents?project=@Model.Project">Conversations</a>
</nav>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}
else if (Model.Record is not { } agent)
{
    <h1>@Model.Agent</h1>
    @* Not an error. A name can leave the registry while a link to it is still on somebody's
       screen -- purged, or never registered at all -- and saying so is the answer. *@
    <p>This project has no agent by that name.</p>
}
else
{
    <h1 class="slot-@Palette.SlotFor(agent.Name)">
        <span class="who" aria-hidden="true">@Palette.BadgeFor(agent.Name)</span>
        @agent.Name.Value
    </h1>

    <p class="lede">
        @if (agent.Owns is { Length: > 0 } owns)
        {
            @owns
        }
        else
        {
            @* Never invent one. An absent statement is a fact about the deployment. *@
            <em>Has not stated what it owns.</em>
        }
    </p>

    <table>
        <caption>What the registry holds</caption>
        <tbody>
            <tr>
                <th scope="row">State</th>
                <td>@Parley.Client.Views.Activities.Now(agent, DateTimeOffset.UtcNow).Words</td>
            </tr>
            <tr>
                <th scope="row">Tier</th>
                <td>@agent.Tier</td>
            </tr>
            <tr>
                <th scope="row">Adapter</th>
                <td>@agent.Adapter</td>
            </tr>
            <tr>
                <th scope="row">Workspace</th>
                @* The operator's view, and only the operator's: §10.1's agents() withholds this
                   from a peer on purpose. *@
                <td>@(agent.Workspace is { Length: > 0 } where ? where : "not recorded")</td>
            </tr>
            <tr>
                <th scope="row">Connected</th>
                <td>@(agent.Connected ? "yes" : "no")</td>
            </tr>
        </tbody>
    </table>

    <h2>Do something</h2>

    @* Responsibility sits first because it costs nothing and is what somebody is most often here for.
       It is one statement per agent: the agent proposes it and the person may override it, and both
       the asking and the writing are on the ownership page. *@
    @if (Parley.Core.PersonSeat.Is(agent.Name))
    {
        @* The person's seat: a person is asked, never started, retired or purged, and owns no
           repository — so every action below would only be refused. Said once instead. *@
        <p>This is you.</p>
    }
    else
    {
    @* Buttons, not words: the safe ones tonal, the two that take the agent away outlined in the error colour. Each still
       opens a page that describes the act before anything happens. *@
    <div class="actions" role="group" aria-label="Actions">
        <a class="button tonal" href="/Projects/Ownership?project=@Model.Project#agent-@agent.Name.Value">What this agent is responsible for</a>
        <a class="button tonal" href="/Projects/Act?project=@Model.Project&amp;action=start&amp;subject=@agent.Name.Value">Start</a>
        @if (agent.Status == AgentStatus.Retired)
        {
            <a class="button tonal" href="/Projects/Act?project=@Model.Project&amp;action=reinstate&amp;subject=@agent.Name.Value"
               title="Route to it again in @Model.Project.">Reinstate</a>
        }
        else
        {
            <a class="button danger" href="/Projects/Act?project=@Model.Project&amp;action=retire&amp;subject=@agent.Name.Value"
               title="Take it off @Model.Project's roster. Its history stays and Reinstate brings it back, but its launch entry is removed and is not written again. Other projects are not touched.">Retire</a>
        }
        <a class="button danger" href="/Projects/Act?project=@Model.Project&amp;action=purge&amp;subject=@agent.Name.Value"
           title="Delete it from @Model.Project with every conversation it was in. Cannot be undone. Other projects are not touched.">Purge</a>
    </div>
    @* Said on the page as well as on hover: a title is never shown on a touch screen or to the keyboard, and "remove"
       reads as "remove from Parley". Each project is its own store (SPEC.md §4.1), so neither act reaches another one. *@
    <p class="composer-note scope-note">
        Retire and Purge act in @Model.Project only. If this repository is also an agent in other projects, it stays there.
        Retire can be undone; Purge deletes its conversations here and cannot.
    </p>
    }

    <p class="actions">
        <a class="button quiet" href="/Projects/Agents?project=@Model.Project&amp;participant=@agent.Name.Value">Conversations this agent is party to</a>
    </p>
}
