@page
@model Parley.Web.Pages.Projects.HealthModel
@using Parley.Core
@{
    ViewData["Refresh"] = "60";
    ViewData["Title"] = $"Health of {Model.Project}";
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

<h1>Health of @Model.Project</h1>

<nav class="page-links" aria-label="This project">
    <a href="/?tab=agents&amp;project=@Model.Project">Agents</a>
    <a href="/Projects/Agents?project=@Model.Project">Conversations</a>
    <a href="/Projects/Act?project=@Model.Project&amp;action=prune&amp;subject=@Model.Project">Apply the retention policy now</a>
</nav>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}
else
{
    <section>
        <h2>Work that needs you</h2>
        @* Nothing times out, so this is the only way stalled work ends: a person sees it here and
           closes the conversation, or goes and asks why. *@
        @if (Model.Flags is { IsEmpty: false } flags)
        {
            @if (flags.Exchanges.Count > 0)
            {
                <ul>
                @foreach (var flag in flags.Exchanges)
                {
                    <li>
                        @HealthModel.Describe(flag)
                        <a href="/Conversations/Detail?project=@Model.Project&amp;id=@flag.ConversationId">@flag.ConversationId</a>
                        ·
                        <a href="/Projects/Act?project=@Model.Project&amp;action=forceconclude&amp;subject=@flag.ConversationId">close it</a>
                    </li>
                }
                </ul>
            }

            @if (flags.Cycles.Count > 0)
            {
                <h3>Requests that went round in a circle</h3>
                <ul>
                @foreach (var cycle in flags.Cycles)
                {
                    <li>
                        @string.Join(" -> ", cycle.Path.Select(a => a.Value)) in
                        <a href="/Conversations/Detail?project=@Model.Project&amp;id=@cycle.ConversationId">@cycle.ConversationId</a>
                    </li>
                }
                </ul>
            }
        }
        else
        {
            <p>Nothing is flagged.</p>
        }
    </section>

    <section>
        <h2>Who is waiting on whom</h2>
        @* Work nobody is going to do looks exactly like work not done yet, from inside the pair.
           Only a read across pairs tells them apart, which is why this is an operator's view and
           not an agent's. *@
        @if (Model.Waiting.Count == 0)
        {
            <p>Nobody is waiting on a result.</p>
        }
        else
        {
            <ul>
            @foreach (var edge in Model.Waiting)
            {
                <li>
                    @edge.Waiter.Value is waiting on @edge.WaitedOn.Value
                    (exchange @edge.ExchangeId)
                </li>
            }
            </ul>
        }
    </section>

    <section>
        <h2>How long messages have been</h2>
        @* Lengths only. They outlive the messages, so this does not fall when a conversation is pruned. *@
        @if (Model.Lengths is not { Overall.Messages: > 0 } lengths)
        {
            <p>No message has been recorded.</p>
        }
        else
        {
            <table>
                <caption>Messages by type, and by position in the conversation</caption>
                <thead>
                    <tr>
                        <th scope="col">Messages</th>
                        <th scope="col">How many</th>
                        <th scope="col">Median</th>
                        <th scope="col">Longest</th>
                        <th scope="col">Past @MessageLimits.SoftPayloadCharacters</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var group in new[] { lengths.Overall }.Concat(lengths.ByType).Concat(lengths.ByPosition))
                {
                    <tr>
                        <td>@group.Name</td>
                        <td>@group.Messages</td>
                        <td>@group.Median characters</td>
                        <td>@group.Longest characters</td>
                        <td>@group.OverSoftLimit</td>
                    </tr>
                }
                </tbody>
            </table>
            <table>
                <caption>Messages by agent, the longest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Agent</th>
                        <th scope="col">Sent</th>
                        <th scope="col">Received</th>
                        <th scope="col">Longest</th>
                        <th scope="col">Past @MessageLimits.SoftPayloadCharacters</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var agent in lengths.ByAgent)
                {
                    <tr>
                        <td>@agent.Agent.Value</td>
                        <td>@agent.Sent</td>
                        <td>@agent.Received</td>
                        <td>@agent.Longest characters</td>
                        <td>@agent.OverSoftLimit</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>What the size limit refused</h2>
        @* The limit is the owner's decision (SPEC.md §17 question 16). One refusal is the first row of a case rather than
           a case: what makes it one is the same agents refused repeatedly at similar sizes. *@
        @if (Model.Refusals.Count == 0)
        {
            <p>Nothing has been refused for being too long.</p>
        }
        else
        {
            <table>
                <caption>Refusals by agent and message type</caption>
                <thead>
                    <tr>
                        <th scope="col">Agent</th>
                        <th scope="col">Type</th>
                        <th scope="col">Refused</th>
                        <th scope="col">Largest attempt</th>
                        <th scope="col">Limit in force</th>
                        <th scope="col">Most recent</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var refusal in Model.Refusals)
                {
                    <tr>
                        <td>@refusal.Agent.Value</td>
                        <td>@refusal.Type</td>
                        <td>@refusal.Refusals</td>
                        <td>@refusal.Worst characters</td>
                        <td>@refusal.Cap</td>
                        <td>@refusal.LastUtc.ToString("u")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>What clarification cost</h2>
        @if (Model.Clarifications is { Exchanges: > 0 } clarify)
        {
            <p>
                @clarify.Exchanges exchanges asked for clarification, the deepest reaching
                @clarify.DeepestReached rounds. @clarify.ExchangesAtCap ran out of rounds.
            </p>
            @* Results that mixed outcomes are the interesting number: work that came back
               partly done says the request carried more than one thing. *@
            <p>
                @clarify.Results results followed, of which
                @clarify.ResultsWithMixedOutcomes mixed outcomes across their items.
            </p>
        }
        else
        {
            <p>Nothing has been clarified.</p>
        }
    </section>

    <section>
        <h2>What results reported</h2>
        @if (Model.Results is { IsEmpty: false } results)
        {
            <table>
                <caption>Item outcomes by the agent that reported them</caption>
                <thead>
                    <tr>
                        <th scope="col">Agent</th>
                        <th scope="col">Responder</th>
                        <th scope="col">Outcome</th>
                        <th scope="col">Items</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in results.Outcomes)
                {
                    <tr>
                        <td>@row.Agent</td>
                        <td>@row.ResponderModel</td>
                        <td>@OutcomeTokens.Format(row.Outcome)</td>
                        <td>@row.Items</td>
                    </tr>
                }
                </tbody>
            </table>

            @if (results.Blockers.Count > 0)
            {
                <h3>What blocked them</h3>
                @* A blocker is a boundary or a gap someone can fix, which is why the kind is kept. *@
                <ul>
                @foreach (var row in results.Blockers)
                {
                    <li>@row.Agent: @row.Items blocked by @OutcomeTokens.Format(row.Kind).Replace('_', ' ')</li>
                }
                </ul>
            }

            @if (results.Sources.Count > 0)
            {
                <h3>Who they relied on</h3>
                <ul>
                @foreach (var row in results.Sources)
                {
                    <li>@row.Agent relied on @row.Source for @row.Items item@(row.Items == 1 ? "" : "s")</li>
                }
                </ul>
            }

            @if (results.Closures.Count > 0)
            {
                <h3>How their conversations ended</h3>
                <ul>
                @foreach (var row in results.Closures)
                {
                    <li>@row.Agent: @row.ByConsensus by agreement, @row.ByPerson closed by a person</li>
                }
                </ul>
            }
        }
        else
        {
            <p>No results have been sent yet.</p>
        }
    </section>
}
