@page
@model Parley.Web.Pages.Projects.ActModel
@{
    ViewData["Title"] = $"{Model.Action} {Model.Subject}";
}

<h1>@Model.Action @Model.Subject</h1>

@if (Model.Outcome is { Length: > 0 } outcome)
{
    <p role="status"><strong>@outcome</strong></p>
    <p><a href="/Projects/Agents?project=@Model.Project">Back to @Model.Project</a></p>
}
else
{
    <p class="@(Model.Destroys ? "unreachable" : null)">@Model.Warning</p>

    <form method="post">
        @if (string.Equals(Model.Action, "instruct", StringComparison.OrdinalIgnoreCase))
        {
            <p>
                <label for="text">What should it do?</label><br />
                <textarea id="text" name="text" rows="6" cols="70" required></textarea>
            </p>
        }

        @if (string.Equals(Model.Action, "ownership", StringComparison.OrdinalIgnoreCase))
        {
            @* No maxlength: the bound on this line was removed at 0.33.0 and no surface may print the
               sentinel that replaced it (0.25.8's rule). What the field must not do is offer a cap the
               store does not hold, which is how a person comes to trust a number nobody chose.

               Empty rather than pre-filled with the line the agent currently has. This page records
               what a person writes as *theirs*, and putting words in the box that came from somewhere
               else is how the one distinction 020 exists to keep -- a person's line from a model's --
               stops being reliable. The agent's own proposal is accepted from the conversation it was
               argued in, which is the terminal's review dialog and not this form. *@
            <p>
                <label for="text">What does it own, and what does it not?</label><br />
                <textarea id="text" name="text" rows="4" cols="70" required></textarea>
            </p>
        }

        @if (string.Equals(Model.Action, "acceptanswer", StringComparison.OrdinalIgnoreCase) && Model.Proposed is { } proposed)
        {
            @* The one box on this page that opens holding somebody else's words, and it says whose. Unchanged, they are
               recorded as the agent's; changed, as your edit. The comparison is made again at the POST against what the
               agent actually said, so nothing in this form decides it. *@
            <p>
                <label for="text">The agent's own words, on one line. Edit them if they are wrong:</label><br />
                <textarea id="text" name="text" rows="4" cols="70">@proposed</textarea>
            </p>
        }

        @if (string.Equals(Model.Action, "replyaskedback", StringComparison.OrdinalIgnoreCase))
        {
            <p>
                <label for="text">Your reply, sent through Parley as your words:</label><br />
                <textarea id="text" name="text" rows="4" cols="70" required></textarea>
            </p>
        }

        @if (string.Equals(Model.Action, "forceconclude", StringComparison.OrdinalIgnoreCase))
        {
            <p>
                <label for="reason">Why are you closing it? Each participant holding open work is told.</label><br />
                <textarea id="reason" name="reason" rows="3" cols="70" maxlength="1000"></textarea>
            </p>
        }

        <button type="submit">
            @(Model.Destroys ? "Yes, destroy it" : "Confirm")
        </button>
        <a href="/Projects/Agents?project=@Model.Project">Cancel</a>
    </form>
}
