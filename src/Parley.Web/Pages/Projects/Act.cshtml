@page
@model Parley.Web.Pages.Projects.ActModel
@{
    ViewData["Title"] = $"{Model.Action} {Model.Subject}";
}

<h1>@Model.Action @Model.Subject</h1>

@if (Model.Outcome is { Length: > 0 } outcome)
{
    <p role="status"><strong>@outcome</strong></p>
    <nav class="page-links" aria-label="This project"><a href="/Projects/Agents?project=@Model.Project">Back to @Model.Project</a></nav>
}
else
{
    <p class="@(Model.Destroys ? "unreachable" : null)">@Model.Warning</p>

    @if (Model.Owes is { Length: > 0 } owes)
    {
        <p><strong>It owes</strong> @owes.</p>
    }

    <form method="post">
        @if (Model.Withdraws)
        {
            @* The terminal's door, here too (Parley.Setup's AgentWithdrawal holds both): what it owes, an acceptance when
               purging would leave somebody waiting on nothing, then the agent's own name typed back. Anything but the exact
               name keeps it. *@
            @if (string.Equals(Model.Action, "purge", StringComparison.OrdinalIgnoreCase) && Model.OwedConsequence is { } consequence)
            {
                <p class="unreachable">@consequence</p>
                <p><label><input type="checkbox" name="AcceptOwed" value="true" required /> @Parley.Setup.AgentWithdrawal.AcceptOwed</label></p>
            }

            <div class="field withdraw-name">
                <label for="typed">@Parley.Setup.AgentWithdrawal.TypeTheName <code>@Model.Subject</code></label>
                <input id="typed" name="Typed" required autocomplete="off" spellcheck="false" autocapitalize="none" />
            </div>
        }

        @if (string.Equals(Model.Action, "ownership", StringComparison.OrdinalIgnoreCase))
        {
            @* No maxlength: the store holds no bound on this line, and the field must not offer a cap
               the store does not hold, which is how a person comes to trust a number nobody chose.

               Empty rather than pre-filled with the line the agent currently has. This page records
               what a person writes as *theirs*, and putting words in the box that came from somewhere
               else is how a person's line stops being distinguishable from a model's. The agent's own proposal is accepted from the conversation it was
               argued in, which is the terminal's review dialog and not this form. *@
            <p>
                <partial name="_Composer" model="@(new Parley.Web.ComposerBox("text", Id: "text", Rows: 4, Label: "What does it own, and what does it not?"))" />
            </p>
        }

        @if (string.Equals(Model.Action, "acceptanswer", StringComparison.OrdinalIgnoreCase) && Model.Proposed is { } proposed)
        {
            @* The one box on this page that opens holding somebody else's words, and it says whose. Unchanged, they are
               recorded as the agent's; changed, as your edit. The comparison is made again at the POST against what the
               agent actually said, so nothing in this form decides it. *@
            <p>
                <partial name="_Composer" model="@(new Parley.Web.ComposerBox(
                    "text", proposed, Id: "text", Rows: 4, Label: "The agent's words, on one line. Edit if wrong:", Required: false))" />
            </p>
        }

        @if (string.Equals(Model.Action, "replyaskedback", StringComparison.OrdinalIgnoreCase))
        {
            @* A message to the agent, so it is the console's one composer, with the same keys as every other. *@
            <p>
                <partial name="_Composer" model="@(new Parley.Web.ComposerBox(
                    "text", Id: "text", Rows: 4, Label: "Your reply:", Draft: $"{Model.Project}/asked-back/{Model.Subject}", Mentions: Model.Mentionable))" />
            </p>
        }

        @if (string.Equals(Model.Action, "freeze", StringComparison.OrdinalIgnoreCase) || string.Equals(Model.Action, "freezeall", StringComparison.OrdinalIgnoreCase))
        {
            @* The choice that makes a freeze outlast a logon. Unchecked, the next start of the broker lifts it. *@
            <p>
                <label><input type="checkbox" name="KeepFrozen" value="true" /> Do not unfreeze on logon: keep @(string.Equals(Model.Action, "freezeall", StringComparison.OrdinalIgnoreCase) ? "them" : "it") frozen until I unfreeze @(string.Equals(Model.Action, "freezeall", StringComparison.OrdinalIgnoreCase) ? "them" : "it") myself.</label>
            </p>
        }

        @if (string.Equals(Model.Action, "forceconclude", StringComparison.OrdinalIgnoreCase))
        {
            <p>
                <partial name="_Composer" model="@(new Parley.Web.ComposerBox(
                    "reason", Id: "reason", Label: "Why are you closing it? Each participant holding open work is told.",
                    Required: false, MaxLength: 1000))" />
            </p>
        }

        <p class="actions">
            <button type="submit" class="@(Model.Destroys ? "danger act" : null)">
                @(Model.Destroys ? "Yes, destroy it" : "Confirm")
            </button>
            <a class="button quiet" href="/Projects/Agents?project=@Model.Project">Cancel</a>
        </p>
    </form>
    <style>
        /* One thing per row: the acceptance, the name, then the buttons. The frame lays a form out as a wrapping row. */
        form > p, form > .withdraw-name { flex: 1 1 100%; }
        .withdraw-name { display: flex; flex-direction: column; gap: 0.3rem; margin: 0.25rem 0 0; }
        .withdraw-name input { max-width: 28rem; }
    </style>
}
