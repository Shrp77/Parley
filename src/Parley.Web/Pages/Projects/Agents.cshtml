@page
@model Parley.Web.Pages.Projects.AgentsModel
@using Parley.Core
@using Parley.Web.Pages.Shared
@{
    ViewData["Refresh"] = "30";
    ViewData["Title"] = Model.Project;
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

<div class="view" style="height:auto;min-height:0;">
    <div class="view-title">
        <h1>Conversations</h1>
        <p class="as-of" role="status"><strong>@Model.Project</strong></p>
    </div>

    <section aria-label="Conversations in this project" class="conversations">
        @* Starting one belongs beside the list of them. Naming a conversation is what creates it, so a
           project with none needs a way in from here. *@
        <p class="new-conversation"><button type="button" id="new-conversation-open" class="new-button">New conversation</button></p>

        <dialog id="new-conversation-dialog" class="default-dialog" aria-labelledby="new-conversation-title">
            <form method="get" action="/Conversations/Detail">
                <h3 id="new-conversation-title">New conversation</h3>
                <input type="hidden" name="project" value="@Model.Project" />
                <div class="field">
                    <input id="new-conversation" name="id" aria-label="Name of the conversation" placeholder="what-it-is-about" required
                           maxlength="@ConversationName.Longest" pattern="@ConversationName.Pattern"
                           data-correct="@ConversationName.Allowed"
                           autocomplete="off" spellcheck="false"
                           aria-describedby="new-conversation-rule" />
                </div>

                @* The rule is applied as it is typed rather than reported afterwards. *@
                <p id="new-conversation-rule" class="composer-note">
                    @ConversationName.Rule
                    <span id="new-conversation-corrected" role="status" hidden>
                        @ConversationName.WasCorrected.
                    </span>
                </p>
                <p class="dialog-actions">
                    <button type="submit" class="new-button">Start</button>
                    <button type="button" id="new-conversation-cancel" class="quiet">Cancel</button>
                </p>
            </form>
        </dialog>

        @* Filtered by who is party to them. The agents come from the roster; a name that is not on it (an agent since
           retired, or one typed into a link) stays in the list so that the filter says what it is applying. *@
        <form method="get" class="view-card view-filters" aria-label="Filter the conversations">
            <input type="hidden" name="project" value="@Model.Project" />
            <input type="hidden" name="sort" value="@Model.Sort" />
            <div class="field wide">
                <label for="participant">Agent</label>
                <select id="participant" name="participant">
                    <option value="">Any agent</option>
                    @foreach (var name in Model.ParticipantChoices)
                    {
                        <option value="@name" selected="@(string.Equals(Model.Participant, name, StringComparison.Ordinal) ? "selected" : null)">@name</option>
                    }
                </select>
            </div>
            <label class="toggle"><input type="checkbox" name="showArchived" value="true" checked="@(Model.ShowArchived ? "checked" : null)" /> <span>Include archived</span></label>
            <button type="submit">Filter</button>
            <a class="button quiet" href="/Projects/Agents?project=@Model.Project">Clear</a>
        </form>

        @if (Model.Problem is { Length: > 0 } rosterProblem && Model.ConversationProblem is not { Length: > 0 })
        {
            <p class="unreachable" role="alert">The agents could not be listed to filter by: @rosterProblem</p>
        }

        @if (Model.FilterProblem is { Length: > 0 } filter)
        {
            <p class="unreachable" role="alert">@filter</p>
        }

        @if (Model.Hidden is { Length: > 0 } hidden)
        {
            @* Said whenever anything is archived: an archived conversation leaves the list, and
               something must say where it went and how to bring it back. *@
            <p class="composer-note">
                @hidden <a href="/Projects/Agents?project=@Model.Project&amp;showArchived=true">Show them</a>
            </p>
        }

        @if (Model.ConversationProblem is { Length: > 0 } unread)
        {
            <p class="unreachable" role="alert">@unread</p>
        }
        else if (Model.Conversations.Count == 0)
        {
            <p>No conversations match in @Model.Project.</p>
        }
        else
        {
            <div class="grid" role="table" aria-label="Conversations">
                <div class="grid-head" role="row">
                    <a role="columnheader" href="/Projects/Agents?project=@Model.Project&amp;participant=@Model.Participant&amp;showArchived=@(Model.ShowArchived ? "true" : "false")&amp;sort=name">Name</a>
                    <span role="columnheader">Messages</span>
                    <a role="columnheader" href="/Projects/Agents?project=@Model.Project&amp;participant=@Model.Participant&amp;showArchived=@(Model.ShowArchived ? "true" : "false")">Last active</a>
                </div>
                @foreach (var conversation in Model.Conversations)
                {
                    @* A row opens to show who is in it and what can be done to it. A native details element, so
                       it works with no script. *@
                    <details class="grid-row" role="row">
                        <summary>
                            <a class="name" href="/Conversations/Detail?project=@Model.Project&amp;id=@conversation.Id">@conversation.Id</a>
                            <span class="num">@conversation.Messages</span>
                            <span class="when">
                                @conversation.LastActivityUtc.ToString("d MMM yyyy, HH:mm")
                                @if (conversation.HasOpenExchange)
                                {
                                    @* A question somebody still owes an answer to. Said in words; the tint is only how you find it. *@
                                    <span class="tag open">still open</span>
                                }
                                @if (conversation.Archived)
                                {
                                    <span class="tag">archived</span>
                                }
                                @if (conversation.Item is { } item)
                                {
                                    @* Which roadmap item this is the work on, from the broker's reservation and never the name. *@
                                    <span class="tag">@Parley.Client.Roadmaps.ItemWording.Belongs(item)</span>
                                }
                            </span>
                        </summary>
                        <div class="grid-detail">
                            <p class="between">@string.Join(", ", conversation.Participants.Select(p => p.Value))</p>
                            @* Archiving is one click because one click reverses it; destroying goes to a page that
                               describes it and takes the name typed. *@
                            <form method="post" asp-page-handler="Archive">
                                <input type="hidden" name="project" value="@Model.Project" />
                                <input type="hidden" name="id" value="@conversation.Id" />
                                <input type="hidden" name="archived" value="@(conversation.Archived ? "true" : "false")" />
                                <input type="hidden" name="showArchived" value="@(Model.ShowArchived ? "true" : "false")" />
                                <input type="hidden" name="sort" value="@Model.Sort" />
                                <button type="submit">@(conversation.Archived ? "Bring back" : "Archive")</button>
                            </form>
                            <a class="button danger" href="/Conversations/Destroy?project=@Model.Project&amp;id=@conversation.Id">Destroy…</a>
                        </div>
                    </details>
                }
            </div>

            @if (Model.NextPageToken is { Length: > 0 } next)
            {
                <p>
                    <a href="/Projects/Agents?project=@Model.Project&amp;participant=@Model.Participant&amp;pageToken=@Uri.EscapeDataString(next)">Older conversations</a>
                </p>
            }
        }
    </section>
</div>

@section Scripts {
    <script>
        // A name is asked for in a dialog rather than in the page, so that the list keeps its place.
        (function () {
            var dialog = document.getElementById("new-conversation-dialog");
            var open = document.getElementById("new-conversation-open");
            var cancel = document.getElementById("new-conversation-cancel");

            if (!dialog || !open) { return; }

            open.addEventListener("click", function () {
                dialog.showModal();
                document.getElementById("new-conversation").focus();
            });
            cancel.addEventListener("click", function () { dialog.close(); });
        })();
    </script>
}
