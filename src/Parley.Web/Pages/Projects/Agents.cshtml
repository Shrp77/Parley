@page
@model Parley.Web.Pages.Projects.AgentsModel
@using Parley.Core
@using Parley.Web.Pages.Shared
@{
    ViewData["Refresh"] = "30";
    ViewData["Title"] = Model.Project;
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

<h1 class="project-title">
    @* The title is the way to rename. Renaming is not a label edit: it forgets the old name and names a new
       project with a folder and store of its own, and the page it leads to says what that does. *@
    <a class="title-link" href="/Projects/Naming?project=@Model.Project" title="Rename this project">@Model.Project</a>
    <a class="edit" href="/Projects/Naming?project=@Model.Project">Edit</a>
</h1>

<nav aria-label="This project">
    <a href="/Projects/Health?project=@Model.Project">Health</a>
    <a href="/Projects/Files?project=@Model.Project">Files</a>
    <a href="/Projects/Settings?project=@Model.Project">Settings</a>
</nav>

<div class="project">
    @* Roadmaps first: they are what the person came to decide and to start work from. *@
    <div class="project-main">
        @if (Model.RoadmapProblem is { Length: > 0 } roadmapProblem)
        {
            <p class="unreachable" role="alert">@roadmapProblem</p>
        }
        else
        {
            <partial name="_RoadmapSummary" model="@(new RoadmapSummaryView(Model.Project ?? "", Model.Waiting, Model.Roadmaps))" />
            <p><a href="/Roadmaps?project=@Model.Project">All roadmaps</a></p>
        }

    <section aria-label="Conversations in this project">
        <h2>Conversations</h2>

        <form method="get">
            <input type="hidden" name="project" value="@Model.Project" />
            <label for="participant">Party to</label>
            <input id="participant" name="participant" value="@Model.Participant" />
            <button type="submit">Search this project</button>
        </form>

        @* **Starting one belongs beside the list of them.** The composer has always been able to open
           a conversation that does not exist yet -- naming one is what creates it -- and nothing led
           anybody to it: every route in was a link to a conversation already there, so a project with
           none had no way in at all and the first was the hardest to start. Reported by the owner
           against the terminal, which had the same gap in the same shape. *@
        <form method="get" action="/Conversations/Detail">
            <input type="hidden" name="project" value="@Model.Project" />
            <label for="new-conversation">Start a conversation called</label>
            <input id="new-conversation" name="id" placeholder="what-it-is-about" required
                   maxlength="@ConversationName.Longest" pattern="@ConversationName.Pattern"
                   data-correct="@ConversationName.Allowed"
                   autocomplete="off" spellcheck="false"
                   aria-describedby="new-conversation-rule" />
            <button type="submit">Start</button>

            @* **The rule is applied as it is typed rather than reported afterwards**, and the
               placeholder no longer invites prose into a field that cannot hold it: it read
               "what it is about", which is a sentence, and a sentence is exactly what the owner
               typed into the terminal's version of this field before being refused. *@
            <p id="new-conversation-rule" class="composer-note">
                @ConversationName.Rule It reaches a filename when the discussion is exported.
                <span id="new-conversation-corrected" role="status" hidden>
                    @ConversationName.WasCorrected.
                </span>
            </p>
        </form>

        @if (Model.FilterProblem is { Length: > 0 } filter)
        {
            <p class="unreachable" role="alert">@filter</p>
        }

        @if (Model.Hidden is { Length: > 0 } hidden)
        {
            @* Computed and never shown until the review gate: once archiving had a button, an archived conversation
               would have left the list with nothing saying where it went or how to bring it back. *@
            <p class="composer-note">
                @hidden <a href="/Projects/Agents?project=@Model.Project&amp;showArchived=true">Show them</a>
            </p>
        }

        @if (Model.ConversationProblem is { Length: > 0 } unread)
        {
            <p class="unreachable" role="alert">@unread</p>
        }
        else if (Model.Conversations.Count == 0)
        {
            <p>No conversations match in @Model.Project.</p>
        }
        else
        {
            <div class="grid" role="table" aria-label="Conversations">
                <div class="grid-head" role="row">
                    <a role="columnheader" href="/Projects/Agents?project=@Model.Project&amp;participant=@Model.Participant&amp;showArchived=@(Model.ShowArchived ? "true" : "false")&amp;sort=name">Name</a>
                    <span role="columnheader">Messages</span>
                    <a role="columnheader" href="/Projects/Agents?project=@Model.Project&amp;participant=@Model.Participant&amp;showArchived=@(Model.ShowArchived ? "true" : "false")">Last active</a>
                </div>
                @foreach (var conversation in Model.Conversations)
                {
                    @* A row opens to show who is in it and what can be done to it. A native details element, so
                       it works with no script. *@
                    <details class="grid-row" role="row">
                        <summary>
                            <a class="name" href="/Conversations/Detail?project=@Model.Project&amp;id=@conversation.Id">@conversation.Id</a>
                            <span class="num">@conversation.Messages</span>
                            <span class="when">
                                @conversation.LastActivityUtc.ToString("d MMM yyyy, HH:mm")
                                @if (conversation.HasOpenExchange)
                                {
                                    @* A question somebody still owes an answer to. Said in words; the tint is only how you find it. *@
                                    <span class="tag open">still open</span>
                                }
                                @if (conversation.Archived)
                                {
                                    <span class="tag">archived</span>
                                }
                            </span>
                        </summary>
                        <div class="grid-detail">
                            <p class="between">@string.Join(", ", conversation.Participants.Select(p => p.Value))</p>
                            @* Filing away and destroying, linked from here since the combined review gate found both
                               performed by this console and reached from no page. Archiving is one click because one
                               click reverses it; destroying goes to a page that describes it and takes the name typed. *@
                            <form method="post" asp-page-handler="Archive">
                                <input type="hidden" name="project" value="@Model.Project" />
                                <input type="hidden" name="id" value="@conversation.Id" />
                                <input type="hidden" name="archived" value="@(conversation.Archived ? "true" : "false")" />
                                <input type="hidden" name="showArchived" value="@(Model.ShowArchived ? "true" : "false")" />
                                <input type="hidden" name="sort" value="@Model.Sort" />
                                <button type="submit">@(conversation.Archived ? "Bring back" : "Archive")</button>
                            </form>
                            <a href="/Conversations/Destroy?project=@Model.Project&amp;id=@conversation.Id">Destroy…</a>
                        </div>
                    </details>
                }
            </div>

            @if (Model.NextPageToken is { Length: > 0 } next)
            {
                <p>
                    <a href="/Projects/Agents?project=@Model.Project&amp;participant=@Model.Participant&amp;pageToken=@Uri.EscapeDataString(next)">Older conversations</a>
                </p>
            }
        }
    </section>
    </div>

    <aside class="roster agents-card" aria-label="Agents">
        <h2>Agents</h2>

        @if (Model.Problem is { Length: > 0 } problem)
        {
            <p class="unreachable" role="alert">@problem</p>
        }
        else if (Model.Agents.Count == 0)
        {
            <p>
                None registered yet.
                <a href="/Projects/Register?project=@Model.Project">Add one.</a>
            </p>
        }
        else
        {
            <partial name="_AgentTree" model="@(new AgentTreeView(
                Model.Project ?? "",
                [.. Model.Agents.Select(a => new AgentTreeEntry(a.Name, true, false, Roster.State(a)))],
                Pick: false))" />
        }
    </aside>
</div>

@section Scripts {
    <script>
        // The title is a text box when it is clicked. Enter takes the typed name to the page that describes
        // what a rename does -- the console does not rename, so nothing is written here -- and Escape puts the
        // title back. Without script the title is simply a link to that page.
        (function () {
            var link = document.querySelector(".project-title .title-link");

            if (!link) { return; }

            link.addEventListener("click", function (e) {
                e.preventDefault();

                var project = new URL(link.href).searchParams.get("project");
                var form = document.createElement("form");
                var box = document.createElement("input");
                var hidden = document.createElement("input");

                form.method = "get";
                form.action = "/Projects/Naming";
                form.className = "title-edit";
                hidden.type = "hidden";
                hidden.name = "project";
                hidden.value = project;
                box.name = "newName";
                box.value = project;
                box.setAttribute("aria-label", "New name for this project");
                box.maxLength = 64;
                box.autocomplete = "off";
                box.spellcheck = false;
                form.appendChild(hidden);
                form.appendChild(box);
                link.replaceWith(form);
                box.focus();
                box.select();

                box.addEventListener("keydown", function (k) {
                    if (k.key === "Escape") { form.replaceWith(link); }
                });
                box.addEventListener("blur", function () {
                    if (form.parentNode) { form.replaceWith(link); }
                });
            });
        })();
    </script>
}
