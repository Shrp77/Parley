@page
@model ParleySettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

<p class="lede">For Parley as a whole. Each project's own settings are on its Settings page.</p>

<section aria-labelledby="appearance-heading" class="settings-section">
    <h2 id="appearance-heading">Appearance</h2>

    <p>Kept in this browser only, for every project.</p>

    @* Hidden until script runs: the choice lives in this browser's storage, so with no script there is nowhere to keep
       it, and the console follows the system's theme. *@
    <form id="appearance" class="appearance" onsubmit="return false" hidden>
        <fieldset class="choice">
            <legend>Theme</legend>
            <label><input type="radio" name="theme" value="system" checked /> Follow the system</label>
            <label><input type="radio" name="theme" value="light" /> Light</label>
            <label><input type="radio" name="theme" value="dark" /> Dark</label>
        </fieldset>

        @* The palette (feature 042): ready-made ones drawn as their own swatches, and one the person makes from a colour and
           a harmony. Each swatch shows the palette's main colour, its accent and its card surface, computed by the same rule
           that serves the palette. *@
        <fieldset class="choice palettes">
            <legend>Colours</legend>
            @foreach (var palette in Parley.Web.Palettes.Palette.Ready)
            {
                var light = Parley.Web.Palettes.Scheme.For(palette, dark: false).Colours;
                <label class="palette-choice">
                    <input type="radio" name="palette" value="@palette.Key" checked="@(palette == Parley.Web.Palettes.Palette.Default)" />
                    <span class="swatch" aria-hidden="true">
                        <span style="background: @light["primary"]"></span><span style="background: @light["tertiary-container"]"></span><span style="background: @light["surface-container"]"></span>
                    </span>
                    @palette.Name
                </label>
            }
            <label class="palette-choice">
                <input type="radio" name="palette" value="custom" />
                <span class="swatch" aria-hidden="true" id="custom-swatch"><span></span></span>
                Your own
            </label>
            <div class="palette-own" id="palette-own" hidden>
                <label>Main colour <input type="color" id="palette-colour" value="#6750a4" /></label>
                <label>Accent
                    <select id="palette-harmony">
                        <option value="analogous">Beside it on the colour wheel (calm)</option>
                        <option value="complementary">Opposite it (lively)</option>
                        <option value="split-complementary">Either side of opposite (balanced)</option>
                        <option value="triadic">A third of the way round (playful)</option>
                    </select>
                </label>
                <p class="composer-note">Every shade is worked out from these, for light and dark, and text always stays readable.</p>
            </div>
        </fieldset>

        <fieldset class="choice">
            <legend>Density</legend>
            <label><input type="radio" name="density" value="comfortable" checked /> Comfortable</label>
            <label><input type="radio" name="density" value="compact" /> Compact: smaller fields, buttons and rows</label>
        </fieldset>

        <p id="appearance-saved" class="composer-note" role="status" aria-live="polite"></p>
    </form>

    <noscript>
        <p class="unreachable">Choosing a theme needs script, because the choice is kept in this browser. The console follows the system's theme.</p>
    </noscript>
</section>

<section aria-labelledby="inbox-heading" class="settings-section">
    <h2 id="inbox-heading">Inbox</h2>

    <p>Kept for this machine, so the terminal's Inbox uses the same window.</p>

    <form method="post" asp-page-handler="Inbox" class="inbox-window">
        <label for="closed-days">Show exchanges closed in the last</label>
        <input id="closed-days" name="Days" type="number" inputmode="numeric" required
               min="@Parley.Configuration.ParleySettings.FewestClosedDays" max="@Parley.Configuration.ParleySettings.MostClosedDays"
               step="1" value="@Model.ClosedDays" />
        <span>days, under Closed. Older ones are a click away.</span>
        <button type="submit">Save</button>
    </form>

    @if (Model.InboxSaid is { Length: > 0 } said)
    {
        <p class="@(Model.InboxRefused ? "unreachable" : "composer-note")" role="status">@said</p>
    }
</section>

<section aria-labelledby="about-heading" class="settings-section">
    <h2 id="about-heading">About this machine</h2>

    <dl class="about">
        <dt>Web console</dt>
        <dd>parley-web-ui @WebBuild.Version, speaking protocol @Parley.Core.ProtocolVersion.Current</dd>

        <dt>Deployment</dt>
        <dd>@(Model.Root ?? "None: this console was given its projects directly.")</dd>
    </dl>

    @if (Model.ManifestProblem is { Length: > 0 } problem)
    {
        <p class="unreachable" role="alert">@problem</p>
    }

    @if (Model.Projects.Count == 0)
    {
        <p>No projects yet. <a href="/">Create one.</a></p>
    }
    else
    {
        <h3 id="projects-heading">Projects</h3>
        <table aria-labelledby="projects-heading">
            <thead>
                <tr><th scope="col">Project</th><th scope="col">Broker</th><th scope="col">Address</th><th scope="col">Store</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Projects)
                {
                    var warnings = row.Health.Warnings(WebBuild.Version);
                    <tr>
                        <th scope="row"><a href="/Projects/Agents?project=@Uri.EscapeDataString(row.Project.Name.Value)">@row.Project.Name.Value</a></th>
                        <td>
                            @if (!row.Health.Reachable)
                            {
                                <span>Not answering</span>
                            }
                            else
                            {
                                <span>@(row.Health.BrokerVersion is { Length: > 0 } build ? $"parley {build}" : "Build not said"), protocol @row.Health.Speaks</span>
                            }
                            @foreach (var warning in warnings)
                            {
                                <span class="unreachable">@warning</span>
                            }
                        </td>
                        <td><code>@row.Project.Endpoint</code></td>
                        <td><code>@row.Project.Store</code></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<script>
    (function () {
        var form = document.getElementById("appearance");
        var saved = document.getElementById("appearance-saved");
        var root = document.documentElement;

        function read(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
        function write(key, value) {
            try { if (value) { localStorage.setItem(key, value); } else { localStorage.removeItem(key); } return true; } catch (e) { return false; }
        }

        var link = document.getElementById("palette");
        var own = document.getElementById("palette-own");
        var colour = document.getElementById("palette-colour");
        var harmony = document.getElementById("palette-harmony");
        var version = new URL(link.href, location.href).searchParams.get("v") || "";

        // A colour picked in the browser, as the base hue and chroma the console builds a palette from: sRGB to CIELAB.
        function lch(hex) {
            var c = [1, 3, 5].map(function (i) {
                var v = parseInt(hex.substr(i, 2), 16) / 255;
                return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
            });
            var x = (0.4124 * c[0] + 0.3576 * c[1] + 0.1805 * c[2]) / 0.95047;
            var y = 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
            var z = (0.0193 * c[0] + 0.1192 * c[1] + 0.9505 * c[2]) / 1.08883;
            function f(t) { return t > 0.008856 ? Math.cbrt(t) : 7.787 * t + 16 / 116; }
            var a = 500 * (f(x) - f(y)), b = 200 * (f(y) - f(z));
            var hue = Math.round((Math.atan2(b, a) * 180 / Math.PI + 360) % 360) % 360;
            return { hue: hue, chroma: Math.min(120, Math.round(Math.sqrt(a * a + b * b))) };
        }

        function query(choice) {
            if (choice !== "custom") { return "name=" + choice; }
            var made = lch(colour.value);
            return "hue=" + made.hue + "&chroma=" + made.chroma + "&harmony=" + harmony.value;
        }

        function applyPalette(choice) {
            var q = query(choice);
            link.href = "/brand/palette.css?" + q + "&v=" + encodeURIComponent(version);
            own.hidden = choice !== "custom";
            document.querySelector("#custom-swatch span").style.background = colour.value;
            return write("parley.palette", choice === "frost" ? null : q);
        }

        var stored = read("parley.palette") || "";
        var named = /^name=([a-z-]+)$/.exec(stored);
        var made = /^hue=(\d+)&chroma=(\d+)&harmony=([a-z-]+)$/.exec(stored);
        var current = named && form.querySelector("input[name=palette][value='" + named[1] + "']") ? named[1] : made ? "custom" : "frost";
        if (made) {
            harmony.value = made[3];
            colour.value = localStorage.getItem("parley.palette.colour") || colour.value;
        }
        form.querySelector("input[name=palette][value='" + current + "']").checked = true;
        own.hidden = current !== "custom";
        document.querySelector("#custom-swatch span").style.background = colour.value;

        function saveOwn() {
            if (!form.querySelector("input[name=palette][value=custom]").checked) { return; }
            write("parley.palette.colour", colour.value);
            saved.textContent = applyPalette("custom") ? "Saved in this browser." : "Applied to this page, but this browser would not keep it.";
        }
        colour.addEventListener("input", saveOwn);
        harmony.addEventListener("change", saveOwn);

        var theme = read("parley.theme"), density = read("parley.density");
        form.querySelector("input[name=theme][value=" + (theme === "light" || theme === "dark" ? theme : "system") + "]").checked = true;
        form.querySelector("input[name=density][value=" + (density === "compact" ? "compact" : "comfortable") + "]").checked = true;
        form.hidden = false;

        form.addEventListener("change", function (e) {
            var input = e.target;
            var kept;

            if (input.name === "theme") {
                var chosen = input.value === "system" ? null : input.value;
                if (chosen) { root.setAttribute("data-theme", chosen); } else { root.removeAttribute("data-theme"); }
                kept = write("parley.theme", chosen);
            } else if (input.name === "palette") {
                if (input.value === "custom") { write("parley.palette.colour", colour.value); }
                kept = applyPalette(input.value);
            } else if (input.name === "density") {
                var compact = input.value === "compact";
                if (compact) { root.setAttribute("data-density", "compact"); } else { root.removeAttribute("data-density"); }
                kept = write("parley.density", compact ? "compact" : null);
            } else {
                return;
            }

            saved.textContent = kept ? "Saved in this browser." : "Applied to this page, but this browser would not keep it.";
        });
    })();
</script>
