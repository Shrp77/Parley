@page
@model Parley.Web.Pages.Roadmaps.CheckModel
@{
    ViewData["Title"] = "Ask the agents about a roadmap";
}

<h1>Ask the agents about this roadmap</h1>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}

@if (Model.Outcome is { Length: > 0 } outcome)
{
    <p role="alert"><strong>@outcome</strong></p>
}

@if (Model.Roadmap is { } roadmap)
{
    <h2>#@roadmap.Number @roadmap.Title</h2>

    @if (Model.Agents.Count > 0 && Model.Says is { } says && Model.Conversation is { } conversation)
    {
        @* Said before anything is sent, as every action on this console is: who, what, what it costs and what it changes. *@
        <p>
            This sends <strong>every agent in the project</strong> (@Model.Agents.Count) the same Request, from you, in a new
            conversation, <strong>@conversation</strong>. An agent that is not running is started to read it, so this uses
            every agent's time. Each answers in its own Result: where each item stands, what can be removed, and what is
            missing and where it goes.
        </p>
        <p>
            Nothing in the roadmap changes. You read the answers and edit the roadmap yourself, or do not. The agents are
            asked not to propose a roadmap in answer, because confirming one discards the others.
        </p>

        <p>Going to: @string.Join(", ", Model.Agents.Select(a => a.Value)).</p>

        <details>
            <summary>The message, word for word</summary>
            <pre class="quoted">@says</pre>
        </details>

        <form method="post">
            <button type="submit">Ask @Model.Agents.Count agents</button>
            <a class="button quiet" href="/Roadmaps/Roadmap?project=@Model.Project&amp;id=@roadmap.Id">Do not ask, and go back</a>
        </form>
    }
    else
    {
        <nav class="page-links" aria-label="This project"><a href="/Roadmaps/Roadmap?project=@Model.Project&amp;id=@roadmap.Id">Back to the roadmap</a></nav>
    }
}
else
{
    <nav class="page-links" aria-label="This project"><a href="/Roadmaps?project=@Model.Project">Back to the roadmaps in @Model.Project</a></nav>
}
