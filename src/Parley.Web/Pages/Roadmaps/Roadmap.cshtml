@page
@model Parley.Web.Pages.Roadmaps.RoadmapModel
@using Parley.Client.Roadmaps
@{
    ViewData["Title"] = Model.Roadmap is { } shown ? $"Roadmap: {shown.Title}" : "Roadmap";
}

<h1>@(Model.Roadmap is { } named ? $"#{named.Number} {named.Title}" : "Roadmap")</h1>

<p><a href="/Roadmaps?project=@Model.Project">Back to the roadmaps in @Model.Project</a></p>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}
else if (Model.Roadmap is { } roadmap && Model.Standing is { } standing)
{
    @* Every word below an agent wrote, or the person did, is escaped by Razor. Where an item stands is derived from its
       conversation and never set here. *@
    <p role="status">@ItemWording.Next(standing)</p>

    @if (Model.Agents.Count > 0)
    {
        <p>Agents on this roadmap: @string.Join(", ", Model.Agents.Select(a => a.Value)).</p>
    }

    @* The same grid as the conversations. The item to do next starts open, because it is the one a person came to act on. *@
    <div class="grid items-grid roadmap-items" role="table" aria-label="Items">
        <div class="grid-head" role="row">
            <span role="columnheader">#</span>
            <span role="columnheader">Item</span>
            <span role="columnheader">Where it stands</span>
        </div>
        @foreach (var state in standing.Items)
        {
            <details class="grid-row@(state.IsNext ? " next" : null)" role="row" open="@(state.IsNext ? "open" : null)">
                <summary>
                    <span class="num"><span class="chev" aria-hidden="true">&#9656;</span> @state.Item.Number</span>
                    @* The title opens the conversation; the arrow, or the rest of the row, opens the details. *@
                    <a class="name" href="@Model.OpenPath(state)">@(state.IsNext ? "Next: " : "")@state.Item.Text</a>
                    <span class="when">@ItemWording.Standing(state)</span>
                </summary>
                <div class="grid-detail">
                    @if (state.Item.IntendedAgent is { } agent)
                    {
                        <p class="between">for @agent.Value</p>
                    }
                    @if (state.Item.Needs.Count > 0)
                    {
                        <p class="between">needs @string.Join(", ", state.Item.Needs.Order())</p>
                    }
                    <a href="@Model.OpenPath(state)">@(state.Item.Facts is { ConversationExists: true } ? "Open its conversation" : "Start it: open an empty conversation with its text ready")</a>
                </div>
            </details>
        }
    </div>

    <p><small>Starting an item sends nothing. It opens the conversation <code>@(standing.Items.Count > 0 ? "rm" + roadmap.Number + "-<item>" : "")</code> with the item's words in the box and the agents ticked; you press Send.</small></p>
}
