@page
@model Parley.Web.Pages.Conversations.DetailModel
@using Parley.Core
@{
    ViewData["Title"] = $"Conversation {Model.Id}";
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

<h1>@Model.Id</h1>

<p>
    In @Model.Project, between <span id="between">@string.Join(", ", Model.Participants.Select(p => p.Value))</span>.
</p>

@* Said once, plainly. Ordering is the broker's record and not a wall clock: the agents run on
   different machines, and a timeline sorted on their clocks would misorder itself. *@
<p class="as-of">
    In the order the broker recorded them. Times are shown for information; they come from the
    machines the agents run on and are not what the order follows.
    @Parley.Client.Rendering.LocalTime.Note()
</p>

<p>
    <a href="/Conversations/Detail?project=@Model.Project&amp;id=@Model.Id&amp;handler=Transcript">
        Take this away as text
    </a>
    <span> · </span>
    <a href="/Conversations/Detail?project=@Model.Project&amp;id=@Model.Id&amp;handler=Raw">
        or as the messages the broker returned
    </a>
    <span> · </span>
    <a href="/Projects/Files?project=@Model.Project&amp;conversation=@Model.Id">Files in this conversation</a>
</p>

@* The transcript follows the conversation, and this is what it says when it cannot. Kept on screen
   rather than replacing the transcript: a moment's trouble reaching the broker must not take the
   conversation away from somebody reading it, and saying nothing would leave the page asserting it
   is current, which is the failure following exists to remove. Hidden again once a read succeeds.
   The terminal says the same sentence for the same reason. *@
<p id="uncertain" role="alert" hidden>
    This conversation could not be read again, so what is on screen may be out of date. It is
    tried again every few seconds.
</p>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}
else
{
    @if (Model.Destroyed is null && Model.Messages.Count > 0)
    {
        @* Searching happens here rather than at the broker: the whole conversation is already on
           the page, so a round trip would be slower and would page results that are all in front of
           the reader anyway. Enhancement only — with no script the transcript is simply a
           transcript, and the browser's own find still works on it. *@
        <div class="find" role="search">
            <label for="find">Find in this conversation</label>
            <input id="find" type="search" autocomplete="off" spellcheck="false"
                   placeholder="a word, an agent, a phrase" />
            <p id="found" class="found" role="status"></p>
        </div>
    }

    <partial name="_Followed" model="Model" />
}

@* Pinned to the bottom, so it is reachable from anywhere in a long transcript.

   What you send is a message in this conversation, under your own seat's name, subject to every
   rule 7 refusal any other participant faces. When the broker cannot be reached as you, the first
   sentence in the panel says so. *@
<form method="post" class="composer@(Model.Seat is null ? " as-operator" : " as-agent")"
      aria-label="Send to agents in this conversation">
    @if (Model.Seat is { } seat)
    {
        <p class="composer-note">
            You are in this conversation as <strong>@seat.Name.Value</strong>. What you send is a
            message like any other: it appears in the transcript above, it is attributed to
            <code>@seat.Seat.Responder</code>, and the peer answers you rather than being told
            something by an operator.
        </p>
    }
    else
    {
        @* The seat is the broker's and is taken on every page, so the only way to be here is that this project's
           broker could not be reached as the person just then; sending tries again and says why if it still cannot. *@
        <p class="composer-note">
            Not connected to this project as you just now. What you send is still yours and appears in the transcript;
            sending reconnects first, and says so if it cannot.
        </p>
    }

    @if (Model.SendProblem is { Length: > 0 } trouble)
    {
        <p class="unreachable" role="alert">@trouble</p>
    }

    @if (Model.Sent.Count > 0)
    {
        <ul class="sent" role="status">
            @foreach (var (agent, outcome) in Model.Sent)
            {
                <li><strong>@agent</strong> @outcome</li>
            }
        </ul>
    }

    <fieldset class="targets">
        <legend>To</legend>
        @foreach (var who in Model.Participants)
        {
            <label class="target slot-@Palette.SlotFor(who)">
                <input type="checkbox" name="Targets" value="@who.Value" />
                <span class="who" aria-hidden="true">@Palette.BadgeFor(who)</span>
                <span><span class="mark" aria-hidden="true">@Parley.Client.Rendering.RoomRoster.ParticipantMark</span> @who.Value</span>
            </label>
        }

        @foreach (var who in Model.NotInIt)
        {
            @* Not in the conversation yet. Ticking one and sending addresses them, which brings them in (specs/026);
               listed after the participants, which carry the mark, so the difference is on the row as well as in the
               order. *@
            <label class="target not-in-it slot-@Palette.SlotFor(who)">
                <input type="checkbox" name="Targets" value="@who.Value" />
                <span class="who" aria-hidden="true">@Palette.BadgeFor(who)</span>
                <span>@who.Value <small>(not in it yet)</small></span>
            </label>
        }

        @if (Model.Participants.Count > 1)
        {
            <label class="target everyone">
                <input type="checkbox" name="Everyone" value="true" />
                <span>Everyone in this conversation (@Model.Participants.Count)</span>
            </label>
        }
    </fieldset>

    <textarea name="Says" rows="3" required
              placeholder="@(Model.Seat is null
                  ? "What do you want them to do, or to know?"
                  : Framing.AskExample)">@Model.Says</textarea>

    @if (Model.Seat is not null)
    {
        @* One field since 0.7. The composer asked for an intent, a kind and a done_when beside the ask,
           and §5.1 removed all three: the reason for an ask is the ask, and a receiver that cannot scope
           one sends a Clarify rather than being handed a form to fill in on the requester's behalf. What
           is left is a note saying what this costs, which is the thing a person cannot see. *@
        <div class="framing">
            <p class="composer-note">A request — @Owing.Requesting.</p>
            <p class="composer-note">@Framing.AskWhy.</p>
        </div>
    }

    <div class="composer-send">
        <button type="submit">Send</button>
    </div>
</form>

@section Scripts {
    <script>
        // Following the conversation, the way the terminal's open transcript does. Progressive
        // enhancement: with no script the page is the conversation as it was when it was read, and
        // says when that was.
        //
        // One read at a time -- the next is scheduled when the last has finished, never on a timer
        // that could stack reads behind a slow broker. Nothing is touched when the region's digest
        // is unchanged, which is almost every read. When it has changed, the reader is not moved:
        // a reader at the bottom is kept at the bottom, and anybody else keeps the message they were
        // looking at exactly where it was on screen, whatever grew above or below it.
        //
        // The new region is parsed by DOMParser and moved in as nodes. It is markup the server
        // rendered with every agent-written field encoded; nothing here builds HTML from a payload,
        // and a parsed document runs no scripts.
        (function () {
            var region = document.getElementById("followed");
            var uncertain = document.getElementById("uncertain");
            var between = document.getElementById("between");

            if (!region || !window.fetch || !window.DOMParser) { return; }

            var url = region.getAttribute("data-follow");
            var every = 3000;

            // **Tailed, the owner's call of 2026-10-01**: the page opens on the newest message and stays
            // there while the reader does, as the terminal's transcript does. At the end means the end of
            // the newest message is on screen -- not the page's own bottom, because the composer sits below
            // it, and not merely its first line, because a reader on the message before it can see that
            // much and is still reading back. Anywhere else the reader is not moved at all.
            function newest() {
                var turns = region.querySelectorAll("li.turn");
                return turns.length ? turns[turns.length - 1] : null;
            }

            function atBottom() {
                var last = newest();
                return !last || last.getBoundingClientRect().bottom <= window.innerHeight + 8;
            }

            function tail() {
                var last = newest();
                if (last) { last.scrollIntoView({ block: "end" }); }
            }

            function anchor() {
                var turns = region.querySelectorAll("li.turn");

                for (var i = 0; i < turns.length; i++) {
                    var box = turns[i].getBoundingClientRect();

                    if (box.bottom > 0) { return { id: turns[i].id, top: box.top }; }
                }

                return null;
            }

            function apply(fresh) {
                var bottom = atBottom();
                var held = anchor();

                region.replaceChildren.apply(region, [].slice.call(fresh.childNodes).map(function (n) {
                    return document.adoptNode(n);
                }));
                region.setAttribute("data-seen", fresh.getAttribute("data-seen") || "");

                if (between) { between.textContent = fresh.getAttribute("data-participants") || ""; }

                if (bottom) {
                    tail();
                } else if (held && held.id) {
                    var again = document.getElementById(held.id);

                    if (again) { window.scrollBy(0, again.getBoundingClientRect().top - held.top); }
                }

                document.dispatchEvent(new CustomEvent("parley:followed"));
            }

            function next() { window.setTimeout(read, every); }

            function read() {
                // A tab nobody is looking at asks nobody anything; it reads again when it is shown.
                if (document.hidden) { next(); return; }

                fetch(url, { cache: "no-store", credentials: "same-origin" })
                    .then(function (r) {
                        if (!r.ok) { throw new Error(String(r.status)); }
                        return r.text();
                    })
                    .then(function (html) {
                        var fresh = new DOMParser().parseFromString(html, "text/html")
                            .getElementById("followed");

                        if (!fresh) { throw new Error("no region"); }

                        if (uncertain) { uncertain.hidden = true; }

                        if (fresh.getAttribute("data-seen") !== region.getAttribute("data-seen")) {
                            apply(fresh);
                        }
                    })
                    .catch(function () {
                        // Said, and the transcript left as it was. Setting it again while it is
                        // already showing announces nothing new, so this is once per outage.
                        if (uncertain) { uncertain.hidden = false; }
                    })
                    .then(next);
            }

            // Opened at the newest message, unless the address names one to go to.
            if (!window.location.hash) { tail(); }

            next();
        })();

        // Selecting a message marks every other message from the same agent, in the rail and in
        // the transcript. The rail groups by colour, which is no grouping at all for a reader who
        // cannot separate the hues -- so selection dims what does not match, outlines what does,
        // and says in a sentence how many there are and whose they were.
        //
        // Selection is the URL fragment rather than state of its own, so it works however the
        // reader got here: a click on a tick, a pasted link, the back button. The rail and the
        // note are looked up each time, because following replaces them.
        (function () {
            function clear() {
                var rail = document.querySelector(".timeline");
                var note = document.getElementById("kin");

                if (rail) { rail.classList.remove("focused"); }
                if (note) { note.textContent = ""; }

                document.querySelectorAll(".kin").forEach(function (el) {
                    el.classList.remove("kin");
                });
            }

            function mark() {
                clear();

                var rail = document.querySelector(".timeline");
                var note = document.getElementById("kin");

                if (!rail || !note) { return; }

                var id = window.location.hash.slice(1);

                if (!id) { return; }

                var chosen = document.getElementById(id);

                if (!chosen) { return; }

                var agent = chosen.getAttribute("data-agent");

                if (!agent) { return; }

                // Attribute selector rather than a class: the agent's own name is what matches,
                // so this cannot drift from whatever palette slot it happens to have been given.
                var kin = document.querySelectorAll('[data-agent="' + agent + '"]');

                kin.forEach(function (el) { el.classList.add("kin"); });
                rail.classList.add("focused");

                var count = Math.round(kin.length / 2);

                note.textContent = count === 1
                    ? "1 message from " + agent + " in this conversation."
                    : count + " messages from " + agent + ", marked in the timeline.";
            }

            window.addEventListener("hashchange", mark);
            document.addEventListener("parley:followed", mark);
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { clear(); }
            });

            mark();
        })();

        // Find within the conversation. It marks whole messages and their ticks, and marks the
        // words themselves inside the bubbles, and marks again when following brings new ones.
        //
        // The words are wrapped by moving existing text nodes into <mark> elements, never by
        // building HTML from them. A peer wrote that text; the page has kept it as content
        // everywhere else, and a search box would be a poor place to stop.
        (function () {
            var box = document.getElementById("find");
            var note = document.getElementById("found");

            if (!box || !note) { return; }

            function strip(root) {
                root.querySelectorAll("mark[data-found]").forEach(function (m) {
                    var parent = m.parentNode;
                    m.replaceWith(document.createTextNode(m.textContent));
                    parent.normalize();
                });
            }

            function paint(el, needle) {
                var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
                var texts = [];

                while (walker.nextNode()) { texts.push(walker.currentNode); }

                var found = false;

                texts.forEach(function (node) {
                    var at = node.textContent.toLowerCase().indexOf(needle);

                    if (at < 0) { return; }

                    found = true;

                    var tail = node.splitText(at);
                    tail.splitText(needle.length);

                    var wrap = document.createElement("mark");
                    wrap.setAttribute("data-found", "");
                    tail.replaceWith(wrap);
                    wrap.appendChild(tail);
                });

                return found;
            }

            function run() {
                var rail = document.querySelector(".timeline");
                var turns = [].slice.call(document.querySelectorAll("li.turn"));
                var needle = box.value.trim().toLowerCase();

                if (!rail) { return; }

                strip(document);
                turns.forEach(function (t) { t.classList.remove("hit"); });
                document.querySelectorAll(".tick.hit").forEach(function (t) {
                    t.classList.remove("hit");
                });
                rail.classList.remove("searching");

                if (needle.length < 2) {
                    note.textContent = "";
                    return;
                }

                var hits = 0;

                turns.forEach(function (turn) {
                    // Each message is searched whole: what was said, the numbered points, the
                    // consequences, and the two agents in the attribution line -- because "who
                    // said this" is as much a thing to look for as "what did they say".
                    if (!paint(turn, needle)) { return; }

                    hits++;
                    turn.classList.add("hit");

                    var tick = rail.querySelector('a[href="#' + turn.id + '"]');

                    if (tick) { tick.classList.add("hit"); }
                });

                rail.classList.add("searching");

                note.textContent = hits === 0
                    ? "No messages contain that."
                    : hits === 1
                        ? "1 message contains that, marked in the timeline."
                        : hits + " messages contain that, marked in the timeline.";
            }

            var pending;

            box.addEventListener("input", function () {
                window.clearTimeout(pending);
                pending = window.setTimeout(run, 150);
            });

            box.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { box.value = ""; run(); }
            });

            document.addEventListener("parley:followed", run);
        })();
    </script>
}
