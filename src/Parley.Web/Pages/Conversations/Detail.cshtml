@page
@model Parley.Web.Pages.Conversations.DetailModel
@using Parley.Core
@{
    ViewData["Title"] = $"Conversation {Model.Id}";
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
    ViewData["Project"] = Model.Project;
}

@* The page is two columns: a panel that stays on screen, and the conversation. The panel holds what a reader reaches for
   from anywhere in a long transcript, so none of it scrolls away: the name, find and the filter stay at its top, and what
   is waiting and who to write to scroll inside the rest of it. *@
<div class="convo-page" id="convo-page">
<aside class="convo-panel" id="convo-panel" aria-label="This conversation">
    @* Remembered in this browser, and set before the panel is drawn so a closed panel does not flash open. *@
    <script>
        try {
            if (window.localStorage.getItem("parley-convo-panel") === "closed") {
                document.getElementById("convo-page").classList.add("panel-closed");
            }
        } catch (e) { }
    </script>

    @* What a closed panel leaves: the way to open it, the way through what is waiting, and the name. *@
    <div class="panel-strip">
        <button type="button" id="panel-open" class="strip-button" title="Open this panel" aria-label="Open this panel"><span class="icon" aria-hidden="true">chevron_right</span></button>
        <button type="button" class="strip-button" id="strip-waiting" data-waiting-step="1" title="Go to the next message waiting on you" aria-label="Go to the next message waiting on you" hidden>
            <span class="icon" aria-hidden="true">inbox</span>
            <span class="strip-count" id="strip-count"></span>
        </button>
        <span class="strip-note" id="strip-filtered" hidden>Filtered</span>
        <span class="strip-name">@Model.Id</span>
    </div>

    <div class="panel-tools">
        @* Opening it shows what the conversation is. Ordering is said once, plainly: it is the broker's record and not a
           wall clock, because the agents run on different machines and a timeline sorted on their clocks would misorder
           itself. *@
        <div class="convo-head">
            <details class="convo-frame">
                <summary>
                    <h1>@Model.Id</h1>
                </summary>
                @if (Model.Item is { } item)
                {
                    @* The roadmap item this is the work on, so the name rm1-3 is never all a person has to go on, and the way
                       back to the roadmap, opened on that item. *@
                    @if (Model.ItemTitle is { Length: > 0 } itemTitle)
                    {
                        <p class="item-title">@itemTitle</p>
                    }
                    @if (Model.RoadmapPath is { } back)
                    {
                        <p class="item-of"><a href="@back" target="_top">@(Parley.Client.Roadmaps.ItemWording.Belongs(item))</a></p>
                    }
                    else
                    {
                        @* A removed item's conversation belongs to no item (SPEC.md §5.7): it says which it was and leads nowhere. *@
                        <p class="item-of">@(Parley.Client.Roadmaps.ItemWording.Belongs(item))</p>
                    }
                }
                <p class="as-of">
                    In the order the broker recorded them. Times come from the agents' machines.
                    @Parley.Client.Rendering.LocalTime.Note()
                </p>
            </details>

            <div class="convo-actions">
                @* The project's Files page, already narrowed to this conversation. *@
                <a class="file-button" target="_top" href="@Url.Page("/Projects/Files", new { project = Model.Project, conversation = Model.Id })" title="Files placed in this conversation" aria-label="Files placed in this conversation">
                    <span class="icon" aria-hidden="true">description</span>
                </a>
                @* Two ways to keep the conversation outside the console: the readable one carries the annotations of who saw what,
                   and the other is the broker's own records, for another program to read. *@
                <details class="export-menu">
                    <summary class="file-button" title="Export this conversation">
                        <span class="icon" aria-hidden="true">download</span>
                        Export
                    </summary>
                    <div class="export-list">
                        @* Built by the page's URL helper, so a value is encoded and cannot add a parameter of its own. *@
                        <a href="@Url.Page("/Conversations/Detail", "Transcript", new { project = Model.Project, id = Model.Id })" download title="The conversation as a text file, with who saw what noted on it, whether it was destroyed and the roadmap item it belongs to">Export TXT</a>
                        <a href="@Url.Page("/Conversations/Detail", "Raw", new { project = Model.Project, id = Model.Id })" download title="The messages and exchanges as the broker holds them, the destroyed record and the roadmap item, as JSON for another program">Export JSON</a>
                    </div>
                </details>
                <a class="file-button" target="_top" href="@Url.Page("/Conversations/SpinOff", new { project = Model.Project, id = Model.Id })" title="Start a new conversation linked to this one">Spin off</a>
                @* With a script this picks entries in place. Without one, the page it leads to lists them. *@
                <a class="file-button" id="move-start" target="_top" href="@Url.Page("/Conversations/Move", new { project = Model.Project, id = Model.Id })" title="Move entries to another conversation">Move entries</a>
                @* Only with a script, which is what can close it and remember that. *@
                <button type="button" id="panel-close" class="file-button" title="Close this panel" aria-label="Close this panel" hidden><span class="icon" aria-hidden="true">chevron_left</span></button>
            </div>
        </div>

        @* What has been picked to move, while picking. *@
        <div class="move-bar" id="move-bar" role="group" aria-label="Moving entries" hidden>
            <span id="move-count" role="status">Tick what you want to move.</span>
            <button type="button" id="move-go" disabled>Continue</button>
            <button type="button" id="move-cancel" class="quiet">Cancel</button>
        </div>

        @if (Model.Problem is not { Length: > 0 } && Model.Destroyed is null && Model.Messages.Count > 0)
        {
            @* Searching happens here rather than at the broker: the whole conversation is already on
               the page, so a round trip would be slower and would page results that are all in front of
               the reader anyway. Enhancement only — with no script the transcript is simply a
               transcript, and the browser's own find still works on it. *@
            <div class="find" role="search">
                <label for="find">Find in this conversation</label>
                <input id="find" type="search" autocomplete="off" spellcheck="false"
                       placeholder="a word, an agent, a phrase" />
                <p id="found" class="found" role="status"></p>
            </div>

            @* Narrows the transcript to the messages that involve somebody. Client-side for the reason find is: the
               whole conversation is on the page. Hidden until the script has built it, so with no script the page is
               the whole transcript and no control that does nothing. *@
            <div class="filter" id="filter" role="group" aria-label="Show only some of the conversation" hidden
                 data-human="@(Model.Participants.Where(p => p.Role == "human-user").Select(p => p.Value).FirstOrDefault() ?? Model.Seat?.Name.Value)">
                <span class="filter-title">Show</span>
                <label class="only-me"><input type="checkbox" id="only-me" /> Only between me and an agent</label>
                <details class="pick" id="pick">
                    <summary id="pick-summary">Any agent</summary>
                    <div class="menu" id="pick-menu"></div>
                </details>
                <button type="button" id="filter-clear" hidden>Show everything</button>
                <p id="filtered" class="found" role="status"></p>
            </div>
        }
    </div>

    @if (Model.Problem is not { Length: > 0 })
    {
        <partial name="_FollowedSide" model="Model" />
    }
</aside>

<div class="convo-main">
@* The transcript follows the conversation, and this is what it says when it cannot. Kept on screen
   rather than replacing the transcript: a moment's trouble reaching the broker must not take the
   conversation away from somebody reading it, and saying nothing would leave the page asserting it
   is current, which is the failure following exists to remove. Hidden again once a read succeeds.
   The terminal says the same sentence for the same reason. *@
<p id="uncertain" role="alert" hidden>
    This conversation could not be read again, so what is on screen may be out of date.
</p>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}
else
{
    <partial name="_Followed" model="Model" />
}

@* Pinned to the bottom, so it is reachable from anywhere in a long transcript.

   What you send is a message in this conversation, under your own seat's name, subject to every
   rule 7 refusal any other participant faces. When the broker cannot be reached as you, the first
   sentence in the panel says so. *@
<form method="post" id="composer" class="composer"
      aria-label="Send to agents in this conversation">
    @* No note about the seat: sending takes it, and says why if it cannot. *@

    @if (Model.SendProblem is { Length: > 0 } trouble)
    {
        <p class="unreachable" role="alert">@trouble</p>
    }

    @if (Model.Sent.Count > 0)
    {
        <ul class="sent" role="status">
            @foreach (var (agent, outcome) in Model.Sent)
            {
                <li><strong>@agent</strong> @outcome</li>
            }
        </ul>
    }

    @* Who it goes to is chosen in the tree beside the transcript, whose boxes belong to this form. Said here as
       well, because the boxes can be a long way from the button. *@
    <p class="composer-to" id="to-summary" aria-live="polite"></p>

    @* Set by "Reply to this" on an agent's question, and cleared by Cancel or a send. *@
    <input type="hidden" name="ReplyTo" id="reply-to" value="@Model.ReplyTo" />
    <p class="composer-replying" id="replying" role="status" hidden="@(Model.ReplyTo is null)">
        <span id="replying-text">@(Model.ReplyTo is { } replying ? $"Replying on exchange {replying}." : null)</span>
        @* Only on an agent's Request: a reply can close it with an outcome, or leave it open. *@
        <select name="Outcome" id="reply-outcome" aria-label="Close it with an outcome, or leave it open" hidden="@(string.IsNullOrEmpty(Model.Outcome))">
            <option value="">Reply, and leave it open</option>
            @foreach (var (value, says) in Parley.Client.Seating.SeatVoice.Outcomes)
            {
                <option value="@value" selected="@(Model.Outcome == value)">Close it: @says</option>
            }
        </select>
        <button type="button" id="reply-cancel" class="quiet">Cancel</button>
    </p>

    <textarea name="Says" rows="3" required
              placeholder="@(Model.Seat is null
                  ? "What do you want them to do, or to know?"
                  : Framing.AskExample)">@Model.Says</textarea>

    <div class="composer-send">
        <span class="composer-note">Enter sends. Shift+Enter makes a new line.</span>
        <button type="submit">Send</button>
    </div>
</form>

@* Submitted by "Close without answering" on a message, which sits in the followed region. *@
<form method="post" id="close-request" asp-page-handler="CloseRequest" asp-route-project="@Model.Project" asp-route-id="@Model.Id" hidden>
    <input type="hidden" name="Closing" id="closing" value="" />
</form>
</div>
</div>

@section Scripts {
    <style>
        form.composer { position: relative; }
        .mention-list { position: absolute; left: 0; right: 0; bottom: 100%; margin: 0; padding: 0.25rem; list-style: none; max-height: 14rem; overflow: auto; background: var(--surface, Canvas); border: 1px solid var(--rule); border-radius: 8px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18); z-index: 20; }
        .mention-list[hidden] { display: none; }
        .mention-list li { padding: 0.35rem 0.6rem; border-radius: 6px; cursor: pointer; overflow-wrap: anywhere; }
        .mention-list li[aria-selected="true"], .mention-list li:hover { background: var(--quiet-wash); }
    </style>
    <script>
        // The recipients tree. Its boxes belong to the composer's form, so this only keeps the
        // page honest about them: a group's box shows all, some or none of its members, ticking it
        // ticks them, and the composer says in a sentence who the message will go to.
        //
        // The tree is part of the followed region and is replaced every few seconds so its states stay
        // current. A replaced box knows only what the server was told, so what the reader ticked and
        // which groups they closed is taken before the swap and put back after it.
        window.parleyTree = (function () {
            var summary = document.getElementById("to-summary");
            var params = new URLSearchParams(location.search);
            var memory = "parley-to:" + params.get("project") + "/" + params.get("id");

            function boxes() {
                return [].slice.call(document.querySelectorAll(
                    'input[name="Targets"], input[name="Everyone"]'));
            }

            function key(box) { return box.name + "=" + box.value; }

            function refresh() {
                document.querySelectorAll("details[data-group]").forEach(function (group) {
                    var members = [].slice.call(group.querySelectorAll('input[name="Targets"]'));
                    var box = group.querySelector(".group-box");
                    var on = members.filter(function (m) { return m.checked; }).length;

                    if (!box) { return; }

                    box.checked = members.length > 0 && on === members.length;
                    box.indeterminate = on > 0 && on < members.length;
                });

                if (!summary) { return; }

                var all = document.querySelector('input[name="Everyone"]');
                var named = boxes().filter(function (b) {
                    return b.name === "Targets" && b.checked;
                }).map(function (b) { return b.value; });

                summary.textContent = all && all.checked
                    ? "To: everyone in this conversation."
                    : named.length
                        ? "To: " + named.join(", ") + "."
                        : "To: nobody chosen yet.";
            }

            function snapshot() {
                var checked = {};
                var open = {};

                boxes().forEach(function (b) { checked[key(b)] = b.checked; });
                document.querySelectorAll("details[data-group]").forEach(function (d) {
                    open[d.getAttribute("data-group")] = d.open;
                });

                return { checked: checked, open: open };
            }

            // Kept with the conversation, in this browser, so who the reader was writing to is still ticked
            // after a send, a reload or a return another day. Storage can be refused, and the page then
            // simply starts as the server drew it.
            function remember() {
                try { window.localStorage.setItem(memory, JSON.stringify(snapshot())); } catch (e) { }
            }

            function restore(kept) {
                boxes().forEach(function (b) {
                    if (Object.prototype.hasOwnProperty.call(kept.checked, key(b))) {
                        b.checked = kept.checked[key(b)];
                    }
                });
                document.querySelectorAll("details[data-group]").forEach(function (d) {
                    var was = kept.open[d.getAttribute("data-group")];

                    if (was !== undefined) { d.open = was; }
                });
                refresh();
                remember();
            }

            document.addEventListener("change", function (e) {
                var t = e.target;

                if (!(t instanceof HTMLInputElement)) { return; }

                if (t.classList.contains("group-box")) {
                    t.closest("details").querySelectorAll('input[name="Targets"]').forEach(function (m) {
                        m.checked = t.checked;
                    });
                }

                refresh();
                remember();
            });

            try {
                var saved = JSON.parse(window.localStorage.getItem(memory) || "null");

                if (saved && saved.checked && saved.open) {
                    restore(saved);
                } else if (document.querySelector(".recipients[data-new]")
                    && !boxes().some(function (b) { return b.checked; })) {
                    // A conversation with no messages and nothing chosen yet: the project's default agent, from its
                    // settings page, is ticked first. Only a start; the person can untick it before sending.
                    var preferred = [];

                    try {
                        var list = JSON.parse(window.localStorage.getItem("parley-default-to:" + params.get("project")) || "[]");

                        preferred = Array.isArray(list) ? list : [];
                    } catch (e) { }

                    var ticked = false;

                    boxes().forEach(function (b) {
                        if (b.name === "Targets" && preferred.indexOf(b.value) >= 0) { b.checked = true; ticked = true; }
                    });

                    if (ticked) { remember(); }
                }
            } catch (e) { }

            refresh();

            return { snapshot: snapshot, restore: restore };
        })();
    </script>

    <script>
        // Following the conversation, the way the terminal's open transcript does. Progressive
        // enhancement: with no script the page is the conversation as it was when it was read, and
        // says when that was.
        //
        // One read at a time -- the next is scheduled when the last has finished, never on a timer
        // that could stack reads behind a slow broker. Nothing is touched when the region's digest
        // is unchanged, which is almost every read. When it has changed, the reader is not moved:
        // a reader at the bottom is kept at the bottom, and anybody else keeps the message they were
        // looking at exactly where it was on screen, whatever grew above or below it.
        //
        // The new region is parsed by DOMParser and moved in as nodes. It is markup the server
        // rendered with every agent-written field encoded; nothing here builds HTML from a payload,
        // and a parsed document runs no scripts.
        (function () {
            var region = document.getElementById("followed");
            var side = document.getElementById("followed-side");
            var uncertain = document.getElementById("uncertain");
            var between = document.getElementById("between");

            if (!region || !window.fetch || !window.DOMParser) { return; }

            var url = region.getAttribute("data-follow");
            var every = 3000;

            // **Tailed**: the page opens on the newest message and stays
            // there while the reader does, as the terminal's transcript does. At the end means the end of
            // the newest message is on screen -- not the page's own bottom, because the composer sits below
            // it, and not merely its first line, because a reader on the message before it can see that
            // much and is still reading back. Anywhere else the reader is not moved at all.
            function newest() {
                var turns = region.querySelectorAll("li.turn");
                return turns.length ? turns[turns.length - 1] : null;
            }

            function atBottom() {
                var last = newest();
                return !last || last.getBoundingClientRect().bottom <= window.innerHeight + 8;
            }

            // **Instant, never animated.** The stylesheet smooths scrolling for the reader's own jumps, and a smoothed
            // tail is a scroll that is still travelling when the next layout change (a message arriving, the page
            // settling after a send) moves its target, so it stopped partway up a long message. Tailing is a position, not
            // a journey.
            function jump(top) { window.scrollTo({ top: top, left: 0, behavior: "instant" }); }

            function tail() {
                // All the way down, not to the end of the newest message: the composer is pinned over the bottom of the
                // window, so stopping at the message leaves the entry box out of view.
                jump(document.documentElement.scrollHeight);
            }

            function anchor() {
                var turns = region.querySelectorAll("li.turn");

                for (var i = 0; i < turns.length; i++) {
                    var box = turns[i].getBoundingClientRect();

                    if (box.bottom > 0) { return { id: turns[i].id, top: box.top }; }
                }

                return null;
            }

            // **Following has a limit.** A reader at the end of the page is always followed. A reader whose newest message
            // merely ends on screen is followed only by a short arrival: following a long one would carry what they are
            // reading out of sight, which is the page moving under somebody mid-sentence. They stay where they are and are
            // told, with a button that takes them there when they choose. 30% of the window is the most such a follow may
            // move the page.
            var arrived = document.createElement("button");

            arrived.type = "button";
            arrived.className = "new-below";
            arrived.hidden = true;
            arrived.innerHTML = '<span class="icon" aria-hidden="true">expand_more</span> New message';
            arrived.addEventListener("click", function () { arrived.hidden = true; tail(); });
            document.body.appendChild(arrived);

            window.addEventListener("scroll", function () {
                if (!arrived.hidden && atBottom()) { arrived.hidden = true; }
            }, { passive: true });

            // A reader at the very end of the page has nothing left to read, so is always followed, however long the
            // arrival. The limit is for a reader whose newest message merely ends on screen.
            function pageEnd() {
                return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 24;
            }

            function farther() {
                return document.documentElement.scrollHeight - window.scrollY - window.innerHeight > window.innerHeight * 0.3;
            }

            function moved(from) {
                return [].slice.call(from.childNodes).map(function (n) { return document.adoptNode(n); });
            }

            function apply(fresh, freshSide) {
                var bottom = atBottom();
                var end = pageEnd();
                var held = anchor();
                var kept = window.parleyTree ? window.parleyTree.snapshot() : null;

                region.replaceChildren.apply(region, moved(fresh));

                if (side && freshSide) { side.replaceChildren.apply(side, moved(freshSide)); }

                region.setAttribute("data-seen", fresh.getAttribute("data-seen") || "");

                if (kept) { window.parleyTree.restore(kept); }

                if (between) { between.textContent = fresh.getAttribute("data-participants") || ""; }

                if (bottom && (end || !farther())) {
                    arrived.hidden = true;
                    tail();
                } else if (held && held.id) {
                    if (bottom) { arrived.hidden = false; }

                    var again = document.getElementById(held.id);

                    if (again) { jump(window.scrollY + again.getBoundingClientRect().top - held.top); }
                }

                document.dispatchEvent(new CustomEvent("parley:followed"));
            }

            function next() { window.setTimeout(read, every); }

            function read() {
                // A tab nobody is looking at asks nobody anything; it reads again when it is shown.
                if (document.hidden) { next(); return; }

                fetch(url, { cache: "no-store", credentials: "same-origin" })
                    .then(function (r) {
                        if (!r.ok) { throw new Error(String(r.status)); }
                        return r.text();
                    })
                    .then(function (html) {
                        var parsed = new DOMParser().parseFromString(html, "text/html");
                        var fresh = parsed.getElementById("followed");

                        if (!fresh) { throw new Error("no region"); }

                        if (uncertain) { uncertain.hidden = true; }

                        if (fresh.getAttribute("data-seen") !== region.getAttribute("data-seen")) {
                            apply(fresh, parsed.getElementById("followed-side"));
                        }
                    })
                    .catch(function () {
                        // Said, and the transcript left as it was. Setting it again while it is
                        // already showing announces nothing new, so this is once per outage.
                        if (uncertain) { uncertain.hidden = false; }
                    })
                    .then(next);
            }

            // Opened at the newest message, unless the address names one to go to. Again once everything has loaded,
            // because fonts and the recipients tree change the height after the first look, and a message just sent
            // (this page is the answer to that post) must be the one on screen.
            if (!window.location.hash) {
                tail();
                window.addEventListener("load", tail);
            }

            next();
        })();

        // Selecting a message marks every other message from the same agent, in the rail and in
        // the transcript. The rail groups by colour, which is no grouping at all for a reader who
        // cannot separate the hues -- so selection dims what does not match, outlines what does,
        // and says in a sentence how many there are and whose they were.
        //
        // Selection is the URL fragment rather than state of its own, so it works however the
        // reader got here: a click on a tick, a pasted link, the back button. The rail and the
        // note are looked up each time, because following replaces them.
        (function () {
            function clear() {
                var rail = document.querySelector(".timeline");
                var note = document.getElementById("kin");

                if (rail) { rail.classList.remove("focused"); }
                if (note) { note.textContent = ""; }

                document.querySelectorAll(".kin").forEach(function (el) {
                    el.classList.remove("kin");
                });
            }

            function mark() {
                clear();

                var rail = document.querySelector(".timeline");
                var note = document.getElementById("kin");

                if (!rail || !note) { return; }

                var id = window.location.hash.slice(1);

                if (!id) { return; }

                var chosen = document.getElementById(id);

                if (!chosen) { return; }

                var agent = chosen.getAttribute("data-agent");

                if (!agent) { return; }

                // Attribute selector rather than a class: the agent's own name is what matches,
                // so this cannot drift from whatever palette slot it happens to have been given.
                var kin = document.querySelectorAll('[data-agent="' + agent + '"]');

                kin.forEach(function (el) { el.classList.add("kin"); });
                rail.classList.add("focused");

                var count = Math.round(kin.length / 2);

                note.textContent = count === 1
                    ? "1 message from " + agent + " in this conversation."
                    : count + " messages from " + agent + ", marked in the timeline.";
            }

            window.addEventListener("hashchange", mark);
            document.addEventListener("parley:followed", mark);
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { clear(); }
            });

            mark();
        })();

        // Showing only some of the conversation. A message is kept when it involves who was asked for:
        // "only between me and an agent" keeps the messages the person sent or was sent, and the agents
        // list keeps those sent by or to any agent ticked. Both together keep what satisfies both, which
        // is the person's exchanges with those agents.
        //
        // Done by hiding, never by removing: following replaces the transcript every few seconds, so the
        // choice is held here and put back on each replacement, and clearing it shows everything again with
        // nothing to reload. The agent list is read from the messages themselves so it grows with the
        // conversation. Nothing is built from message text; the names go in as text nodes.
        (function () {
            var bar = document.getElementById("filter");

            if (!bar) { return; }

            var human = bar.getAttribute("data-human") || "";
            var only = document.getElementById("only-me");
            var menu = document.getElementById("pick-menu");
            var label = document.getElementById("pick-summary");
            var clear = document.getElementById("filter-clear");
            var note = document.getElementById("filtered");
            var chosen = {};

            // Sending is a full page load, which would otherwise throw the choice away at exactly the moment
            // somebody is watching for the answer. Kept for this conversation and this tab only; where storage
            // is refused the filter simply starts clear, as it did.
            var params = new URLSearchParams(window.location.search);
            var memory = "parley-filter:" + params.get("project") + "/" + params.get("id");

            function remember() {
                try {
                    window.localStorage.setItem(memory, JSON.stringify({ only: only.checked, chosen: chosen }));
                } catch (e) { }
            }

            try {
                var saved = JSON.parse(window.localStorage.getItem(memory) || "null");

                if (saved && typeof saved === "object") {
                    only.checked = saved.only === true;
                    chosen = saved.chosen && typeof saved.chosen === "object" ? saved.chosen : {};
                }
            } catch (e) { }

            bar.hidden = false;

            function agents() {
                var seen = {};

                document.querySelectorAll("li.turn").forEach(function (t) {
                    // data-to lists every recipient of a send to several agents, separated by spaces.
                    [t.getAttribute("data-agent")].concat((t.getAttribute("data-to") || "").split(" ")).forEach(function (n) {
                        if (n && n !== human) { seen[n] = true; }
                    });
                });

                return Object.keys(seen).sort();
            }

            function build() {
                var names = agents();
                var have = [].slice.call(menu.querySelectorAll("input")).map(function (i) { return i.value; });

                if (names.join("|") === have.join("|")) { return; }

                menu.replaceChildren();

                names.forEach(function (n) {
                    var row = document.createElement("label");
                    var box = document.createElement("input");

                    box.type = "checkbox";
                    box.value = n;
                    box.checked = !!chosen[n];
                    row.appendChild(box);
                    row.appendChild(document.createTextNode(" " + n));
                    menu.appendChild(row);
                });
            }

            function wanted() { return Object.keys(chosen).filter(function (n) { return chosen[n]; }); }

            function keeps(turn, picked) {
                var from = turn.getAttribute("data-agent");
                var to = (turn.getAttribute("data-to") || "").split(" ");

                if (only.checked && from !== human && to.indexOf(human) < 0) { return false; }

                return picked.length === 0 || picked.indexOf(from) >= 0
                    || to.some(function (n) { return picked.indexOf(n) >= 0; });
            }

            function run() {
                build();

                var picked = wanted();
                var items = [].slice.call(document.querySelectorAll("#followed ol.transcript > li"));
                var rail = document.querySelector(".timeline");
                var shown = 0;
                var total = 0;
                var lastTurn = true;
                var day = null;
                var dayHasOne = false;

                function closeDay() { if (day) { day.classList.toggle("filtered-out", !dayHasOne); } }

                items.forEach(function (li) {
                    if (li.classList.contains("day")) {
                        closeDay();
                        day = li;
                        dayHasOne = false;
                        return;
                    }

                    if (li.classList.contains("turn")) {
                        total++;
                        lastTurn = keeps(li, picked);
                        li.classList.toggle("filtered-out", !lastTurn);

                        if (lastTurn) { shown++; dayHasOne = true; }

                        var tick = rail && rail.querySelector('a[href="#' + li.id + '"]');

                        if (tick) { tick.classList.toggle("filtered-out", !lastTurn); }

                        return;
                    }

                    // A note between messages belongs to the one before it.
                    li.classList.toggle("filtered-out", !lastTurn);
                });

                closeDay();

                var active = only.checked || picked.length > 0;

                label.textContent = picked.length === 0
                    ? "Any agent"
                    : picked.length === 1 ? picked[0] : picked.length + " agents";
                clear.hidden = !active;
                note.textContent = active ? "Showing " + shown + " of " + total + " messages." : "";

                var strip = document.getElementById("strip-filtered");

                if (strip) { strip.hidden = !active; }

                remember();

                document.dispatchEvent(new CustomEvent("parley:filtered"));
            }

            only.addEventListener("change", run);

            menu.addEventListener("change", function (e) {
                chosen[e.target.value] = e.target.checked;
                run();
            });

            clear.addEventListener("click", function () {
                only.checked = false;
                chosen = {};
                menu.querySelectorAll("input").forEach(function (i) { i.checked = false; });
                run();
            });

            // A dropdown that stays open over the transcript is in the way.
            document.addEventListener("click", function (e) {
                var pick = document.getElementById("pick");

                if (pick && pick.open && !pick.contains(e.target)) { pick.open = false; }
            });

            document.addEventListener("parley:followed", run);
            run();
        })();

        // Find within the conversation. It marks whole messages and their ticks, and marks the
        // words themselves inside the bubbles, and marks again when following brings new ones.
        //
        // The words are wrapped by moving existing text nodes into <mark> elements, never by
        // building HTML from them. A peer wrote that text; the page has kept it as content
        // everywhere else, and a search box would be a poor place to stop.
        (function () {
            var box = document.getElementById("find");
            var note = document.getElementById("found");

            if (!box || !note) { return; }

            function strip(root) {
                root.querySelectorAll("mark[data-found]").forEach(function (m) {
                    var parent = m.parentNode;
                    m.replaceWith(document.createTextNode(m.textContent));
                    parent.normalize();
                });
            }

            function paint(el, needle) {
                var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
                var texts = [];

                while (walker.nextNode()) { texts.push(walker.currentNode); }

                var found = false;

                texts.forEach(function (node) {
                    var at = node.textContent.toLowerCase().indexOf(needle);

                    if (at < 0) { return; }

                    found = true;

                    var tail = node.splitText(at);
                    tail.splitText(needle.length);

                    var wrap = document.createElement("mark");
                    wrap.setAttribute("data-found", "");
                    tail.replaceWith(wrap);
                    wrap.appendChild(tail);
                });

                return found;
            }

            function run() {
                var rail = document.querySelector(".timeline");
                var turns = [].slice.call(document.querySelectorAll("li.turn:not(.filtered-out)"));
                var needle = box.value.trim().toLowerCase();

                if (!rail) { return; }

                strip(document);
                turns.forEach(function (t) { t.classList.remove("hit"); });
                document.querySelectorAll(".tick.hit").forEach(function (t) {
                    t.classList.remove("hit");
                });
                rail.classList.remove("searching");

                if (needle.length < 2) {
                    note.textContent = "";
                    return;
                }

                var hits = 0;

                turns.forEach(function (turn) {
                    // Each message is searched whole: what was said, the numbered points, the
                    // consequences, and the two agents in the attribution line -- because "who
                    // said this" is as much a thing to look for as "what did they say".
                    if (!paint(turn, needle)) { return; }

                    hits++;
                    turn.classList.add("hit");

                    var tick = rail.querySelector('a[href="#' + turn.id + '"]');

                    if (tick) { tick.classList.add("hit"); }
                });

                rail.classList.add("searching");

                note.textContent = hits === 0
                    ? "No messages contain that."
                    : hits === 1
                        ? "1 message contains that, marked in the timeline."
                        : hits + " messages contain that, marked in the timeline.";
            }

            var pending;

            box.addEventListener("input", function () {
                window.clearTimeout(pending);
                pending = window.setTimeout(run, 150);
            });

            box.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { box.value = ""; run(); }
            });

            document.addEventListener("parley:followed", run);
            document.addEventListener("parley:filtered", run);
        })();

        // Enter sends and Shift+Enter makes a line break, as the terminal does. Ctrl+Enter sends too, for anyone used to it.
        // Left alone while an input method is composing, where Enter confirms the text and is not the person's send.
        (function () {
            var form = document.getElementById("composer");
            var box = form ? form.querySelector("textarea[name=Says]") : null;

            if (!box) { return; }

            box.addEventListener("keydown", function (e) {
                if (e.key !== "Enter" || e.isComposing || e.shiftKey || e.altKey) { return; }

                e.preventDefault();

                if (box.value.trim() !== "" && form.requestSubmit) { form.requestSubmit(); }
            });
        })();

        // Typing @@ in the box offers the project's agents, narrowing as the person types. Choosing one ticks it in the
        // recipients tree and completes the @@name in the text, which stays: it is part of what the person said. The
        // addressing is the "To" list, never the text (a payload is never parsed for addressing). Arrow keys and Enter or Tab choose, Escape closes.
        (function () {
            var form = document.getElementById("composer");
            var box = form ? form.querySelector("textarea[name=Says]") : null;

            if (!box) { return; }

            var list = document.createElement("ul");
            var shown = [];
            var at = 0;
            var start = -1;

            list.id = "mention-list";
            list.className = "mention-list";
            list.setAttribute("role", "listbox");
            list.hidden = true;
            form.appendChild(list);

            function close() { list.hidden = true; shown = []; start = -1; }

            function agents() {
                return [].slice.call(document.querySelectorAll('input[name="Targets"]')).filter(function (b) {
                    return b.value.indexOf("human-user@@") !== 0;
                });
            }

            // The @@word being typed, if the caret is at the end of one that begins at a word boundary.
            function word() {
                var upto = box.value.slice(0, box.selectionStart);
                var m = /(^|\s)@@([A-Za-z0-9@@._\-]*)$/.exec(upto);

                return m ? { from: upto.length - m[2].length - 1, query: m[2].toLowerCase() } : null;
            }

            function draw() {
                list.replaceChildren();

                shown.forEach(function (b, i) {
                    var li = document.createElement("li");

                    li.setAttribute("role", "option");
                    li.setAttribute("aria-selected", i === at ? "true" : "false");
                    li.textContent = b.value + (b.checked ? " (chosen)" : "");
                    li.addEventListener("mousedown", function (e) { e.preventDefault(); choose(b); });
                    list.appendChild(li);
                });

                list.hidden = shown.length === 0;
            }

            function update() {
                var w = word();

                if (!w) { close(); return; }

                start = w.from;
                shown = agents().filter(function (b) { return b.value.toLowerCase().indexOf(w.query) >= 0; })
                    .sort(function (a, b) {
                        var x = a.value.toLowerCase().indexOf(w.query) === 0 ? 0 : 1;
                        var y = b.value.toLowerCase().indexOf(w.query) === 0 ? 0 : 1;

                        return x - y || a.value.localeCompare(b.value);
                    }).slice(0, 8);
                at = 0;
                draw();
            }

            function choose(b) {
                var end = box.selectionStart;
                var before = box.value.slice(0, start);
                var after = box.value.slice(end);

                // The mention stays in the words: it may be an instruction to that agent the others should see.
                var mention = "@@" + b.value + (/^\s/.test(after) ? "" : " ");

                box.value = before + mention + after;
                box.selectionStart = box.selectionEnd = before.length + mention.length;

                if (!b.checked) {
                    b.checked = true;
                    b.dispatchEvent(new Event("change", { bubbles: true }));
                }

                close();
                box.focus();
            }

            box.addEventListener("input", update);
            box.addEventListener("click", update);
            box.addEventListener("blur", close);

            // Captured on the form so it runs before the box's own Enter-sends handler.
            form.addEventListener("keydown", function (e) {
                if (list.hidden || e.target !== box) { return; }

                if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                    e.preventDefault();
                    at = (at + (e.key === "ArrowDown" ? 1 : shown.length - 1)) % shown.length;
                    draw();
                } else if (e.key === "Enter" || e.key === "Tab") {
                    e.preventDefault();
                    e.stopPropagation();
                    choose(shown[at]);
                } else if (e.key === "Escape") {
                    e.preventDefault();
                    close();
                }
            }, true);
        })();

        // "Reply to this" on an agent's question points the composer at that exchange, so the words answer it. Delegated,
        // because the transcript is replaced as it is followed.
        (function () {
            var field = document.getElementById("reply-to");
            var bar = document.getElementById("replying");
            var said = document.getElementById("replying-text");
            var cancel = document.getElementById("reply-cancel");
            var form = document.getElementById("composer");

            if (!field || !bar || !form) { return; }

            var outcome = document.getElementById("reply-outcome");

            function clear() { field.value = ""; bar.hidden = true; outcome.value = ""; outcome.hidden = true; }

            document.addEventListener("click", function (e) {
                var closing = e.target.closest ? e.target.closest("button.close-request") : null;

                if (!closing) { return; }

                var closer = document.getElementById("close-request");

                // Back to the address this page was opened at, so an embedded page stays embedded.
                closer.action = location.pathname + location.search + "&handler=CloseRequest";
                document.getElementById("closing").value = closing.getAttribute("data-exchange");
                closer.submit();
            });

            document.addEventListener("click", function (e) {
                var button = e.target.closest ? e.target.closest("button.reply-to") : null;

                if (!button) { return; }

                field.value = button.getAttribute("data-exchange");
                said.textContent = "Replying to " + button.getAttribute("data-agent") + "'s question (exchange " + field.value + "). Your words answer it.";
                bar.hidden = false;
                outcome.value = "";
                outcome.hidden = !button.hasAttribute("data-request");

                var box = form.querySelector("textarea[name=Says]");
                form.scrollIntoView({ block: "end" });
                if (box) { box.focus(); }
            });

            cancel.addEventListener("click", clear);
        })();

        // Closing the panel, and going through what is waiting on the person. The links are in the followed region and are
        // replaced every few seconds, so they are read at each press.
        (function () {
            var page = document.getElementById("convo-page");
            var closer = document.getElementById("panel-close");
            var opener = document.getElementById("panel-open");

            if (!page || !closer || !opener) { return; }

            closer.hidden = false;

            function setClosed(closed) {
                page.classList.toggle("panel-closed", closed);

                try {
                    window.localStorage.setItem("parley-convo-panel", closed ? "closed" : "open");
                } catch (e) { }
            }

            closer.addEventListener("click", function () { setClosed(true); });
            opener.addEventListener("click", function () { setClosed(false); });

            // In the order they sit in the transcript, not grouped by agent as the list is: going through them should only
            // ever move one way down the conversation.
            function waiting() {
                return [].slice.call(document.querySelectorAll("a[data-waiting]")).sort(function (a, b) {
                    return Number(a.getAttribute("href").slice(2)) - Number(b.getAttribute("href").slice(2));
                });
            }

            function show() {
                var links = waiting();
                var at = links.findIndex(function (link) { return link.getAttribute("href") === location.hash; });
                var where = document.getElementById("waiting-where");
                var count = document.getElementById("strip-count");
                var strip = document.getElementById("strip-waiting");

                links.forEach(function (link) {
                    if (link.getAttribute("href") === location.hash) {
                        link.setAttribute("aria-current", "location");
                    } else {
                        link.removeAttribute("aria-current");
                    }
                });

                if (where) { where.textContent = at >= 0 ? (at + 1) + " of " + links.length : ""; }

                if (count) { count.textContent = links.length; }

                if (strip) { strip.hidden = links.length === 0; }
            }

            // A message the filter is hiding cannot be scrolled to, and the link would appear not to work. What was asked for
            // is that message, so the filter gives way.
            function reveal() {
                var target = location.hash.length > 1 ? document.getElementById(location.hash.slice(1)) : null;

                if (target && target.classList.contains("filtered-out")) {
                    var clear = document.getElementById("filter-clear");

                    if (clear) { clear.click(); }

                    target.scrollIntoView();
                }
            }

            document.addEventListener("click", function (e) {
                var button = e.target.closest ? e.target.closest("[data-waiting-step]") : null;

                if (!button) { return; }

                var links = waiting();

                if (links.length === 0) { return; }

                var step = Number(button.getAttribute("data-waiting-step"));
                var at = links.findIndex(function (link) { return link.getAttribute("href") === location.hash; });
                var next = at < 0 ? (step > 0 ? 0 : links.length - 1) : (at + step + links.length) % links.length;
                var href = links[next].getAttribute("href");

                if (href === location.hash) {
                    document.getElementById(href.slice(1)).scrollIntoView();
                } else {
                    location.hash = href;
                }
            });

            window.addEventListener("hashchange", function () { reveal(); show(); });
            document.addEventListener("parley:followed", show);

            reveal();
            show();
        })();

        // Picking entries to move, in place. Picking changes nothing: what was ticked is sent to the Move page, which says
        // what would go and asks. The tick boxes are in the followed region and are replaced every few seconds, so what is
        // picked is held here and put back.
        (function () {
            var start = document.getElementById("move-start");
            var bar = document.getElementById("move-bar");
            var page = document.getElementById("convo-page");
            var go = document.getElementById("move-go");
            var said = document.getElementById("move-count");

            if (!start || !bar || !page || !document.getElementById("followed")) { return; }

            var picked = {};

            function boxes() { return [].slice.call(document.querySelectorAll(".move-pick input")); }

            function exchanges() {
                var all = {};

                boxes().forEach(function (b) {
                    if (picked[b.getAttribute("data-exchanges")]) {
                        b.getAttribute("data-exchanges").split(" ").forEach(function (x) { all[x] = true; });
                    }
                });

                return Object.keys(all);
            }

            function show() {
                boxes().forEach(function (b) { b.checked = !!picked[b.getAttribute("data-exchanges")]; });

                var many = exchanges().length;

                go.disabled = many === 0;
                said.textContent = many === 0 ? "Tick what you want to move." : many === 1 ? "1 exchange picked." : many + " exchanges picked.";
            }

            function picking(on) {
                page.classList.toggle("picking", on);
                bar.hidden = !on;

                if (!on) { picked = {}; }

                show();
            }

            start.addEventListener("click", function (e) { e.preventDefault(); picking(true); });
            document.getElementById("move-cancel").addEventListener("click", function () { picking(false); });

            document.addEventListener("change", function (e) {
                var box = e.target;

                if (!box.closest || !box.closest(".move-pick")) { return; }

                if (box.checked) { picked[box.getAttribute("data-exchanges")] = true; } else { delete picked[box.getAttribute("data-exchanges")]; }

                show();
            });

            go.addEventListener("click", function () {
                var to = new URL(start.href, location.href);

                exchanges().forEach(function (x) { to.searchParams.append("x", x); });
                window.top.location.assign(to.href);
            });

            document.addEventListener("parley:followed", show);
        })();

        // What is waiting on the person in the project's other conversations. A separate, slower read than following: it
        // exports every open conversation the person is in, which is not something to do every three seconds. It has no
        // frame, so like following it keeps no seat, and it reads without collecting, so nothing is marked delivered. An
        // embedded page leaves it out: it sits inside a roadmap, which is about that item.
        (function () {
            var region = document.getElementById("followed");

            if (!region || !window.fetch || !window.DOMParser || document.body.classList.contains("embed")) { return; }

            var url = region.getAttribute("data-follow").replace("handler=Follow", "handler=WaitingElsewhere");
            var every = 60000;
            var held = null;
            var memory = "parley-elsewhere-open";

            function place() {
                var slot = document.getElementById("elsewhere");

                if (slot && held && held.parentNode !== slot) { slot.replaceChildren(held); }
            }

            function wasClosed() {
                try { return window.localStorage.getItem(memory) === "closed"; } catch (e) { return false; }
            }

            function next() { window.setTimeout(read, every); }

            function read() {
                if (document.hidden) { next(); return; }

                fetch(url, { cache: "no-store", credentials: "same-origin" })
                    .then(function (r) {
                        if (!r.ok) { throw new Error(String(r.status)); }
                        return r.text();
                    })
                    .then(function (html) {
                        var fresh = new DOMParser().parseFromString(html, "text/html").getElementById("elsewhere-list");

                        if (!fresh) { return; }

                        held = document.adoptNode(fresh);

                        var open = held.querySelector("details");

                        if (open && wasClosed()) { open.open = false; }

                        if (open) {
                            open.addEventListener("toggle", function () {
                                try { window.localStorage.setItem(memory, open.open ? "open" : "closed"); } catch (e) { }
                            });
                        }

                        place();
                    })
                    // The list stays as it was. Following is what says the broker cannot be reached.
                    .catch(function () { })
                    .then(next);
            }

            document.addEventListener("parley:followed", place);
            read();
        })();
    </script>
}
