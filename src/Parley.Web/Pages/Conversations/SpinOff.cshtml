@page
@model Parley.Web.Pages.Conversations.SpinOffModel
@{
    ViewData["Title"] = "Spin off a conversation";
    ViewData["Project"] = Model.Project;
}

<h1>Spin off from @Model.Id</h1>
<p class="lede">
    A new conversation, linked to this one. Nothing exists and nothing is sent until you press Send. The agent gets a line
    saying this is a side conversation from @Model.Id, and exactly what is in the box. It gets no access to @Model.Id from this.
</p>

@if (Model.Problem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">@problem</p>
}

@if (Model.Sent.Count > 0)
{
    <ul class="sent" role="status">
        @foreach (var (agent, outcome) in Model.Sent)
        {
            <li><strong>@agent</strong> @outcome</li>
        }
    </ul>
}

<form method="post" class="move-form" enctype="multipart/form-data">
    <p>
        <label for="name">What it is called</label><br />
        <input id="name" name="Name" type="text" required autocomplete="off" spellcheck="false" maxlength="@Parley.Client.ConversationName.Longest"
               pattern="@Parley.Client.ConversationName.Pattern" data-correct="@Parley.Client.ConversationName.Allowed" title="@Parley.Client.ConversationName.Rule" value="@Model.Name" />
        <br /><small>@Parley.Client.ConversationName.Rule</small>
    </p>

    <fieldset class="move-to">
        <legend>Who it goes to</legend>
        @foreach (var agent in Model.Agents)
        {
            <label>
                <input type="checkbox" name="Targets" value="@agent.Value" checked="@Model.Targets.Contains(agent.Value, StringComparer.Ordinal)" />
                @agent.Value
            </label>
        }
    </fieldset>

    <p>
        <partial name="_Composer" model="@(new Parley.Web.ComposerBox(
            "Says", Model.Says, Id: "says", Rows: 12, Label: "What you want to say", Attach: true))" />
        <br /><small>@Parley.Client.Rendering.Quoting.OpeningIsAdded</small>
    </p>

    <p class="move-actions">
        <button type="submit">Send</button>
        <a class="button quiet" href="@Url.Page("/Conversations/Detail", new { project = Model.Project, id = Model.Id })">Cancel</a>
    </p>
</form>
