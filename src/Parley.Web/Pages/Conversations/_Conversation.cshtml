@model Parley.Web.Pages.Conversations.DetailModel
@* The part of a conversation's page that changes as the conversation goes: the roster, the messages
   and the timeline. A partial of its own because two things render it and they must not differ --
   the page, and the Follow handler a following page asks every few seconds. A copy of this markup
   in the handler would be a transcript that read one way on arrival and another a few seconds
   later. *@
@if (Model.Destroyed is { } gone)
{
    @* A destroyed conversation and one that never existed are different answers, and an operator
       who cannot tell them apart cannot tell a destroy from a store that lost something. *@
    <p class="outcome">That conversation was destroyed.</p>
    <ul>
        @foreach (var line in Parley.Client.Rendering.Reading.Gone(gone))
        {
            <li>@line</li>
        }
    </ul>
}
else if (Model.Messages.Count == 0)
{
    @* Still offers who to write to: a conversation that has no messages yet is how one begins, and the tree is
       what the composer addresses. *@
    <div class="conversation">
        <div class="side">
            <partial name="_Recipients" model="Model" />
        </div>
        <p>Nothing was recorded under this identifier.</p>
    </div>
}
else
{
    <div class="conversation">
    @* A participant is derived from the traffic (§5.0), so one may have been retired or purged since it spoke --
       the registry's word is asked for, and its absence is reported rather than filled in. *@
    @* **One column for everything beside the transcript.** `.conversation` is a three-column grid -- this, the
       transcript, the rail -- so each of these as a child of its own took a cell and pushed the transcript into
       a narrow one beneath the first roster. They stack here instead. *@
    <div class="side">
    <partial name="_Recipients" model="Model" />

    <p class="roster-legend">@Parley.Client.Rendering.RoomRoster.ParticipantLegend</p>

    @if (Model.WaitingOnYou.Count > 0)
    {
        @* What is waiting on the person, each agent once with how many of its questions, and each question a link to
           where it was asked -- the terminal's room list, from the same derivation. The words are the
           agent's and are escaped like every other agent-written text. *@
        <section class="waiting-on-you" aria-label="Waiting on you">
            <h2>Waiting on you</h2>
            <ul>
                @foreach (var on in Model.WaitingOnYou)
                {
                    <li>
                        <strong>@on.Peer.Value</strong> (@on.Questions.Count)
                        <ol>
                            @foreach (var question in on.Questions)
                            {
                                <li>
                                    @if (question.At is { } at)
                                    {
                                        <a href="@($"#m{at}")" target="_self">@Parley.Web.Pages.Conversations.DetailModel.Start(question)</a>
                                    }
                                    else
                                    {
                                        @Parley.Web.Pages.Conversations.DetailModel.Start(question)
                                    }
                                </li>
                            }
                        </ol>
                    </li>
                }
            </ul>
        </section>
    }
    </div>

    <ol class="transcript">
        @{ var day = default(DateOnly?); }
        @foreach (var turn in Model.Turns())
        {
            var message = turn[0];
            var said = Payload.Read(message.PayloadJson);
            var on = DateOnly.FromDateTime(
                TimeZoneInfo.ConvertTime(message.CreatedUtc, TimeZoneInfo.Local).DateTime);
            var ghost = turn.All(Model.ClosedUnfinished);

            @* A date only where the date changes, the way a messenger marks a new day. The
               times come from the machines the agents run on, so this follows the record rather
               than a wall clock -- if two clocks disagree the divider says so by appearing
               twice, which is more honest than smoothing it. *@
            if (day != on)
            {
                day = on;
                <li class="day">@TimeZoneInfo.ConvertTime(message.CreatedUtc, TimeZoneInfo.Local).ToString("dddd, d MMMM yyyy")</li>
            }

            <li id="@($"m{message.Id}")" data-agent="@message.From.Value" data-to="@string.Join(' ', turn.Select(m => m.To.Value))"
                class="turn slot-@Palette.SlotFor(message.From)@(ghost ? " ghosted" : null)">
                <div class="who" aria-hidden="true">@Palette.BadgeFor(message.From)</div>

                <div class="bubble">
                    <p class="attribution">
                        <strong>@Speaker.From(message)</strong>
                        <span class="arrow">to</span>
                        @* One send to several agents is one message, so every recipient is named here. *@
                        <strong>@string.Join(", ", turn.Select(m => Speaker.To(m)))</strong>
                        @* The reader's own clock. What is stored stays UTC, and the export
                           still says so -- a file read by somebody else, somewhere else, needs the
                           Z that a screen does not. *@
                        <span class="stamp">@Parley.Client.Rendering.LocalTime.Clock(message.CreatedUtc)</span>
                    </p>

                    @* Razor encodes every one of these. An agent wrote them, and they are content
                       rather than markup: nothing here may alter the page or imitate a label the
                       console speaks. *@
                    @if (said.Raw is { Length: > 0 } raw)
                    {
                        <pre>@raw</pre>
                    }
                    else
                    {
                        @if (said.Said is { Length: > 0 } body)
                        {
                            <p class="said">@foreach (var part in Parley.Web.LinkedText.Split(body)) {if (part.Link is { } to) {<a href="@to.AbsoluteUri" target="_blank" rel="noopener noreferrer">@part.Text</a>} else {@part.Text}}</p>
                        }

                        @if (said.Points.Count > 0)
                        {
                            <ol class="points">
                                @foreach (var point in said.Points)
                                {
                                    <li>
                                        @if (point.Id is { Length: > 0 } label)
                                        {
                                            <span class="label">@label</span>
                                        }
                                        <span class="point-text">@foreach (var part in Parley.Web.LinkedText.Split(point.Text)) {if (part.Link is { } to) {<a href="@to.AbsoluteUri" target="_blank" rel="noopener noreferrer">@part.Text</a>} else {@part.Text}}</span>
                                        @if (point.Outcome is { Length: > 0 } || point.Sources.Count > 0)
                                        {
                                            @* On a line of their own: beside the text, several chips left it a narrow column. *@
                                            <span class="chits">
                                                @if (point.Outcome is { Length: > 0 } verdict)
                                                {
                                                    @* The word the receiver chose, shown rather than
                                                       summarised: "blocked" and "done" are different
                                                       outcomes and only one of them is finished. *@
                                                    <span class="verdict">@(point.Blocker is { } blocker ? $"{verdict}: {blocker.Replace('_', ' ')}" : verdict)</span>
                                                }
                                                @if (point.Sources.Count > 0)
                                                {
                                                    <span class="verdict">relied on @string.Join(", ", point.Sources)</span>
                                                }
                                            </span>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                    }

                    <p class="meta">
                        @if (ghost)
                        {
                            <span class="tag">closed by a person</span>
                        }
                        @message.Type
                        @if (turn.Count > 1)
                        {
                            <span> · exchanges @string.Join(", ", turn.Select(m => m.ExchangeId))</span>
                        }
                        else if (Model.StateOf(message) is { Length: > 0 } state)
                        {
                            <span> · exchange @message.ExchangeId, @state</span>
                        }
                        <span> · written by @message.ResponderModel</span>
                    </p>
                    @if (Model.AwaitsReply(message))
                    {
                        @* The person chooses which question their words answer; the console never guesses (SPEC.md 5.6). *@
                        <p class="reply-line">
                            <button type="button" class="reply-to" data-exchange="@message.ExchangeId" data-agent="@message.From.Value">Reply to this</button>
                        </p>
                    }
                    @if (Model.SettledBy(message) is { Length: > 0 } settled)
                    {
                        @* What this reply settled, from the record, so the person sees what the agent decided
                           whatever its words say (SPEC.md 5.6). Escaped like every other agent-written text. *@
                        <p class="settled">@settled</p>
                    }
                    @if (Model.RoleRequestOf(message) is { Length: > 0 } role)
                    {
                        @* How many of the agents a Request to a role reached have answered (SPEC.md 5.5). *@
                        <p class="settled">@role</p>
                    }
                </div>
            </li>
        }
    </ol>

    @* A minimap of the conversation. Ticks in the order the broker recorded them rather than
       spaced by clock: the times come from different machines, and proportional spacing would
       pile a burst into one pixel and stretch a quiet hour across the screen. Each carries its
       own text, so the colour is how you aim and never how you know. *@
    <p id="kin" class="kin-note" role="status"></p>

    <nav class="timeline" aria-label="Jump to a message">
        @{ var railDay = default(DateOnly?); }
        @foreach (var turn in Model.Turns())
        {
            var message = turn[0];
            var on = DateOnly.FromDateTime(
                TimeZoneInfo.ConvertTime(message.CreatedUtc, TimeZoneInfo.Local).DateTime);
            var closedByPerson = turn.All(Model.ClosedUnfinished);

            if (railDay != on)
            {
                railDay = on;
                <span class="rail-day">@TimeZoneInfo.ConvertTime(message.CreatedUtc, TimeZoneInfo.Local).ToString("d MMM")</span>
            }

            <a data-agent="@message.From.Value"
               class="tick slot-@Palette.SlotFor(message.From)@(closedByPerson ? " ghosted" : null)"
               href="@($"#m{message.Id}")" target="_self"
               title="@message.CreatedUtc.ToString("d MMM HH:mm") — @message.From.Value to @string.Join(", ", turn.Select(m => m.To.Value))@(closedByPerson ? " — closed by a person" : null)">
                <span class="visually-hidden">
                    @message.CreatedUtc.ToString("d MMM HH:mm"),
                    @message.From.Value to @string.Join(", ", turn.Select(m => m.To.Value))@(closedByPerson ? ", closed by a person" : null)
                </span>
            </a>
        }
    </nav>
    </div>
}
