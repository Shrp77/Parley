@model Parley.Web.Rendering.RosterView
@*
    The roster column, used by every page that shows one.

    A partial rather than markup repeated per page, because the two copies this replaces had
    already drifted: one linked each name to the agent's own page and the other did not, so the
    same list did different things depending on where a reader came from.
*@
<aside class="roster" aria-label="@Model.Heading">
    <h2>@Model.Heading</h2>

    @if (Model.Problem is { Length: > 0 } problem)
    {
        <p class="unreachable" role="alert">@problem</p>
    }
    else if (Model.Entries.Count == 0)
    {
        <p>
            None registered yet.
            <a href="/Projects/Register?project=@Model.Project">Add one.</a>
        </p>
    }
    else
    {
        <ul>
            @foreach (var entry in Model.Entries)
            {
                <li class="slot-@Palette.SlotFor(entry.Name)">
                    <span class="who" aria-hidden="true">@Palette.BadgeFor(entry.Name)</span>
                    <a class="name" href="/Projects/Agent?project=@Model.Project&amp;agent=@entry.Name.Value">@entry.Name.Value</a>
                    @* Retirement outranks presence, and a name the registry does not hold says
                       so rather than borrowing a state from the traffic that mentioned it. *@
                    <span class="state">@entry.State</span>
                </li>
            }
        </ul>
    }
</aside>
