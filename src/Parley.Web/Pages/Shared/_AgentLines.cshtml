@model Parley.Web.Pages.AgentTable
@using Parley.Web.Pages.Shared
@* The agents grid, one line for each agent (spec 041 follow-up). An agent is the repository somebody opened, so the one agent
   that several projects list is one line with each of its projects on it. A project that cannot be read is said, not drawn
   as no agents: unreachable is not empty, and none here would read as a project somebody has emptied. *@
@foreach (var unread in Model.Unread)
{
    <p class="dgrid-empty" data-unread="@unread.Project" role="alert"><span class="alarm">@unread.Project:</span> its agents cannot be listed.
        @(unread.Problem is { Length: > 0 } why ? why : "Its broker did not answer.")
        <a href="/Projects/Settings?project=@unread.Project">Open its settings</a></p>
}

@if (Model.Lines.Where(line => line.Rows.Any(r => r.Now.Working)).Select(line => line.Name.Role).ToList() is { Count: > 0 } working)
{
    <p class="dgrid-empty" data-working role="status"><strong>Working now:</strong> @string.Join(", ", working)</p>
}

@foreach (var line in Model.Lines)
{
    var who = line.Name;
    var best = line.Best;
    var (mark, words) = AgentStateMark.Split(best.Now.Words);

    <details class="dgrid-row slot-@Palette.SlotFor(who)" role="row" data-agent="@who.Value">
    <summary class="dgrid-line">
        <span role="cell">
            <span class="who" aria-hidden="true" style="display:inline-grid;vertical-align:middle;margin-right:0.5rem;width:1.6rem;height:1.6rem;font-size:0.58rem;">@Palette.BadgeFor(who)</span>
            <a class="name" title="@who.Value" href="/Projects/Agent?project=@best.Project&amp;agent=@who.Value">@who.Role</a>
        </span>
        <span role="cell">@@@who.Machine</span>
        <span role="cell">
            @foreach (var row in line.Rows)
            {
                <a class="project-chip" href="/Projects/Agent?project=@row.Project&amp;agent=@who.Value">@row.Project@if (row.Agent.Frozen)
                    {<span class="chip-mark" title="Frozen by you: nothing starts it" aria-label=", frozen">❄</span>}
                    else if (row.Agent.Status == Parley.Core.AgentStatus.Retired)
                    {<span class="visually-hidden">, retired</span><span aria-hidden="true"> (retired)</span>}</a>
            }
        </span>
        @* The state as a mark in a badge, its words the tooltip and what a screen reader says. Tapped on a touch screen, the
           row opens, and its detail says the state in words. *@
        <span role="cell" class="state-cell"><span class="state-mark @AgentStateMark.Tint(mark)" title="@words" aria-hidden="true">@mark</span><span class="state-words">@words</span></span>
    </summary>
    <div class="dgrid-detail">
        <dl class="facts">
            <dt>State</dt>
            <dd>@words@(line.Rows.Any(r => r.Agent.Frozen) ? ", frozen by you" : "")</dd>
            <dt>Owns</dt>
            <dd>@(line.Owns is { Length: > 0 } owns ? owns : "None stated.")</dd>
            @if (line.Rows.Count > 1)
            {
                <dt>In projects</dt>
                <dd>
                    @foreach (var row in line.Rows)
                    {
                        <div><a href="/Projects/Agent?project=@row.Project&amp;agent=@who.Value">@row.Project</a>: @row.Now.Words@(row.Agent.Frozen ? ", frozen" : "")</div>
                    }
                </dd>
            }
        </dl>
    </div>
    </details>
}
