           console's older names further down, so no other rule names a colour of its own.
           specs/035-material-3-web-ui/research.md says how each value was chosen. */
        :root {
            --md-sys-color-primary: #0042bb;
            --md-sys-color-on-primary: #ffffff;
            --md-sys-color-primary-container: #2b5cd9;
            --md-sys-color-on-primary-container: #dee3ff;
            --md-sys-color-secondary: #4e5c8e;
            --md-sys-color-on-secondary: #ffffff;
            --md-sys-color-secondary-container: #b9c7ff;
            --md-sys-color-on-secondary-container: #435283;
            --md-sys-color-tertiary: #7c2094;
            --md-sys-color-on-tertiary: #ffffff;
            --md-sys-color-tertiary-container: #983daf;
            --md-sys-color-on-tertiary-container: #fdd8ff;
            --md-sys-color-error: #ba1a1a;
            --md-sys-color-on-error: #ffffff;
            --md-sys-color-error-container: #ffdad6;
            --md-sys-color-on-error-container: #93000a;
            --md-sys-color-surface: #faf8ff;
            --md-sys-color-on-surface: #191b23;
            --md-sys-color-surface-variant: #e0e1f3;
            --md-sys-color-on-surface-variant: #434654;
            --md-sys-color-surface-dim: #d9d9e4;
            --md-sys-color-surface-bright: #faf8ff;
            --md-sys-color-surface-container-lowest: #ffffff;
            --md-sys-color-surface-container-low: #f3f3fe;
            --md-sys-color-surface-container: #ededf8;
            --md-sys-color-surface-container-high: #e7e7f2;
            --md-sys-color-surface-container-highest: #e2e1ec;
            --md-sys-color-outline: #747685;
            --md-sys-color-outline-variant: #c3c5d6;
            --md-sys-color-inverse-surface: #2e3038;
            --md-sys-color-inverse-on-surface: #f0f0fb;
            --md-sys-color-inverse-primary: #b5c4ff;
            --md-sys-color-scrim: #000000;
            --md-sys-color-shadow: #000000;
            /* Not a scheme role: the person's presence, beside their own name and said in words there too. */
            --md-ext-color-present: #1b7a46;
            /* A card on the page: the lowest container in light, one step up in dark, so a card always sits above the page. */
            --md-ext-color-card: var(--md-sys-color-surface-container-lowest);
            /* The eight agent colours: today's hues re-toned in HCT to tone 40 here and 75 in dark, so each reads against the
               surfaces and the eight stay apart. Decoration: every fact they tint is also written in words. */
            --md-ext-slot-0: #1f54d1;
            --md-ext-slot-1: #006c51;
            --md-ext-slot-2: #9a460a;
            --md-ext-slot-3: #793ebe;
            --md-ext-slot-4: #00687b;
            --md-ext-slot-5: #ad2b55;
            --md-ext-slot-6: #566519;
            --md-ext-slot-7: #3b608f;
            /* What is written on an agent's colour: its initials, and a found word. */
            --md-ext-on-slot: #ffffff;
            --md-ext-scrim: rgb(0 0 0 / 0.32);
        }

        /* Dark follows the system unless the person chose a theme on the Settings page, which sets data-theme on <html>
