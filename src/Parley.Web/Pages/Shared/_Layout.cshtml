@*
    The console's frame.

    Legibility is a correctness requirement here rather than a courtesy: the transcript's pair and
    visibility annotations are what stop a reader concluding that every participant saw every
    message, so they are carried as text and never by colour alone.
*@
@inject Parley.Client.Seating.SeatBook Seats
@inject Parley.Client.BrokerDirectory Directory
@inject Parley.Web.Notifications.NotificationLog Notices
@{
    // **The person's seat in every project, taken here with nothing typed**. The broker provides the seat
    // and never releases it; what this does is attach as it, if nothing holds it now, and mark the person here.
    //
    // A page render is evidence the person is at the console, and that is the whole of what keeps them marked here:
    // SPEC.md §4.0 has no heartbeat. Doing it in the frame means every page counts, including ones nobody instrumented.
    // **Except a page reloading itself**, which carries `reloaded` and is a timer, not a person (SPEC.md §14).
    //
    // Asked, not remembered, and **counted from every seat this console knows, held or not**. Mail waits against the
    // name, not the stream, so the count must work while the person is away — which is exactly when it matters. A count
    // nobody could confirm shows nothing rather than a zero: "no messages" and "could not ask" are different things.
    //
    // **A page that sets `Deferred` does not wait for either.** Both are answers from brokers, and a broker that is down
    // costs the page its timeout; the page asks afterwards (`?handler=Presence`) and fills the badge in.
    var deferred = ViewData["Deferred"] is true;

    // **File problems waiting, on every page** (SPEC.md §9.5): the project in view, or every project on a page about the
    // whole deployment. Asked beside the seats so a broker that is down costs one wait, and not on a page that defers,
    // for the reason the seats are not. Not on a page embedded in another, which drops the frame and the project's name
    // with it: the page around it says the count already.
    var problemsAbout = ViewData["Project"] as string ?? Context.Request.Query["project"].ToString();
    var problemsCounting = deferred || Parley.Web.ConsoleHost.Embedded(Context)
        ? Task.FromResult<IReadOnlyList<(string Project, int Waiting)>>([])
        : Parley.Web.FileProblemBanner.CountAsync(Directory, problemsAbout, Context.RequestAborted);

    // **Drawn as it stands, then kept true by the page itself** (SPEC.md §9.1): a page that asks a broker is drawn only
    // after a rewrite has let it, so what is read here can be over by the time it shows. The script below asks the seats
    // every two seconds and shows or hides it, including while the next page or a send waits. Not on an embedded page,
    // which drops the project's name.
    var embedded = Parley.Web.ConsoleHost.Embedded(Context);
    var tidying = embedded
        ? []
        : Seats.Seats().Where(hold => hold.Tidying).Select(hold => hold.Project).Distinct(StringComparer.Ordinal).ToList();

    (int Waiting, bool Certain) waiting = deferred
        ? (0, false)
        : await PersonSeats.PresenceAsync(
            Seats, Directory, Context.RequestAborted,
            person: !Context.Request.Query.ContainsKey(PersonSeats.Reloaded));

    var problems = await problemsCounting;

    var here = Seats.Seats();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* The theme and density the person chose on the Settings page, set before the stylesheet is read so a page never
       flashes in the other theme. Kept in this browser; with no script, or nothing chosen, the system's theme is used. *@
    <script>
        (function () {
            try {
                var theme = localStorage.getItem("parley.theme"), density = localStorage.getItem("parley.density");
                if (theme === "light" || theme === "dark") { document.documentElement.setAttribute("data-theme", theme); }
                if (density === "compact") { document.documentElement.setAttribute("data-density", "compact"); }
            } catch (e) { }
        })();
    </script>
    <title>@ViewData["Title"] — Parley console</title>
    <link rel="icon" href="/brand/icon.png" type="image/png" />
    @* Inline rather than a file, because a file has to survive `dotnet pack` into the tool that
       starts this console; inlining removes that whole class of problem.

       Every colour here reinforces something the text already says. Nothing is carried by hue
       alone: an unreachable project says it is unreachable, and a message nobody else saw names
       the agents who did not see it. *@
    @* The styles are served from the assembly, as the fonts are, under a name that changes with every build so a
       browser never keeps an old one after an install (feature 042, pass 0). *@
    <link rel="stylesheet" href="/brand/tokens.css?v=@Uri.EscapeDataString(Parley.Web.WebBuild.Version)" />
    @* The person's palette (feature 042), chosen on the Settings page and kept in this browser: the default unless the
       script below finds a choice, which it swaps in before the page is drawn. Only a ready-made name, or a base hue,
       chroma and harmony written as numbers and a word, is taken from storage; the console checks them again. *@
    <link rel="stylesheet" id="palette" href="/brand/palette.css?name=frost&amp;v=@Uri.EscapeDataString(Parley.Web.WebBuild.Version)" />
    <script>
        (function () {
            try {
                var chosen = localStorage.getItem("parley.palette");
                if (chosen && /^(name=[a-z-]{1,32}|hue=\d{1,3}&chroma=\d{1,3}&harmony=[a-z-]{1,32})$/.test(chosen)) {
                    document.getElementById("palette").href = "/brand/palette.css?" + chosen + "&v=@Uri.EscapeDataString(Parley.Web.WebBuild.Version)";
                }
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="/brand/components.css?v=@Uri.EscapeDataString(Parley.Web.WebBuild.Version)" />
    @* List views refresh themselves by reloading; a transcript never reloads. It follows its
       conversation instead, replacing only the region that changed and keeping the message a reader
       is looking at where it was -- a reload would throw away their place, what they had typed into
       the composer, and what they were searching for. Following is built so that it does not
       move a reader mid-sentence. *@
    @if (ViewData["Refresh"] is string seconds)
    {
        // The same page, marked as the timer's reload, so it does not count as somebody at the console.
        var query = Microsoft.AspNetCore.Http.QueryString.Create(
            Context.Request.Query
                .Where(pair => pair.Key != PersonSeats.Reloaded)
                .SelectMany(pair => pair.Value.Select(value => new KeyValuePair<string, string?>(pair.Key, value)))
                .Append(new KeyValuePair<string, string?>(PersonSeats.Reloaded, "1")));
        @* The reload waits while a dialog or an opened "create" card is open: it would close either under whoever is typing in it. Without script
           the page reloads on the timer as before. *@
        var target = $"{Context.Request.Path}{query}";
        <noscript><meta http-equiv="refresh" content="@($"{seconds};url={target}")" /></noscript>
        <meta name="parley-reload" content="@seconds" data-url="@target" />
        <script>
            (function () {
                var m = document.querySelector("meta[name=parley-reload]");
                var every = Number(m.content) * 1000;
                var key = "parley.reload-scroll";

                // A reload by the timer is a new navigation, which starts at the top and closes every opened row. Where a reader had
                // scrolled to (the window, and the list that is the scroller on a grid page), and which rows were open, are kept
                // across it, and only across it, so following a link still starts at the top. A grid's rows arrive after the page does,
                // so the place is taken back as they arrive, until the reader moves or it is held.
                var rowKey = function (row) { return row.getAttribute("data-agent") || row.getAttribute("data-project") || ""; };

                try {
                    var kept = JSON.parse(sessionStorage.getItem(key) || "null");
                    sessionStorage.removeItem(key);

                    if (kept && kept.path === location.pathname) {
                        var settled = false;
                        var stop = function () { settled = true; };
                        var put = function () {
                            if (settled) { return; }

                            var grid = document.querySelector(".dgrid");
                            (kept.open || []).forEach(function (id) {
                                var row = id && document.querySelector('details.dgrid-row[data-agent="' + CSS.escape(id) + '"], details.dgrid-row[data-project="' + CSS.escape(id) + '"]');
                                if (row && !row.open) { row.open = true; }
                            });

                            if (typeof kept.y === "number" && kept.y > 0) { window.scrollTo(0, kept.y); }
                            if (grid && typeof kept.grid === "number" && kept.grid > 0) { grid.scrollTop = kept.grid; }
                        };
                        var tries = 0;
                        var again = function () {
                            put();
                            if (!settled && ++tries < 40) { setTimeout(again, 150); }
                        };

                        ["wheel", "keydown", "pointerdown", "touchstart"].forEach(function (name) { window.addEventListener(name, stop, { once: true, passive: true, capture: true }); });
                        document.addEventListener("DOMContentLoaded", again);
                        again();
                    }
                } catch (e) { }

                var keep = function () {
                    try {
                        var grid = document.querySelector(".dgrid");
                        sessionStorage.setItem(key, JSON.stringify({
                            path: location.pathname,
                            y: window.scrollY,
                            grid: grid ? grid.scrollTop : 0,
                            open: Array.prototype.map.call(document.querySelectorAll("details.dgrid-row[open]"), rowKey).filter(Boolean)
                        }));
                    } catch (e) { }
                };

                (function tick() {
                    setTimeout(function () {
                        if (document.querySelector("dialog[open], details.view-create[open], details.filters-fold[open]")) { tick(); } else { keep(); location.replace(m.getAttribute("data-url")); }
                    }, every);
                })();
            })();
        </script>
    }
</head>
<body class="@(ViewData["Grid"] is true ? "grid-page" : null) @(Parley.Web.ConsoleHost.Embedded(Context) ? "embed" : null)">
    @if (Parley.Web.ConsoleHost.Embedded(Context))
    {
        @* Inside the roadmap's frame, a link to any other page of the console opens in the whole window: every other page
           refuses to be framed, so followed in the frame it would draw nothing. A link that names its target is left
           alone, so the page's own in-page links say `_self` (FragmentLinksStayInTheFrameTests). Forms still post in
           the frame. *@
        <script data-embed-links>
            document.addEventListener("click", function (e) {
                var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;

                if (a && !a.target && !a.hasAttribute("download") && a.origin === window.location.origin) { a.target = "_top"; }
            }, true);
        </script>
    }
    <script>
        try { if (localStorage.getItem("parley.nav") === "collapsed") { document.documentElement.setAttribute("data-nav", "collapsed"); } } catch (e) { }
    </script>
    <a class="skip" href="#main" target="_self">Skip to content</a>
    @{
        var path = Context.Request.Path.Value ?? "/";
        var agentsView = path == "/" && Context.Request.Query["tab"] == "agents";
        var project = ViewData["Project"] as string ?? Context.Request.Query["project"].ToString();
        var onAgentsTab = agentsView && project.Length == 0;
        var q = Uri.EscapeDataString(project);
        // Each place says whether it is on a phone's bottom bar (feature 042, the UI contract's compact class) and what
        // the bar's More calls it when it is not. The bar holds four: Projects, the agents (the project's when in one), the
        // Inbox and the project's conversations, in the page's order, so focus and a screen reader go along the bar as it
        // is drawn. More holds the rest and is drawn only on a phone.
        var projectOpen = project.Length > 0;
        var rail = new List<(string Href, string Label, string Icon, bool Current, bool Bar, string MoreLabel)>
        {
            ("/", "Projects", "grid_view", path == "/" && !agentsView, true, "Projects"),
            ("/?tab=agents", "All Agents", "group", onAgentsTab, !projectOpen, "All Agents"),
            ("/Inbox", "Inbox", "inbox", path.StartsWith("/Inbox", StringComparison.Ordinal), true, "Inbox"),
        };
        // At the foot with the toggle, in both states, so a project's own items never sit between it and the rest.
        (string Href, string Label, string Icon, bool Current, bool Bar, string MoreLabel) parleySettings =
            ("/Settings", "Settings", "settings", path == "/Settings", false, "Console settings");
        var inProjectRail = new List<(string Href, string Label, string Icon, bool Current, bool Bar, string MoreLabel)>();

        if (projectOpen)
        {
            inProjectRail =
            [
                ($"/Projects/Agents?project={q}", "Conversations", "chat_bubble", path == "/Projects/Agents" || path.StartsWith("/Conversations", StringComparison.Ordinal), true, "Conversations"),
                // One agent's page, its ownership and registering one are all reached from the agents list, so they light it.
                ($"/?tab=agents&project={q}", "Agents", "group", agentsView || path is "/Projects/Agent" or "/Projects/Ownership" or "/Projects/Register" or "/Projects/Enrol", true, "Agents"),
                ($"/Roadmaps?project={q}", "Roadmaps", "map", path.StartsWith("/Roadmaps", StringComparison.Ordinal), false, "Roadmaps"),
                ($"/Projects/Files?project={q}", "Files", "description", path is "/Projects/Files" or "/Projects/FileProblems", false, "Files"),
                ($"/Projects/Health?project={q}", "Health", "monitor_heart", path == "/Projects/Health", false, "Health"),
                ($"/Projects/Settings?project={q}", "Settings", "tune", path == "/Projects/Settings", false, "Project settings"),
            ];
        }

        // A class, not a data attribute: Razor drops a class whose value is null, but always writes a `data-` attribute,
        // empty for null, and an empty one would still mark a link as on the bar.
        string? BarClass(bool bar) => bar ? "bar" : null;
        var more = rail.Concat(inProjectRail).Append(parleySettings).Where(item => !item.Bar).ToList();
    }
    <aside class="rail" id="rail" aria-label="Navigation">
        <a class="brand" href="/">
            @* Decorative: the word beside it says the same thing, so a reader who cannot see
               the image loses nothing and a screen reader is not told it twice. *@
            <img src="/brand/icon.png" alt="" width="128" height="125" />
            <span class="rail-label">Parley <span>console</span></span>
        </a>
        @* What a page offers to start (a conversation, a project, an agent), at the top of the rail where Material 3 keeps a
           rail's action button, rather than as cards across the top of the page (the person's feedback on feature 042). On a
           phone the same buttons float above the bottom bar. Each is a <details>, so it opens with no script. *@
        @if (IsSectionDefined("Actions"))
        {
            <div class="rail-actions">
                @await RenderSectionAsync("Actions")
            </div>
        }
        <nav aria-label="Sections">
            @foreach (var item in rail)
            {
                <a href="@item.Href" title="@item.Label" aria-current="@(item.Current ? "page" : null)" class="@BarClass(item.Bar)">
                    <span class="icon" aria-hidden="true">@item.Icon</span>
                    <span class="rail-label">@item.Label</span>
                    @if (item.Label == "Inbox" && waiting is { Certain: true, Waiting: > 0 })
                    {
                        <span class="seat-waiting">@waiting.Waiting<span class="visually-hidden"> messages waiting for you</span></span>
                    }
                    else if (item.Label == "Inbox" && deferred)
                    {
                        <span class="seat-waiting" data-inbox-badge hidden></span>
                    }
                </a>
            }
            @if (inProjectRail.Count > 0)
            {
                <p class="rail-heading">@project</p>
                @foreach (var item in inProjectRail)
                {
                    <a href="@item.Href" title="@item.Label" aria-current="@(item.Current ? "page" : null)" class="@BarClass(item.Bar)">
                        <span class="icon" aria-hidden="true">@item.Icon</span>
                        <span class="rail-label">@item.Label</span>
                    </a>
                }
            }
        @* More, the bar's fifth place: drawn only on a phone, where the bar has room for four. It opens with no script.
           Inside the sections, so moving by landmark finds the whole bar. *@
        <details class="rail-more">
            <summary title="More" aria-current="@(more.Any(item => item.Current) ? "page" : null)">
                @* Drawn, as the conversation's magnifier is: the console's cut-down icon font has neither of these glyphs. *@
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2" fill="currentColor"/><circle cx="12" cy="12" r="2" fill="currentColor"/><circle cx="19" cy="12" r="2" fill="currentColor"/></svg>
                <span class="rail-label">More</span>
            </summary>
            <div class="rail-more-list">
                @foreach (var item in more)
                {
                    <a href="@item.Href" aria-current="@(item.Current ? "page" : null)">
                        <span class="icon" aria-hidden="true">@item.Icon</span>
                        <span>@item.MoreLabel</span>
                    </a>
                }
                @if (!Parley.Web.ConsoleHost.Embedded(Context))
                {
                    @* Hidden until the graph's script wires it: with no script there is no graph to open. *@
                    <button type="button" class="quiet" data-pg-open aria-controls="pg-panel" aria-expanded="false" hidden>
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="6" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="15" y="4" width="6" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="15" y="15" width="6" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 6.5h6M12 6.5v11h3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                        <span>Graph</span>
                    </button>
                }
            </div>
        </details>
        </nav>
        <nav class="rail-foot" aria-label="Console settings">
            <a href="@parleySettings.Item1" title="@parleySettings.Item2" aria-current="@(parleySettings.Item4 ? "page" : null)">
                <span class="icon" aria-hidden="true">@parleySettings.Item3</span>
                <span class="rail-label">@parleySettings.Item2</span>
            </a>
        </nav>
        <button type="button" class="rail-toggle" id="rail-toggle" aria-controls="rail" aria-expanded="true">
            <span class="icon" aria-hidden="true">chevron_left</span>
            <span class="rail-label">Collapse</span>
        </button>
    </aside>
    <script>
        // A page action's panel closes as a menu does: a tap outside it, or Escape. It opens and closes with no script.
        (function () {
            document.addEventListener("click", function (e) {
                Array.prototype.forEach.call(document.querySelectorAll(".rail-actions details[open]"), function (act) {
                    if (!act.contains(e.target)) { act.open = false; }
                });
            });
            document.addEventListener("keydown", function (e) {
                if (e.key !== "Escape" || e.defaultPrevented) { return; }

                var act = document.activeElement && document.activeElement.closest ? document.activeElement.closest(".rail-actions details[open]") : null;

                if (act) { e.stopImmediatePropagation(); act.open = false; act.querySelector("summary").focus(); }
            });
        })();

        // More closes as a menu does: a tap outside it, or Escape. It opens and closes with no script.
        (function () {
            var more = document.querySelector(".rail-more");

            if (!more) { return; }

            document.addEventListener("click", function (e) { if (more.open && !more.contains(e.target)) { more.open = false; } });
            more.addEventListener("focusout", function (e) { if (more.open && e.relatedTarget && !more.contains(e.relatedTarget)) { more.open = false; } });
            // Escape closes the menu and only the menu: registered before the page's other Escape handlers, it stops them.
            document.addEventListener("keydown", function (e) { if (e.key === "Escape" && more.open && !e.defaultPrevented && more.contains(document.activeElement)) { e.stopImmediatePropagation(); more.open = false; more.querySelector("summary").focus(); } });
        })();
    </script>
    <div class="page">
    <header>
        @if ((ViewData["Project"] as string ?? Context.Request.Query["project"].ToString()) is { Length: > 0 } inProject)
        {
            @* Where in the deployment the page is, on every page, so a conversation is never without its project, and on a
               conversation's page the conversation beside it (the person's feedback on feature 042), so its name is in sight
               however far the transcript is scrolled. *@
            <span class="where">
                <a class="crumb" href="/Projects/Agents?project=@Uri.EscapeDataString(inProject)" title="This project">@inProject</a>
                @if (ViewData["Conversation"] is string { Length: > 0 } inConversation)
                {
                    <span class="crumb-sep" aria-hidden="true">/</span>
                    <span class="crumb-here" title="This conversation">@inConversation</span>
                }
            </span>
        }
        @* Which build is running and when the page's facts were read, stacked at the right of the top bar, small and out of
           the way (the person's feedback on feature 042). The build is how a person tells an install has taken. A page whose
           title row says when it was read, or whose grid does, draws that there instead. *@
        <span class="stamps">
            <span class="build" title="The web console build">parley-web-ui @Parley.Web.WebBuild.Version</span>
            @if (ViewData["AsOf"] is string asOf && ViewData["Grid"] is not true && ViewData["AsOfInTitle"] is not true)
            {
                <span class="as-of" role="status">As of @asOf.</span>
            }
        </span>
        <nav aria-label="Console">
            @{
                var unread = Notices.Unread();
                var recent = Notices.Latest(8);
                var bellLabel = unread > 0 ? $"Notifications, {unread} new" : "Notifications";
            }
            @* What the console told you after you sent something, kept so it can be read again. Opens with no script. *@
            <details class="bell">
                <summary title="Notifications" aria-label="@bellLabel">
                    <span class="icon" aria-hidden="true">notifications</span>
                    @if (unread > 0)
                    {
                        <span class="seat-waiting">@unread</span>
                    }
                </summary>
                <div class="bell-list">
                    @if (recent.Count == 0)
                    {
                        <p class="bell-empty">Nothing yet.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var note in recent)
                            {
                                <li class="@(note.Good ? "notice" : "notice notice-bad")">
                                    <strong>@note.Source</strong> @note.Text
                                    @if (note.Conversation is { Length: > 0 } talk)
                                    {
                                        <a href="/Conversations/Detail?project=@Uri.EscapeDataString(note.Project)&amp;id=@Uri.EscapeDataString(talk)">Open @talk</a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    <a class="bell-all" href="/Notifications">See all notifications</a>
                </div>
            </details>
            @if (here.Count > 0)
            {
                @* The count goes to the inbox, where what is waiting can be collected. There is no Leave
                   beside it: the seat is the broker's and is never given back, and closing the console is how a
                   person stops being here. *@
                <a class="seat-who" href="/Inbox" title="Your messages">
                    <span class="seat-dot" aria-hidden="true"></span>@here[0].Seat.Person
                    @if (waiting is { Certain: true, Waiting: > 0 })
                    {
                        <span class="seat-waiting">@waiting.Waiting<span class="visually-hidden">
                            messages waiting for you</span></span>
                    }
                </a>
            }
            else
            {
                @* No broker answered, or none has a seat for a person. Nothing to take and nothing to type: the count,
                   if any could be read, still says there is something to come back for. *@
                <a class="seat-who" href="/Inbox" title="Your messages">
                    not connected
                    @if (waiting is { Certain: true, Waiting: > 0 })
                    {
                        <span class="seat-waiting">@waiting.Waiting<span class="visually-hidden">
                            messages waiting for you</span></span>
                    }
                </a>
            }
        </nav>
    </header>
    <main id="main">

        @* Said until the person dismisses each one, because only the person decides what becomes of a quarantined file.
           The project's name is somebody's text and Razor encodes it like everything else. *@
        @if (!embedded)
        {
            <p class="file-problems-banner" role="status" data-tidying hidden="@(tidying.Count == 0)">@string.Join(" ", tidying.Select(PersonSeats.TidyingSays))</p>
        }

        @foreach (var (problemProject, problemCount) in problems)
        {
            <p class="file-problems-banner">
                <a href="@Parley.Web.FileProblemBanner.Page?project=@Uri.EscapeDataString(problemProject)">@Parley.Client.Files.FileProblemSaid.Says(problemCount) in @problemProject. See them.</a>
            </p>
        }

        @RenderBody()
    </main>
    </div>
    <script>
        // --frame is what the sticky frame occupies, and three other things are positioned
        // against it: the roster, the minimap, and where an anchor lands. A constant is a guess,
        // and it is wrong the moment the frame wraps to two lines -- which it does on a narrow
        // screen, and would again the next time anything is added to the nav. Nothing would
        // report it: the roster would simply sit under the header, and a tick would scroll its
        // message out of sight behind it.
        //
        // Measured, so the number cannot drift from the thing it describes. The value in the
        // stylesheet stands until this runs and is what a reader without scripts keeps, which is
        // why it is a reasonable figure rather than a placeholder.
        (function () {
            var frame = document.querySelector('header');

            if (!frame || !window.ResizeObserver) {
                return;
            }

            var apply = function () {
                document.documentElement.style.setProperty(
                    '--frame', frame.getBoundingClientRect().height + 'px');
            };

            new ResizeObserver(apply).observe(frame);
            apply();
        })();

        // **A field whose rule can be applied applies it, rather than refusing after the fact.**
        // A rule applied after the form is sent loses the words the person typed, so it is
        // applied as they type.
        //
        // Every rule here is written once, in C#, and reaches this page as the attributes a field
