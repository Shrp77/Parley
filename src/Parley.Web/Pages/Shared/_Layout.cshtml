        .view-filters .tally { margin: 0 0 0.25rem auto; align-self: flex-end; display: inline-flex; align-items: center; min-height: 2.5rem; font-size: 0.85rem; color: var(--ink-faint); }
        .still-open { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; padding: 0.7rem 1.1rem; margin: 0; }
        .still-open > p { flex: 1 1 24rem; margin: 0; }
