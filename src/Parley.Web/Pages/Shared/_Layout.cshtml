        .still-open > details summary { cursor: pointer; }
        .still-open-asked { padding: 0.7rem 1.1rem; max-height: 14rem; overflow: auto; }
        .still-open-asked h2 { margin: 0 0 0.4rem; font: var(--md-sys-typescale-title-small); }
        .still-open-asked table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        .still-open-asked th { text-align: left; font-weight: 600; color: var(--ink-faint); }
        .still-open-asked th, .still-open-asked td { padding: 0.3rem 0.5rem 0.3rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; overflow-wrap: anywhere; }
        .still-open-asked .asked-state { font-weight: 600; }
        /* A reference to an exchange (spec 036): reads as a link, opens a panel under its line. */
        .exchange-ref { display: inline; padding: 0 0.15em; margin: 0; font: inherit; color: var(--md-sys-color-primary); background: none; border: 0; border-bottom: 1px dashed currentColor; border-radius: 0; cursor: pointer; min-height: 0; }
        .exchange-ref[aria-expanded="true"] { border-bottom-style: solid; font-weight: 600; }
        .exchange-panel { margin: 0.4rem 0 0.8rem; padding: 0.6rem 0.9rem; border-left: 3px solid var(--md-sys-color-primary); border-radius: var(--radius); background: var(--md-sys-color-surface-container); font-size: 0.92rem; overflow-wrap: anywhere; }
        .exchange-panel-state { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; margin: 0 0 0.4rem; }
        .exchange-panel-messages { list-style: none; margin: 0; padding: 0; }
        .exchange-panel-messages > li { padding: 0.4rem 0; border-top: 1px solid var(--rule); }
        /* The Inbox's views (spec 036). */
        .inbox-views { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.5rem 1.1rem; margin: 0; list-style: none; }
        .inbox-views a { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.9rem; border-radius: 999px; border: 1px solid var(--rule); color: inherit; text-decoration: none; }
        .inbox-views a[aria-current="page"] { background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); border-color: transparent; font-weight: 600; }
        .chip-state { display: inline-block; padding: 0 0.55rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; background: var(--md-sys-color-surface-container-high); }
        .chip-state.state-working, .chip-state.state-background { background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
        .chip-state.state-cannotstart, .chip-state.flag { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); }
        .inbox-window { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
        .inbox-window input { width: 6rem; }
        .inbox-changed { margin: 0; padding: 0.5rem 1.1rem; border-radius: var(--radius); background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); }
        .inbox-changed[hidden] { display: none; }

        .view .field { display: flex; flex-direction: column; gap: 0.2rem; flex: 1 1 11rem; min-width: 0; }
        .view .field.wide { flex-grow: 3; }
        /* Pill-shaped here; the base rules own everything else about a field, the chevron included. */
        /* Not stretched by the column they stand in: a narrow screen's rule gives an input a flex size, which in a column is its height. */
        .view .field input, .view .field select, dialog .field input { width: 100%; flex: none; }
        .view .view-filters button, .view .view-filters .button { align-self: flex-end; margin-bottom: 0.25rem; }
        .conversations { display: flex; flex-direction: column; gap: 0.75rem; }
        .new-conversation { margin: 0; }
        #new-conversation-dialog form { display: block; border: 0; background: none; box-shadow: none; padding: 0; margin: 0; }
        .new-conversation-dialog .field, #new-conversation-dialog .field { display: flex; flex-direction: column; gap: 0.25rem; }
        #new-conversation-dialog input { width: 100%; }
        #new-conversation-dialog .composer-note { margin: 1rem 0 0; }
        #new-conversation-dialog .dialog-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin: 1.5rem 0 0; }
        /* A switch, as Material 3 draws one: a 52 by 32 track, outlined while off with a small handle, filled with the primary
           colour while on with a larger handle in its "on" colour. The words beside it say what it switches. */
        .view .view-filters .toggle { display: inline-flex; align-items: center; gap: 0.75rem; align-self: flex-end; min-height: 2.5rem; padding: 0 0.25rem; color: var(--ink); font: var(--md-sys-typescale-body-medium); cursor: pointer; white-space: nowrap; }
        .view .view-filters .toggle input { appearance: none; -webkit-appearance: none; position: relative; flex: none; width: 3.25rem; height: 2rem; margin: 0; border: 2px solid var(--md-sys-color-outline); border-radius: var(--md-sys-shape-corner-full); background: var(--md-sys-color-surface-container-highest); cursor: pointer; transition: background-color var(--md-sys-motion-duration-short) var(--md-sys-motion-easing-standard), border-color var(--md-sys-motion-duration-short); }
        .view .view-filters .toggle input::before { content: ""; position: absolute; top: 50%; left: 0.375rem; width: 1rem; height: 1rem; border-radius: 50%; background: var(--md-sys-color-outline); opacity: 1; transform: translateY(-50%); transition: transform var(--md-sys-motion-duration-short) var(--md-sys-motion-easing-standard), width var(--md-sys-motion-duration-short), height var(--md-sys-motion-duration-short), left var(--md-sys-motion-duration-short); }
        .view .view-filters .toggle input:checked { background: var(--md-sys-color-primary); border-color: var(--md-sys-color-primary); }
        .view .view-filters .toggle input:checked::before { left: 1.375rem; width: 1.5rem; height: 1.5rem; background: var(--md-sys-color-on-primary); }
        .view .view-filters .toggle input:hover { box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--md-sys-color-on-surface) var(--md-sys-state-hover), transparent); }
        .view .view-filters .toggle:has(input:focus-visible) input { outline: 3px solid var(--md-sys-color-secondary); outline-offset: 2px; }

        /* On these pages the grid is the scroller, so the page itself must not be: the window is divided between the
           frame and the view. */
        .grid-page .page { padding-bottom: 0.5rem; }
        .grid-page .view { height: calc(100vh - var(--frame) - 1.5rem - 5.2rem); }

        .dgrid { flex: 1 1 auto; min-height: 0; overflow: auto; border-radius: 20px; }
        .dgrid-inner { min-width: var(--min, 40rem); }
        .dgrid-head, .dgrid-line { display: grid; grid-template-columns: var(--cols); gap: 0.8rem; align-items: baseline; padding: 0.6rem 1.1rem; }
        .dgrid-head { position: sticky; top: 0; z-index: 2; background: var(--quiet-wash); border-bottom: 1px solid var(--rule); font-size: 0.76rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-faint); }
        .dgrid-row + .dgrid-row { border-top: 1px solid var(--rule); }
        .dgrid-line > * { min-width: 0; overflow-wrap: anywhere; }
        details.dgrid-row > summary { list-style: none; cursor: pointer; }
        details.dgrid-row > summary::-webkit-details-marker { display: none; }
        details.dgrid-row[open] > summary { background: var(--quiet-wash); }
        /* An open row's line stays just under the header while what is in it scrolls, so who it is with, the project and
           the conversation stay in sight and a press closes it from anywhere in it (owner, 2026-11-13). Its background is
           opaque, or the text scrolling under it shows through. The frame's script measures the header into
           --dgrid-head-h; the value here is its usual height, for a page with no script. */
        .dgrid { --dgrid-head-h: 2.75rem; }
        details.dgrid-row[open] > summary { position: sticky; top: var(--dgrid-head-h); z-index: 1; border-bottom: 1px solid var(--rule); }
        .dgrid-detail { padding: 0.4rem 1.1rem 1rem; border-top: 1px solid var(--rule); }
        .dgrid-detail .letter { margin-top: 0; }
        .dgrid-detail .facts { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.3rem 1rem; margin: 0.6rem 0 0; }
        .dgrid-detail .facts dt { font-size: 0.76rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-faint); padding-top: 0.15rem; }
        .dgrid-detail .facts dd { margin: 0; overflow-wrap: anywhere; }
        .dgrid-detail .note { margin: 0.6rem 0 0; }
        .dgrid .status-cell .alarm + .alarm, .dgrid .status-cell span + .alarm { margin-left: 0.5rem; }
        .dgrid .name { font-weight: 650; }
        .dgrid .faint { color: var(--ink-faint); font-size: 0.85rem; }
        .dgrid .alarm { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--alarm); font-weight: 600; }
        .dgrid .alarm .icon { font-size: 1.1rem; }
        .dgrid .note { display: block; margin: 0.25rem 0 0; font-size: 0.82rem; }
        .dgrid-empty { padding: 1.4rem 1.1rem; color: var(--ink-soft); }

        /* The conversations as a grid: name, messages, last active. A row opens to show who is in it and the acts. */
        .grid { margin: 0.5rem 0 1rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--card); }
        .grid-head, .grid-row > summary { display: grid; grid-template-columns: minmax(0, 1fr) 5.5rem minmax(10rem, 14rem); gap: 0.8rem; align-items: baseline; padding: 0.55rem 1rem; }
        .grid-head { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-faint); border-bottom: 1px solid var(--rule); }
        .roadmap-grid .grid-head, .roadmap-grid .grid-row > summary { grid-template-columns: minmax(0, 1fr) 5.5rem 5.5rem; }
        .roadmap-grid .grid-head span:not(:first-child) { text-align: right; }
        .items-grid .grid-head, .items-grid .grid-row > summary { grid-template-columns: 3.5rem minmax(0, 1fr) minmax(10rem, 16rem); }
        .items-grid .num { text-align: left; white-space: nowrap; }
        .grid.items-grid .name { font-weight: 400; }
        .chev { color: var(--ink-faint); font-size: 1.25rem; vertical-align: -0.3em; transition: transform 0.12s; }
        details[open] > summary .chev { transform: rotate(90deg); }
        .items-grid .grid-row.next { background: var(--quiet-wash); }
        .grid-row + .grid-row { border-top: 1px solid var(--rule); }
        .grid-row > summary { cursor: pointer; list-style: none; }
        .grid-row > summary::-webkit-details-marker { display: none; }
        .grid .name { font-weight: 650; overflow-wrap: anywhere; }
        .grid .num { text-align: right; font-variant-numeric: tabular-nums; }
        .grid .when { font-size: 0.82rem; color: var(--ink-soft); }
        /* A page shown inside another (a roadmap item's conversation) drops the console's frame and keeps its content. */
        html:has(body.embed) { --frame: 0px; }
        body.embed .rail, body.embed header, body.embed .as-of, body.embed .skip { display: none !important; }
        body.embed .page { margin-left: 0; padding: 0 0.75rem 0.75rem; }
        .item-bar { flex: 1 1 100%; display: flex; align-items: center; gap: 0.8rem; }
        .item-bar .between { flex: 1; }
        .item-bar .button { flex: none; white-space: nowrap; }
        .item-frame { flex: 1 1 100%; width: 100%; height: 70vh; min-height: 24rem; border: 1px solid var(--rule); border-radius: 14px; background: var(--page); }
        .grid-detail { padding: 0.2rem 1rem 0.8rem; display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; }
        .grid-detail .between { flex: 1 1 100%; margin: 0; font-size: 0.85rem; color: var(--ink-soft); }
        .grid-detail form { margin: 0; }
        @@media (max-width: 40rem) {
            .grid-head, .grid-row > summary { grid-template-columns: minmax(0, 1fr) 3.5rem; }
            .grid-head :last-child, .grid .when { grid-column: 1 / -1; }
        }

        /* A conversation somebody still owes an answer to. Said in words beside the tint. */
        .tag.open {
            color: var(--accent);
            border-color: var(--accent);
        }

        h1 .who {
            display: inline-grid;
            vertical-align: middle;
            margin-right: 0.5rem;
        }

        .lede { font-size: 1rem; color: var(--ink-soft); margin: 0 0 1.25rem; max-width: 44rem; }

        table th[scope="row"] {
            width: 10rem;
            background: transparent;
            text-transform: none;
            letter-spacing: 0;
            font-size: 0.85rem;
            color: var(--ink-faint);
        }

        /* Anchored jumps land with a little air above them rather than flush to the edge. */
        li.turn { scroll-margin-top: calc(var(--frame) + 1rem); }

        @@media (prefers-reduced-motion: no-preference) {
            html { scroll-behavior: smooth; }
        }

        /* Text for a screen reader where the page uses shape or colour to aim the eye. */
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        /* The minimap. One tick per message in the order the broker recorded them, tinted by
           who spoke -- so a long conversation shows its shape: who dominated it, where it
           changed hands, and where a person closed something. */
        /* The note and the rail together are the grid's second column. Sticky as one, so the note travels with the
           rail it describes. Not `.rail`, which is the navigation rail. */
        .minimap {
            position: sticky;
            top: calc(var(--frame) + 1rem);
            min-width: 0;
        }

        /* One column, however long: the rail is a nav, and the console's nav rule wraps, which once a long conversation
           filled the rail's height started a second column of ticks. Only the narrow layout's horizontal rail wraps. */
        /* No scrollbar, and still scrollable: by wheel, touch and keys, and by the page itself, which keeps the tick of the
           message being read in view. A bar beside a column of ticks only drew the eye to the wrong thing. */
        .timeline::-webkit-scrollbar { display: none; }

        .timeline {
            display: flex;
            flex-direction: column;
            flex-wrap: nowrap;
            scrollbar-width: none;
            align-items: stretch;
            gap: 2px;
            padding: 0.5rem 0.4rem;
            background: var(--card);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
        }

        /* Scrolls in the room the composer leaves it, rather than running on underneath it. */
        @@media (min-width: 60.01rem) {
            .timeline { max-height: calc(100vh - var(--frame) - var(--composer-h, 0px) - 2rem); overflow-y: auto; }
            .timeline > * { flex: none; }
        }

        .timeline .tick {
            display: block;
            height: 0.5rem;
            border-radius: 2px;
            background: var(--agent);
            opacity: 0.65;
        }

        .timeline .tick:hover, .timeline .tick:focus-visible { opacity: 1; }

        /* The message being read. A ring, so it still shows when the tint does not, and it outranks what dims the others. */
        .timeline .tick.here, .timeline.focused .tick.here:not(.kin) {
            opacity: 1;
            box-shadow: 0 0 0 2px var(--md-sys-color-primary, var(--ink));
        }

        /* An exchange a person closed, marked by shape as well as tint: it is taller and outlined,
           so it is findable on a screen where the colours are not. */
        .timeline .tick.ghosted {
            height: 0.85rem;
            background: var(--alarm-wash);
            border: 2px solid var(--alarm);
            opacity: 1;
        }

        .timeline .rail-day {
            font-size: 0.6rem;
            letter-spacing: 0.03em;
            color: var(--ink-faint);
            text-align: center;
            margin-top: 0.4rem;
        }

        .timeline .rail-day:first-child { margin-top: 0; }

        /* Selecting a message marks the rest from that agent. Every signal here is one that
           survives colour blindness: what does not match is dimmed, what does is outlined and
           made taller, and a sentence beside the rail says how many and whose. The tint stays,
           but nothing depends on it. */
        .timeline.focused .tick:not(.kin) { opacity: 0.15; }

        .timeline .tick.kin {
            opacity: 1;
            outline: 2px solid var(--ink);
            outline-offset: 1px;
        }

        li.turn.kin .bubble { border-left-width: 7px; }

        /* The message actually chosen, told apart from its kin. */
        li.turn:target .bubble {
            border-color: var(--ink-soft);
            box-shadow: 0 0 0 3px var(--quiet-wash);
        }

        .kin-note {
            margin: 0 0 0.4rem;
            font-size: 0.7rem;
            line-height: 1.35;
            color: var(--ink-soft);
            text-align: center;
        }

        .kin-note:empty { display: none; }

        header .build { margin-left: 0.8rem; font-size: 0.8rem; color: var(--ink-faint); white-space: nowrap; }

        /* Find within a conversation. */
        .find {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.6rem;
            background: var(--card);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
            padding: 0.6rem 0.8rem;
            margin: 0;
            min-width: 0;
        }

        .find label { flex: 1 1 100%; font-size: 0.85rem; }
        .find input { flex: 1 1 8rem; min-width: 0; }

        .found {
            flex: 1 1 100%;
            margin: 0;
            font-size: 0.78rem;
            color: var(--ink-soft);
        }

        .found:empty { display: none; }

        /* A message that matched, and the words in it. Outlined rather than only tinted, for
           the same reason the rest of this page is: a mark nobody can see is not a mark. */
        li.turn.hit .bubble {
            border-color: var(--ink-soft);
            box-shadow: 0 0 0 2px var(--quiet-wash);
        }

        mark[data-found] {
            background: var(--agent);
            color: var(--md-ext-on-slot);
            border-radius: var(--md-sys-shape-corner-extra-small);
            padding: 0 0.15em;
        }

        .timeline.searching .tick:not(.hit) { opacity: 0.12; }

        .timeline .tick.hit {
            opacity: 1;
            outline: 2px solid var(--ink);
            outline-offset: 1px;
        }

        /* The composer, pinned so it is reachable from anywhere in a long transcript. It is a
           form, and what it sends is a message into the conversation, from the person's seat. */
        .composer {
            position: sticky;
            bottom: 0;
            z-index: 2;
            display: block;
            margin: 1.5rem 0 0;
            padding: 0.85rem 1rem;
            background: var(--card);
            border: 1px solid var(--rule);
            border-bottom: none;
            border-radius: var(--radius) var(--radius) 0 0;
            box-shadow: var(--md-sys-elevation-2);
        }

        /* Hidden to read: the bar alone stays, saying who it would go to, with the button that brings the rest back. */
        .composer-bar { display: flex; align-items: center; gap: 0.8rem; margin: 0 0 0.6rem; }
        .composer-bar .composer-to { flex: 1 1 auto; min-width: 0; margin: 0; }
        .composer-toggle { flex: none; display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.15rem 0.7rem; font-size: 0.8rem; color: var(--ink-soft); background: none; border: 1px solid var(--rule); }
        .composer-toggle[hidden] { display: none; }
        .composer-toggle .icon { font-size: 1.1rem; }
        .composer-closed { padding-block: 0.4rem; }
        .composer-closed > .composer-bar { margin: 0; }
        .composer-closed > :not(.composer-bar) { display: none; }

        /* What is attached: a thumbnail, or a tile saying the kind of file, each with its name and a way to take it off. */
        .attachments { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 0.6rem; padding: 0; list-style: none; }
        .attachments:not(:has(.attachment)) { display: none; }
        .attachment { position: relative; width: 4.5rem; }
        .attachment-tile { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; object-fit: cover; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; color: var(--ink-soft); background: var(--quiet-wash); border: 1px solid var(--rule); border-radius: 8px; }
        .attachment-name { display: block; margin-top: 0.15rem; overflow: hidden; font-size: 0.68rem; color: var(--ink-faint); text-overflow: ellipsis; white-space: nowrap; }
        .attachment-remove { position: absolute; top: -0.4rem; right: -0.4rem; display: grid; place-items: center; width: 1.3rem; height: 1.3rem; padding: 0; color: var(--ink); background: var(--card); border: 1px solid var(--rule); border-radius: 50%; }
        .attachment-remove .icon { font-size: 0.9rem; }
        .attach-note { margin: 0 0 0.6rem; font-size: 0.8rem; color: var(--ink-soft); }
        .attach-note[hidden] { display: none; }
        form.dropping { outline: 2px dashed var(--accent); outline-offset: -4px; }
        /* The composer partial's holder lays out as if it were not there, so each page's own layout of the box holds. */
        .composer-box { display: contents; }
        /* The agents typing @@ offers, just above the box it was typed in; the frame's script places it. */
        .mention-list { position: absolute; margin: 0; padding: 0.25rem; list-style: none; max-height: 14rem; overflow: auto; background: var(--md-sys-color-surface-container); border: 0; border-radius: var(--md-sys-shape-corner-extra-small); box-shadow: var(--md-sys-elevation-2); z-index: 20; }
        .mention-list[hidden] { display: none; }
        .mention-list li { padding: 0.35rem 0.6rem; border-radius: 6px; cursor: pointer; overflow-wrap: anywhere; }
        .mention-list li[aria-selected="true"], .mention-list li:hover { background: var(--quiet-wash); }

        /* Keyboard focus and jumps stop short of the box rather than underneath it. A margin on everything but the box,
           never padding on the page: the browser keeps the caret clear of the page's padding as the person types, and the
           box is pinned inside that padding, so every keystroke scrolled the page a line and the box never got clear. */
        .page :not(.composer, .composer *) { scroll-margin-bottom: calc(var(--composer-h, 0px) + 1rem); }

        .composer-note {
            margin: 0 0 0.6rem;
            font-size: 0.85rem;
            line-height: 1.45;
            color: var(--ink-soft);
        }

        .composer-to {
            margin: 0 0 0.6rem;
            font-size: 0.8rem;
            color: var(--ink-soft);
            overflow-wrap: anywhere;
        }

        /* Who to talk to: one group per machine, the person's first. A name is the role alone, so a row
           is a box, a badge, a name and a state and does not wrap. */
        .recipients {
            background: var(--card);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
            padding: 0.9rem 1rem;
        }

        .recipients h2 {
            margin: 0 0 0.6rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--ink-faint);
        }

        .recipients ul { list-style: none; margin: 0; padding: 0; }
        .recipients .everyone { display: flex; gap: 0.4rem; align-items: center; font-size: 0.8rem; margin: 0 0 0.6rem; }

        .recipients summary {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            cursor: pointer;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.2rem 0;
        }

        .recipients .count { margin-left: auto; font-weight: 400; font-size: 0.72rem; color: var(--ink-faint); }

        /* A summary laid out as a row loses the browser's own marker, so nothing would say a heading folds. */
        .recipients summary .chev, .settings-tree summary .chev { flex: none; font-size: 1.05rem; vertical-align: baseline; }

        .recipients details > ul {
            margin: 0.2rem 0 0.5rem 0.55rem;
            padding-left: 0.6rem;
            border-left: 1px solid var(--rule);
            display: grid;
            gap: 0.5rem;
        }

        .recipients li.divider {
            font-size: 0.66rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--ink-faint);
        }

        .recipients li[class*="slot-"] {
            display: grid;
            grid-template-columns: auto auto 1.5rem minmax(0, 1fr) auto;
            grid-template-rows: auto auto;
            column-gap: 0.4rem;
            align-items: center;
        }

        .recipients li.not-in-it { grid-template-columns: auto 1.5rem minmax(0, 1fr) auto; }

        .recipients li .to-box { grid-row: 1 / span 2; }

        .recipients .who {
            grid-row: 1 / span 2;
            width: 1.5rem;
            height: 1.5rem;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 0.55rem;
            font-weight: 700;
            color: var(--md-ext-on-slot);
            background: var(--agent);
        }

        .recipients .mark { grid-row: 1 / span 2; font-size: 0.7rem; color: var(--agent); }
        .recipients .name { font-size: 0.82rem; font-weight: 600; overflow-wrap: anywhere; }
        .recipients .state { font-size: 0.72rem; color: var(--ink-faint); }
        .recipients li.subgroup > details > summary { font-weight: 500; font-size: 0.78rem; color: var(--ink-soft); }
        .recipients li.subgroup > details > ul { margin-left: 0.3rem; padding-left: 0.5rem; gap: 0.35rem; }
        .recipients .msgs { grid-column: -1; grid-row: 1 / span 2; font-size: 0.72rem; font-weight: 600; color: var(--ink-soft); background: var(--page); border: 1px solid var(--rule); border-radius: 999px; padding: 0 0.5rem; min-width: 1.4rem; text-align: center; }
        .reply-line { margin: 0.5rem 0 0; }
        .reply-to { cursor: pointer; border-radius: 999px; padding: 0.25rem 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--ink); background: none; border: 1px solid var(--accent); }
        .composer-replying { display: flex; align-items: center; gap: 0.8rem; margin: 0.4rem 0; padding: 0.4rem 0.8rem; border-left: 3px solid var(--accent); background: var(--quiet-wash); }
        .composer-replying[hidden] { display: none; }
        .bell { position: relative; }
        .bell > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.2rem; padding: 0.2rem 0.4rem; border-radius: 999px; color: var(--ink-soft); }
        .bell > summary::-webkit-details-marker { display: none; }
        .bell > summary:hover, .bell[open] > summary { color: var(--ink); background: var(--quiet-wash); }
        .bell .icon { font-size: 1.4rem; }
        .bell-list { position: absolute; right: 0; top: 100%; z-index: 30; width: min(26rem, 90vw); max-height: 70vh; overflow-y: auto; margin-top: 0.4rem; padding: 0.5rem 0.8rem; background: var(--card); border: 1px solid var(--rule); border-radius: var(--md-sys-shape-corner-extra-small); box-shadow: var(--md-sys-elevation-2); }
        .bell-list ul, .notices-all { list-style: none; margin: 0; padding: 0; }
        .notice { margin: 0; padding: 0.5rem 0; border-bottom: 1px solid var(--rule); font-size: 0.88rem; overflow-wrap: anywhere; }
        .notice:last-child { border-bottom: 0; }
        .notice p { margin: 0.2rem 0; }
        .notice-bad { border-left: 3px solid var(--alarm); padding-left: 0.6rem; }
        .notice-new { margin-left: 0.4rem; font-size: 0.75rem; font-weight: 600; color: var(--accent); }
        .bell-empty { margin: 0.4rem 0; color: var(--ink-soft); }
        .bell-all { display: block; padding-top: 0.5rem; font-weight: 600; font-size: 0.88rem; }
        .convo-head { position: relative; display: grid; gap: 0.4rem; min-width: 0; background: var(--card); border: 1px solid var(--rule); border-radius: 0.9rem; padding: 0.5rem 0.8rem; }
        .convo-frame { min-width: 0; }
        .convo-frame summary { cursor: pointer; list-style: none; display: flex; align-items: center; min-height: 2rem; }
        .convo-frame summary::-webkit-details-marker { display: none; }
        .convo-frame summary::before { content: "chevron_right"; content: "chevron_right" / ""; font-family: "Material Symbols Outlined"; margin-right: 0.5rem; font-size: 1.5rem; line-height: 1; color: var(--ink); transition: transform 0.15s; }
        .convo-frame[open] summary::before { transform: rotate(90deg); }
        .convo-frame h1 { margin: 0; flex: 1; min-width: 0; font-size: 1.15rem; overflow-wrap: anywhere; }
        .convo-frame .item-title { margin: 0.5rem 0 0; font-size: 1rem; font-style: normal; color: var(--ink); }
        .convo-frame .as-of { margin: 0.4rem 0 0.2rem; }
        .convo-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
        #panel-close { margin-left: auto; }
        #panel-close[hidden] { display: none; }
        /* The panel's tools are tonal buttons: lower emphasis than Send, which is the page's main action. A <summary> or a
           link drawn as one takes the same shape. */
        .convo-actions .file-button { --md-btn-content: var(--md-sys-color-on-secondary-container); display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--md-sys-shape-corner-full); font: var(--md-sys-typescale-label-large); text-decoration: none; color: var(--md-sys-color-on-secondary-container); background-color: var(--md-sys-color-secondary-container); border: 0; cursor: pointer; list-style: none; }
        .convo-actions .file-button::-webkit-details-marker { display: none; }
        .convo-actions .file-button:hover { background-image: linear-gradient(color-mix(in srgb, var(--md-sys-color-on-secondary-container) var(--md-sys-state-hover), transparent) 0 0); }
        .convo-actions .file-button .icon { font-size: 1.125rem; }
        /* Offered when a message arrived further down than following may carry the page (see the script in the conversation
           page). Centred over the page rather than the window, clear of the composer pinned to the bottom. */
        .new-below { position: fixed; z-index: 25; left: calc(var(--rail-w) + (100vw - var(--rail-w)) / 2); bottom: calc(var(--composer-h, 9rem) + 1rem); transform: translateX(-50%); color: var(--on-accent); background: var(--accent); box-shadow: var(--md-sys-elevation-3); }
        .new-below:active { transform: translateX(-50%) scale(0.98); }
        .new-below[hidden] { display: none; }
        .export-menu { position: relative; }
        .export-list { position: absolute; left: 0; top: calc(100% + 0.3rem); z-index: 5; display: flex; flex-direction: column; min-width: 9rem; background: var(--card); border: 1px solid var(--rule); border-radius: var(--md-sys-shape-corner-extra-small); box-shadow: var(--md-sys-elevation-2); overflow: hidden; }
        .export-list a { padding: 0.5rem 0.9rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
        .export-list a:hover { background: var(--rule); }

        /* Filtering the transcript. Hidden rather than removed, so following can replace the transcript and the
           choice is simply applied again. */
        .filtered-out { display: none !important; }

        .filter {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.4rem 1rem;
            background: var(--card);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
            padding: 0.6rem 0.8rem;
            margin: 0;
            font-size: 0.85rem;
        }

        .filter[hidden] { display: none; }
        #filter-clear[hidden] { display: none; }
        .filter-title { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-faint); }
        .only-me { display: inline-flex; align-items: center; gap: 0.4rem; }

        .pick { position: relative; }

        /* Looks like the combo box it stands in for: the same field, the same chevron, turning when it opens. */
        .pick summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            list-style: none;
            cursor: pointer;
            background: var(--page);
            border: 1px solid var(--rule);
            border-radius: 999px;
            padding: 0.3rem 0.5rem 0.3rem 0.9rem;
            min-width: 8rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .pick summary::-webkit-details-marker { display: none; }
        .pick summary:hover { border-color: var(--ink-faint); }
        .pick[open] summary { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }

        .pick summary::after {
            font-family: "Material Symbols Outlined";
            font-size: 1.4rem;
            line-height: 1;
            color: var(--ink-faint);
            content: "expand_more";
            content: "expand_more" / "";
            transition: transform 0.15s;
        }

        .pick[open] summary::after { transform: rotate(180deg); }

        .pick .menu {
            position: absolute;
            z-index: 5;
            top: calc(100% + 4px);
            left: 0;
            min-width: 100%;
            max-height: 16rem;
            overflow-y: auto;
            display: grid;
            gap: 0.3rem;
            background: var(--card);
            border: 1px solid var(--rule);
            border-radius: 14px;
            padding: 0.6rem 0.8rem;
            box-shadow: var(--md-sys-elevation-2);
            white-space: nowrap;
        }

        .pick .menu label { display: flex; align-items: center; gap: 0.6rem; padding: 0.15rem 0; cursor: pointer; color: var(--ink); }

        .composer textarea { width: 100%; min-height: 4.5rem; max-height: 40vh; }

        .composer-send {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: 0.6rem;
            margin-top: 0.6rem;
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

        ul.sent {
            list-style: none;
            margin: 0 0 0.6rem;
            padding: 0;
            display: grid;
            gap: 0.3rem;
            font-size: 0.82rem;
        }

        ul.sent > li {
            padding: 0.4rem 0.6rem;
            background: var(--quiet-wash);
            border-radius: 6px;
        }

        /* A send that went as asked: an icon in the composer's bar, opening above the box rather than pushing it about. */
        .sent-info { flex: none; }
        .sent-info > summary { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; list-style: none; cursor: pointer; border-radius: 50%; color: var(--ink-faint); }
        .sent-info > summary::-webkit-details-marker { display: none; }
        .sent-info > summary:hover, .sent-info[open] > summary { color: var(--ink); background: var(--quiet-wash); }
        .sent-info > summary .icon { font-size: 1.2rem; }
        .sent-info > ul.sent { position: absolute; left: 0; right: 0; bottom: 100%; z-index: 20; margin: 0 0 0.4rem; padding: 0.5rem; background: var(--card); border: 1px solid var(--rule); border-radius: var(--md-sys-shape-corner-extra-small); box-shadow: var(--md-sys-elevation-2); overflow-wrap: anywhere; }

        /* ---- Material 3 components --------------------------------------------------------------------------------------
           Last on purpose: each rule here takes a control the console drew its own way, above, and gives it the Material 3
           form named in specs/035-material-3-web-ui/audit.md. Labels are in sentence case and on the type scale. */

        /* Labels and headers: sentence case, label-medium or title-small, never letter-spaced capitals. */
        th, .dgrid-head, .grid-head, .dgrid-detail .facts dt, .filter-title, .recipients h2, .recipients li.divider,
        .because span, .field span, ol.points .label, ol.points .verdict, li.day, .tag, .rail-day {
            text-transform: none;
            letter-spacing: normal;
        }
        th, .dgrid-head, .grid-head { font: var(--md-sys-typescale-title-small); color: var(--md-sys-color-on-surface-variant); background: var(--md-sys-color-surface-container); }
        .dgrid-detail .facts dt, .filter-title, .recipients h2, .because span, .field span { font: var(--md-sys-typescale-label-medium); color: var(--md-sys-color-on-surface-variant); }
        .recipients h2 { font: var(--md-sys-typescale-title-small); color: var(--md-sys-color-on-surface); }

        /* Tables and lists: rows on the surface, a hover state layer on a row that opens. */
        table { border-radius: var(--md-sys-shape-corner-medium); border-color: var(--md-sys-color-outline-variant); background: var(--md-ext-color-card); }
        th, td { padding: 0.75rem 1rem; }
        details.dgrid-row > summary:hover, .grid-row > summary:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) var(--md-sys-state-hover), transparent); }
        details.dgrid-row[open] > summary, details.dgrid-row[open] > summary:hover {
            background: linear-gradient(color-mix(in srgb, var(--md-sys-color-on-surface) var(--md-sys-state-hover), transparent) 0 0), var(--card);
        }
        .dgrid { border-radius: var(--md-sys-shape-corner-large); }

        /* Cards: outlined, at the medium corner, on the card surface. */
        .letter, .find, .filter, .recipients, .convo-head, .convo-links, .waiting-on-you, .waiting-elsewhere, .timeline,
        .settings-section fieldset, .default-expander, .act-cards li, .move-to, .grid, .panel-closed .panel-strip {
            border-radius: var(--md-sys-shape-corner-medium);
            border-color: var(--md-sys-color-outline-variant);
        }
        .act-cards li.costly { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); }
        .act-cards li.costly a, .act-cards li.costly p { color: inherit; }

        /* Transcript entries: outlined cards with the agent's colour on the leading edge; the avatar is the initials. */
        .bubble { border-radius: var(--md-sys-shape-corner-extra-small) var(--md-sys-shape-corner-medium) var(--md-sys-shape-corner-medium) var(--md-sys-shape-corner-medium); border-color: var(--md-sys-color-outline-variant); padding: 0.75rem 1rem; }
        .attribution { font: var(--md-sys-typescale-title-small); }
        .attribution strong { font-weight: 500; letter-spacing: normal; }
        .attribution .stamp, .meta, .as-of, .waiting-where, .found, .kin-note { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-on-surface-variant); }
        .said { font: var(--md-sys-typescale-body-large); }
        .who { font: var(--md-sys-typescale-label-medium); }

        /* Chips. An input chip (removable, as the default agents are) and assist chips for facts the console states. */
        .chip { min-height: 2rem; gap: 0.5rem; padding: 0 0.25rem 0 0.75rem; font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-surface-variant); background: transparent; border: 1px solid var(--md-sys-color-outline); border-radius: var(--md-sys-shape-corner-small); }
        .chip-x { min-height: 0; width: 1.5rem; height: 1.5rem; padding: 0; border-radius: 50%; color: var(--md-sys-color-on-surface-variant); background: transparent; }
        .chip-x:hover, .chip-x:focus-visible { color: var(--md-sys-color-on-surface); background: color-mix(in srgb, var(--md-sys-color-on-surface) var(--md-sys-state-hover), transparent); }

        /* Who a message goes to, one input chip each, on the composer's To line. */
        .composer-to .to-chip { margin: 0.1rem 0.25rem 0.1rem 0; min-height: 1.75rem; }

        /* A placed file, in the transcript where it was placed and in Media (SPEC.md 9.5). The browser scales the
           original; nothing here makes a smaller copy. */
        .transcript li.placed { list-style: none; margin: 0.5rem 0 0.5rem 2.75rem; }
        .placed-card { margin: 0; display: inline-flex; flex-direction: column; gap: 0.35rem; max-width: min(100%, 22rem); }
        .placed-card .thumb { display: block; border-radius: var(--md-sys-shape-corner-medium); overflow: hidden; border: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container); }
        .placed-card .thumb img { display: block; max-width: 100%; max-height: 14rem; object-fit: contain; }
        .placed-card .thumb:focus-visible { outline: 2px solid var(--md-sys-color-primary); outline-offset: 2px; }
        .placed-card figcaption { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-on-surface-variant); overflow-wrap: anywhere; }
        .thumb-tile, .file-tile { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0; padding: 0.6rem 0.8rem; border-radius: var(--md-sys-shape-corner-medium); border: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low); color: var(--md-sys-color-on-surface); font: var(--md-sys-typescale-body-medium); overflow-wrap: anywhere; }
        .file-tile { text-decoration: none; }
        .media-grid { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 1rem; }
        .media-grid .placed-card { max-width: 100%; }
        .media-grid .thumb img { width: 100%; height: 10rem; object-fit: cover; }
        .media-list { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: 0.75rem; }

        /* The full view of an image, over the page. */
        .viewer { max-width: min(96vw, 80rem); max-height: 94vh; padding: 0; border: 0; border-radius: var(--md-sys-shape-corner-extra-large); background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); }
        .viewer::backdrop { background: var(--md-ext-scrim); }
        .viewer-bar { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.5rem 0.5rem 1rem; }
        .viewer-caption { flex: 1 1 auto; margin: 0; font: var(--md-sys-typescale-body-medium); overflow-wrap: anywhere; }
        .viewer img { display: block; max-width: min(96vw, 80rem); max-height: calc(94vh - 3.5rem); margin: 0 auto; object-fit: contain; }
        ol.points .verdict, .tag, .msgs, .moved-note, .moved-notes li, li.day {
            display: inline-flex;
            align-items: center;
            min-height: 1.5rem;
            padding: 0 0.5rem;
            font: var(--md-sys-typescale-label-medium);
            border: 1px solid var(--md-sys-color-outline-variant);
            border-radius: var(--md-sys-shape-corner-small);
        }
        ol.points .verdict { color: var(--md-sys-color-on-surface-variant); }
        .tag { color: var(--md-sys-color-error); border-color: var(--md-sys-color-error); }
        .tag.open { color: var(--md-sys-color-primary); border-color: var(--md-sys-color-primary); }
        .moved-note, .moved-notes li, li.day { color: var(--md-sys-color-on-surface-variant); background: var(--md-sys-color-surface-container-low); }
        .moved-note, .moved-notes li { padding: 0.25rem 0.75rem; }
        ol.points .label { font: var(--md-sys-typescale-label-medium); }

        /* Menus: the surface container, extra-small corner, level 2, 48px items. */
        .pick .menu, .bell-list, .export-list, .sent-info > ul.sent, .mention-list {
            background: var(--md-sys-color-surface-container);
            border: 0;
            border-radius: var(--md-sys-shape-corner-extra-small);
            box-shadow: var(--md-sys-elevation-2);
        }
        .pick .menu { padding: 0.5rem 0; gap: 0; }
        .pick .menu label { min-height: 3rem; padding: 0 1rem; gap: 0.75rem; font: var(--md-sys-typescale-label-large); }
        .pick .menu label:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) var(--md-sys-state-hover), transparent); }
        .export-list { padding: 0.5rem 0; }
        .export-list a { display: flex; align-items: center; min-height: 3rem; padding: 0 1rem; font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-surface); }
        .export-list a:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) var(--md-sys-state-hover), transparent); }
        .bell-list { padding: 0.5rem 1rem; }
        .mention-list li { min-height: 3rem; display: flex; align-items: center; padding: 0 1rem; border-radius: 0; }

        /* The agent filter looks like the outlined select it stands in for. */
        .pick summary { min-height: 2.5rem; border: 1px solid var(--md-sys-color-outline); border-radius: var(--md-sys-shape-corner-extra-small); background: transparent; padding: 0 0.5rem 0 1rem; font: var(--md-sys-typescale-body-large); }
        .pick summary:hover { border-color: var(--md-sys-color-on-surface); }
        .pick[open] summary { border-color: var(--md-sys-color-primary); box-shadow: inset 0 0 0 1px var(--md-sys-color-primary); }

        /* Dialogs: surface-container-high at the extra-large corner, 24px in, a headline, actions to the right. */
        .default-dialog, #new-conversation-dialog, dialog {
            border: 0;
            border-radius: var(--md-sys-shape-corner-extra-large);
            background: var(--md-sys-color-surface-container-high);
            color: var(--md-sys-color-on-surface);
            padding: 1.5rem;
            box-shadow: var(--md-sys-elevation-3);
        }
        dialog::backdrop { background: var(--md-ext-scrim); }
        .default-dialog h3, dialog h2, dialog h3 { font: var(--md-sys-typescale-headline-small); margin: 0 0 1rem; }
        .dialog-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin: 1.5rem 0 0; }

        /* Banners: a message that stays, with its colour role, at the medium corner. */
        .unreachable { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); border: 0; border-radius: var(--md-sys-shape-corner-medium); padding: 1rem; }
        .unreachable a { color: inherit; }
        .file-problems-banner { background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); border: 0; border-left: 4px solid var(--md-sys-color-error); border-radius: var(--md-sys-shape-corner-medium); padding: 0.75rem 1rem; }
        ul.sent > li { border-radius: var(--md-sys-shape-corner-small); background: var(--md-sys-color-surface-container-high); }

        /* Small buttons that sit inside text or on another control. */
        .thread-focus { min-height: 0; padding: 0; border: 0; border-radius: var(--md-sys-shape-corner-extra-small); background: none; color: var(--md-sys-color-primary); font: inherit; text-decoration: underline; }
        .thread-focus:hover { background: none; text-decoration-thickness: 2px; }
        .reply-to { --md-btn-container: transparent; --md-btn-content: var(--md-sys-color-primary); --md-btn-outline: var(--md-sys-color-outline); min-height: 2rem; padding: 0 1rem; font: var(--md-sys-typescale-label-large); }
        .composer-toggle { min-height: 2rem; padding: 0 0.75rem; font: var(--md-sys-typescale-label-large); }
        .attachment-remove { --md-btn-container: var(--md-sys-color-surface-container-highest); --md-btn-content: var(--md-sys-color-on-surface); --md-btn-outline: var(--md-sys-color-outline-variant); min-height: 0; width: 1.5rem; height: 1.5rem; padding: 0; }
        .attachment-tile { border-radius: var(--md-sys-shape-corner-small); background: var(--md-sys-color-surface-container-high); border-color: var(--md-sys-color-outline-variant); font: var(--md-sys-typescale-label-large); }
        .sent-info > summary { width: 2.5rem; height: 2.5rem; }

        /* An extended FAB for the one floating action: primary container, the large corner, level 3. */
        .new-below { --md-btn-container: var(--md-sys-color-primary-container); --md-btn-content: var(--md-sys-color-on-primary-container); min-height: 3.5rem; padding: 0 1.25rem; border-radius: var(--md-sys-shape-corner-large); color: var(--md-sys-color-on-primary-container); background-color: var(--md-sys-color-primary-container); box-shadow: var(--md-sys-elevation-3); }

        /* The create card's add mark is a small FAB. */
        .view-create > summary { min-height: 3.5rem; font: var(--md-sys-typescale-title-medium); }
        .view-create > summary::before { width: 2.5rem; height: 2.5rem; border-radius: var(--md-sys-shape-corner-medium); background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); font-size: 1.5rem; }

        /* The composer is a raised surface pinned to the bottom. */
        .composer { background: var(--md-sys-color-surface-container-low); border-color: var(--md-sys-color-outline-variant); border-radius: var(--md-sys-shape-corner-large) var(--md-sys-shape-corner-large) 0 0; }
        .composer-replying { border-left-color: var(--md-sys-color-primary); background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); border-radius: var(--md-sys-shape-corner-small); }

        /* The minimap's ticks take focus like anything else. */
        .timeline .tick { border-radius: 2px; }
        .timeline .tick:focus-visible { outline: 3px solid var(--md-sys-color-secondary); outline-offset: 1px; }

        /* Forms are cards; their labels are body-medium in on-surface-variant above the field. */
        form { border-color: var(--md-sys-color-outline-variant); border-radius: var(--md-sys-shape-corner-medium); padding: 1rem; }
        label { font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-on-surface-variant); }
        .lede { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-on-surface-variant); }

        /* The frame's bell is a standard icon button. */
        .bell > summary { min-width: 2.5rem; min-height: 2.5rem; justify-content: center; border-radius: var(--md-sys-shape-corner-full); }
        .seat-who { font: var(--md-sys-typescale-label-large); }
        header .build { font: var(--md-sys-typescale-body-small); }

        /* Compact density, chosen on the Settings page: Material 3's density step of 8px off fields, buttons, menu rows and
           table rows, and a smaller gap. Targets stay at least 32px, so nothing becomes too small to press. */
        :root[data-density="compact"] { --gap: 1rem; }
        :root[data-density="compact"] input:not([type="checkbox"], [type="radio"], [type="range"], [type="hidden"], [type="file"]),
        :root[data-density="compact"] textarea, :root[data-density="compact"] select { min-height: 2.5rem; padding: 0.4375rem 0.875rem; }
        :root[data-density="compact"] button, :root[data-density="compact"] .button,
        :root[data-density="compact"] .convo-actions .file-button { min-height: 2rem; }
        :root[data-density="compact"] th, :root[data-density="compact"] td { padding: 0.5rem 0.75rem; }
        :root[data-density="compact"] option, :root[data-density="compact"] .pick .menu label,
        :root[data-density="compact"] .export-list a, :root[data-density="compact"] .mention-list li { min-height: 2.5rem; }

        /* The Parley-wide Settings page: each choice a group of radio buttons, each one a row with its words. */
        .appearance { display: block; max-width: 40rem; }
        .settings-section fieldset.choice { border: 0; background: none; padding: 0; margin: 0 0 1rem; }
        .choice legend { font: var(--md-sys-typescale-title-small); color: var(--md-sys-color-on-surface); padding: 0; margin-bottom: 0.5rem; }
        .choice label { display: flex; align-items: center; gap: 0.75rem; min-height: 2.5rem; color: var(--md-sys-color-on-surface); font: var(--md-sys-typescale-body-large); cursor: pointer; }
        .about dt { font: var(--md-sys-typescale-title-small); color: var(--md-sys-color-on-surface); margin-top: 0.75rem; }
        .about dd { margin: 0.25rem 0 0; font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-on-surface-variant); overflow-wrap: anywhere; }

        /* ---- Sizes -------------------------------------------------------------

           One set of breakpoints, so every column folds at the same widths.

           The shell takes the whole window, and so does a bubble: the conversation runs
           from the panel to the rail, however wide the window. Below 75rem the navigation is a
           rail; below 60rem the three columns stop fitting and the page becomes one;
           below 40rem it is a phone. */

        @@media (min-width: 90rem) {
            .conversation { gap: 2rem; }
        }

        @@media (max-width: 60rem) {
            .convo-page, .conversation { grid-template-columns: minmax(0, 1fr); }
            .convo-page.panel-closed { grid-template-columns: 3rem minmax(0, 1fr); }

            /* Open, the panel sits above the conversation. Closed, its strip stays beside it, in reach as the page scrolls. */
            .convo-page:not(.panel-closed) .convo-panel { position: static; max-height: none; }
            .convo-page:not(.panel-closed) .side { overflow-y: visible; }

            /* Horizontal above the conversation, where a vertical rail beside it
               would have nowhere to be. */
            .minimap { position: static; order: -1; }

            .timeline {
                flex-direction: row;
                flex-wrap: wrap;
                align-items: center;
            }

            .timeline .tick { width: 0.5rem; height: 1.1rem; }
            .timeline .tick.ghosted { width: 0.85rem; }
            .timeline .rail-day { margin: 0 0.2rem; }

            /* The health page carries six columns and there is no longer width for
               them. Scrolled inside its own box rather than squeezed, because a
               figure shrunk to fit is a figure nobody reads. */
            /* Positioned, so text kept for a screen reader inside it is held in the scroller rather than widening the page. */
            table { display: block; overflow-x: auto; position: relative; }
        }

        @@media (max-width: 40rem) {
            body { font-size: 14px; }

            /* Kept as one row here. A sticky frame that stacks costs
               five rem of a phone screen on every page, and the frame is worth having only for
               as long as it costs less than what it is covering. The word "console" goes
               instead: the mark and the page say it. */
            :root { --frame: 3.1rem; }
            header { gap: 0.6rem; padding: 0.6rem 0 0.55rem; }
            .brand span { display: none; }

            h1 { font-size: 1.35rem; }
            th, td { padding: 0.5rem 0.6rem; }

            li.turn { gap: 0.5rem; }
            .bubble { padding: 0.6rem 0.75rem; }
            li.turn > .who { width: 1.8rem; height: 1.8rem; font-size: 0.62rem; }
            form { padding: 0.7rem 0.8rem; }
            input { flex: 1 1 8rem; min-width: 0; }
        }

        /* Nothing may run off the side at 320px, which is the narrowest thing
           anybody will hold this on. */
        @@media (max-width: 26rem) {
            /* The mark alone. At this width the frame is competing with the page for the only
               thing in short supply, and the word "Parley" is in the title bar anyway. */
            .brand { font-size: 0; gap: 0; }
            .brand img { width: 1.7rem; height: 1.7rem; }

            .attribution .stamp { margin-left: 0; }
            nav { gap: 0.6rem; }
            ol.points > li { padding-left: 0.5rem; }
        }

    </style>
    @* List views refresh themselves by reloading; a transcript never reloads. It follows its
       conversation instead, replacing only the region that changed and keeping the message a reader
       is looking at where it was -- a reload would throw away their place, what they had typed into
       the composer, and what they were searching for. Following is built so that it does not
       move a reader mid-sentence. *@
    @if (ViewData["Refresh"] is string seconds)
    {
        // The same page, marked as the timer's reload, so it does not count as somebody at the console.
        var query = Microsoft.AspNetCore.Http.QueryString.Create(
            Context.Request.Query
                .Where(pair => pair.Key != PersonSeats.Reloaded)
                .SelectMany(pair => pair.Value.Select(value => new KeyValuePair<string, string?>(pair.Key, value)))
                .Append(new KeyValuePair<string, string?>(PersonSeats.Reloaded, "1")));
        @* The reload waits while a dialog or an opened "create" card is open: it would close either under whoever is typing in it. Without script
           the page reloads on the timer as before. *@
        var target = $"{Context.Request.Path}{query}";
        <noscript><meta http-equiv="refresh" content="@($"{seconds};url={target}")" /></noscript>
        <meta name="parley-reload" content="@seconds" data-url="@target" />
        <script>
            (function () {
                var m = document.querySelector("meta[name=parley-reload]");
                var every = Number(m.content) * 1000;
                (function tick() {
                    setTimeout(function () {
                        if (document.querySelector("dialog[open], details.view-create[open]")) { tick(); } else { location.replace(m.getAttribute("data-url")); }
                    }, every);
                })();
            })();
        </script>
    }
</head>
<body class="@(ViewData["Grid"] is true ? "grid-page" : null) @(Parley.Web.ConsoleHost.Embedded(Context) ? "embed" : null)">
    @if (Parley.Web.ConsoleHost.Embedded(Context))
    {
        @* Inside the roadmap's frame, a link to any other page of the console opens in the whole window: every other page
           refuses to be framed, so followed in the frame it would draw nothing. A link that names its target is left
           alone, so the page's own in-page links say `_self` (FragmentLinksStayInTheFrameTests). Forms still post in
           the frame. *@
        <script data-embed-links>
            document.addEventListener("click", function (e) {
                var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;

                if (a && !a.target && !a.hasAttribute("download") && a.origin === window.location.origin) { a.target = "_top"; }
            }, true);
        </script>
    }
    <script>
        try { if (localStorage.getItem("parley.nav") === "collapsed") { document.documentElement.setAttribute("data-nav", "collapsed"); } } catch (e) { }
    </script>
    <a class="skip" href="#main" target="_self">Skip to content</a>
    @{
        var path = Context.Request.Path.Value ?? "/";
        var agentsView = path == "/" && Context.Request.Query["tab"] == "agents";
        var project = ViewData["Project"] as string ?? Context.Request.Query["project"].ToString();
        var onAgentsTab = agentsView && project.Length == 0;
        var q = Uri.EscapeDataString(project);
        var rail = new List<(string Href, string Label, string Icon, bool Current)>
        {
            ("/", "Projects", "grid_view", path == "/" && !agentsView),
            ("/?tab=agents", "All Agents", "group", onAgentsTab),
            ("/Inbox", "Inbox", "inbox", path.StartsWith("/Inbox", StringComparison.Ordinal)),
        };
        // At the foot with the toggle, in both states, so a project's own items never sit between it and the rest.
        var parleySettings = ("/Settings", "Settings", "settings", path == "/Settings");
        var inProjectRail = new List<(string Href, string Label, string Icon, bool Current)>();

        if (project.Length > 0)
        {
            inProjectRail =
            [
                ($"/Projects/Agents?project={q}", "Conversations", "chat_bubble", path == "/Projects/Agents" || path.StartsWith("/Conversations", StringComparison.Ordinal)),
                // One agent's page, its ownership and registering one are all reached from the agents list, so they light it.
                ($"/?tab=agents&project={q}", "Agents", "group", agentsView || path is "/Projects/Agent" or "/Projects/Ownership" or "/Projects/Register" or "/Projects/Enrol"),
                ($"/Roadmaps?project={q}", "Roadmaps", "map", path.StartsWith("/Roadmaps", StringComparison.Ordinal)),
                ($"/Projects/Files?project={q}", "Files", "description", path is "/Projects/Files" or "/Projects/FileProblems"),
                ($"/Projects/Health?project={q}", "Health", "monitor_heart", path == "/Projects/Health"),
                ($"/Projects/Settings?project={q}", "Settings", "tune", path == "/Projects/Settings"),
            ];
        }
    }
    <aside class="rail" id="rail" aria-label="Navigation">
        <a class="brand" href="/">
            @* Decorative: the word beside it says the same thing, so a reader who cannot see
               the image loses nothing and a screen reader is not told it twice. *@
            <img src="/brand/icon.png" alt="" width="128" height="125" />
            <span class="rail-label">Parley <span>console</span></span>
        </a>
        <nav aria-label="Sections">
            @foreach (var item in rail)
            {
                <a href="@item.Href" title="@item.Label" aria-current="@(item.Current ? "page" : null)">
                    <span class="icon" aria-hidden="true">@item.Icon</span>
                    <span class="rail-label">@item.Label</span>
                    @if (item.Label == "Inbox" && waiting is { Certain: true, Waiting: > 0 })
                    {
                        <span class="seat-waiting">@waiting.Waiting<span class="visually-hidden"> messages waiting for you</span></span>
                    }
                    else if (item.Label == "Inbox" && deferred)
                    {
                        <span class="seat-waiting" data-inbox-badge hidden></span>
                    }
                </a>
            }
            @if (inProjectRail.Count > 0)
            {
                <p class="rail-heading">@project</p>
                @foreach (var item in inProjectRail)
                {
                    <a href="@item.Href" title="@item.Label" aria-current="@(item.Current ? "page" : null)">
                        <span class="icon" aria-hidden="true">@item.Icon</span>
                        <span class="rail-label">@item.Label</span>
                    </a>
                }
            }
        </nav>
        <nav class="rail-foot" aria-label="Console settings">
            <a href="@parleySettings.Item1" title="@parleySettings.Item2" aria-current="@(parleySettings.Item4 ? "page" : null)">
                <span class="icon" aria-hidden="true">@parleySettings.Item3</span>
                <span class="rail-label">@parleySettings.Item2</span>
            </a>
        </nav>
        <button type="button" class="rail-toggle" id="rail-toggle" aria-controls="rail" aria-expanded="true">
            <span class="icon" aria-hidden="true">chevron_left</span>
            <span class="rail-label">Collapse</span>
        </button>
    </aside>
    <div class="page">
    <header>
        @if ((ViewData["Project"] as string ?? Context.Request.Query["project"].ToString()) is { Length: > 0 } inProject)
        {
            @* Where in the deployment the page is, on every page, so a conversation is never without its project. *@
            <a class="crumb" href="/Projects/Agents?project=@Uri.EscapeDataString(inProject)" title="This project">@inProject</a>
        }
        @* Which build is running, small and out of the way: it is how a person tells an install has taken. *@
        <span class="build" title="The web console build">parley-web-ui @Parley.Web.WebBuild.Version</span>
        <nav aria-label="Console">
            @{
                var unread = Notices.Unread();
                var recent = Notices.Latest(8);
                var bellLabel = unread > 0 ? $"Notifications, {unread} new" : "Notifications";
            }
            @* What the console told you after you sent something, kept so it can be read again. Opens with no script. *@
            <details class="bell">
                <summary title="Notifications" aria-label="@bellLabel">
                    <span class="icon" aria-hidden="true">notifications</span>
                    @if (unread > 0)
                    {
                        <span class="seat-waiting">@unread</span>
                    }
                </summary>
                <div class="bell-list">
                    @if (recent.Count == 0)
                    {
                        <p class="bell-empty">Nothing yet.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var note in recent)
                            {
                                <li class="@(note.Good ? "notice" : "notice notice-bad")">
                                    <strong>@note.Source</strong> @note.Text
                                    @if (note.Conversation is { Length: > 0 } talk)
                                    {
                                        <a href="/Conversations/Detail?project=@Uri.EscapeDataString(note.Project)&amp;id=@Uri.EscapeDataString(talk)">Open @talk</a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    <a class="bell-all" href="/Notifications">See all notifications</a>
                </div>
            </details>
            @if (here.Count > 0)
            {
                @* The count goes to the inbox, where what is waiting can be collected. There is no Leave
                   beside it: the seat is the broker's and is never given back, and closing the console is how a
                   person stops being here. *@
                <a class="seat-who" href="/Inbox" title="Your messages">
                    <span class="seat-dot" aria-hidden="true"></span>@here[0].Seat.Person
                    @if (waiting is { Certain: true, Waiting: > 0 })
                    {
                        <span class="seat-waiting">@waiting.Waiting<span class="visually-hidden">
                            messages waiting for you</span></span>
                    }
                </a>
            }
            else
            {
                @* No broker answered, or none has a seat for a person. Nothing to take and nothing to type: the count,
                   if any could be read, still says there is something to come back for. *@
                <a class="seat-who" href="/Inbox" title="Your messages">
                    not connected
                    @if (waiting is { Certain: true, Waiting: > 0 })
                    {
                        <span class="seat-waiting">@waiting.Waiting<span class="visually-hidden">
                            messages waiting for you</span></span>
                    }
                </a>
            }
        </nav>
    </header>
    <main id="main">

        @* Said until the person dismisses each one, because only the person decides what becomes of a quarantined file.
           The project's name is somebody's text and Razor encodes it like everything else. *@
        @if (!embedded)
        {
            <p class="file-problems-banner" role="status" data-tidying hidden="@(tidying.Count == 0)">@string.Join(" ", tidying.Select(PersonSeats.TidyingSays))</p>
        }

        @foreach (var (problemProject, problemCount) in problems)
        {
            <p class="file-problems-banner">
                <a href="@Parley.Web.FileProblemBanner.Page?project=@Uri.EscapeDataString(problemProject)">@Parley.Client.Files.FileProblemSaid.Says(problemCount) in @problemProject. See them.</a>
            </p>
        }

        @if (ViewData["AsOf"] is string asOf && ViewData["Grid"] is not true && ViewData["AsOfInTitle"] is not true)
        {
            <p class="as-of" role="status">As of @asOf.</p>
        }
        @RenderBody()
    </main>
    </div>
    <script>
        // --frame is what the sticky frame occupies, and three other things are positioned
        // against it: the roster, the minimap, and where an anchor lands. A constant is a guess,
        // and it is wrong the moment the frame wraps to two lines -- which it does on a narrow
        // screen, and would again the next time anything is added to the nav. Nothing would
        // report it: the roster would simply sit under the header, and a tick would scroll its
        // message out of sight behind it.
        //
        // Measured, so the number cannot drift from the thing it describes. The value in the
        // stylesheet stands until this runs and is what a reader without scripts keeps, which is
        // why it is a reasonable figure rather than a placeholder.
        (function () {
            var frame = document.querySelector('header');

            if (!frame || !window.ResizeObserver) {
                return;
            }

            var apply = function () {
                document.documentElement.style.setProperty(
                    '--frame', frame.getBoundingClientRect().height + 'px');
            };

            new ResizeObserver(apply).observe(frame);
            apply();
        })();

        // **A field whose rule can be applied applies it, rather than refusing after the fact.**
        // A rule applied after the form is sent loses the words the person typed, so it is
        // applied as they type.
        //
        // Every rule here is written once, in C#, and reaches this page as the attributes a field
        // carries: `data-correct` is the character class `ConversationName.Correct` keeps, and
        // `data-lower` says the rule folds case, as a role's grammar does. So the
        // console and the terminal cannot come to hold two spellings of one rule -- and the
        // `pattern` attribute beside them, from the same constants, is what a browser with no
        // scripts enforces.
        //
        // Progressive enhancement, like everything else here: without scripts the field keeps
        // `pattern` and `maxlength`, the browser refuses the form, and the server refuses it
        // again in its own words. This only moves the refusal to the keystroke.
        (function () {
            var fields = document.querySelectorAll('[data-correct]');

            // **Character by character, because the obvious two-line version disagrees with the
            // C# in one case.** Replacing every run of whitespace first and
            // then dropping what is left over turns `1.2 / notes` into `1.2--notes`, where the
            // rule -- which walks the characters once and only emits a hyphen for a run of spaces
            // it has not already emitted one for -- gives `1.2-notes`. Two surfaces offering
            // different names for the same typing is exactly what one shared rule is for.
            var correct = function (field, text) {
                var keep = new RegExp('^' + field.getAttribute('data-correct') + '$');
                var lower = field.hasAttribute('data-lower');
                var made = '';
                var wasSpace = false;

                for (var at = 0; at < text.length; at++) {
                    var character = lower ? text[at].toLowerCase() : text[at];

                    if (keep.test(character)) {
                        made += character;
                        wasSpace = false;
                    } else if (/\s/.test(text[at])) {
                        // A space becomes the separator the rule allows rather than being
                        // dropped: `tell everybody test` is a name somebody can read back, and
                        // `telleverybodytest` is not.
                        if (!wasSpace) {
                            made += '-';
                        }

                        wasSpace = true;
                    }
                }

                return made;
            };

            Array.prototype.forEach.call(fields, function (field) {
                var note = document.getElementById(field.id + '-corrected');

                field.addEventListener('input', function () {
                    var was = field.value;
                    var now = correct(field, was);

                    if (now === was) {
                        // The note stays while the corrected text does. Clearing it on the next
                        // keystroke leaves somebody who typed a capital believing they typed
                        // what the field is now showing.
                        if (note && was.length === 0) {
                            note.hidden = true;
                        }

                        return;
                    }

                    // The caret is put back where it was, less whatever the correction removed
                    // before it, so typing into the middle of a name does not throw somebody to
                    // the end of it.
                    var at = correct(field, was.slice(0, field.selectionStart)).length;

                    field.value = now;

                    if (field.setSelectionRange) {
                        field.setSelectionRange(at, at);
                    }

                    if (note) {
                        note.hidden = false;
                    }
                });
            });
        })();
    </script>
    <script>
        // Whether a project's broker is rewriting its store, asked of the seats and never of a broker, so the answer comes
        // while a rewrite holds everything else up (SPEC.md §9.1). Every two seconds while the page is open.
        (function () {
            var shown = document.querySelector('[data-tidying]');

            if (!shown) { return; }

            setInterval(function () {
                fetch('/?handler=Tidying', { cache: 'no-store', credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (said) {
                        shown.textContent = said.join(' ');
                        shown.hidden = said.length === 0;
                    })
                    .catch(function () { });
            }, 2000);
        })();
    </script>
    <script>
        // The rail's collapse. Remembered in this browser only, and every access is guarded: storage can be absent or
        // refuse, and the rail must still work for the life of the page.
        (function () {
            var button = document.getElementById('rail-toggle');
            var root = document.documentElement;

            if (!button) { return; }

            var sync = function () {
                var collapsed = root.getAttribute('data-nav') === 'collapsed';
                button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                button.title = collapsed ? 'Expand the navigation' : 'Collapse the navigation';
            };

            button.addEventListener('click', function () {
                var collapsed = root.getAttribute('data-nav') === 'collapsed';

                if (collapsed) { root.removeAttribute('data-nav'); } else { root.setAttribute('data-nav', 'collapsed'); }

                try { localStorage.setItem('parley.nav', collapsed ? 'expanded' : 'collapsed'); } catch (e) { }
                sync();
            });

            sync();
        })();
    </script>
    @* **The keys of every box a person writes a message in** (ComposerBox), here once so no page has its own. Enter sends;
       Shift+Enter, Ctrl+Enter, or a backslash then Enter make a line break, as in the terminal. Left alone while an input
       method is composing, where Enter confirms the text and is not the person's send, and when something nearer the box
       took the key first (the @@name completion list). An empty box sends nothing unless files are attached. *@
    <script>
        (function () {
            function lineBreak(box, from, to) {
                box.setRangeText("\n", from, to, "end");
                box.dispatchEvent(new Event("input", { bubbles: true }));
            }

            document.addEventListener("keydown", function (e) {
                var box = e.target;

                if (!(box instanceof HTMLTextAreaElement) || !box.hasAttribute("data-composer")) { return; }
                if (e.key !== "Enter" || e.isComposing || e.altKey || e.metaKey || e.shiftKey || e.defaultPrevented) { return; }

                e.preventDefault();

                var at = box.selectionStart;

                if (e.ctrlKey) { lineBreak(box, at, box.selectionEnd); return; }
                if (at === box.selectionEnd && at > 0 && box.value.charAt(at - 1) === "\\") { lineBreak(box, at - 1, at); return; }

                var form = box.form;

                if (!form || (box.value.trim() === "" && !form.querySelector(".attachment"))) { return; }

                if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
            });
        })();
    </script>
    @* **Attaching to a message box, the same in every one** (SPEC.md §5.6; owner, 2026-11-13: a screenshot pasted in the
       Inbox did nothing, because only the conversation page carried this). A pasted or dropped file waits as a chip and
       goes with the form when it is sent, in the box's file input, because a page that took it straight away would leave
       a file behind for every message the person changed their mind about. An image's thumbnail is drawn from the
       person's own copy and never sent back. Each `data-attach` holder that `_Composer` draws is run here. *@
    <script>
        (function () {
            if (!window.DataTransfer || !window.File) { return; }

            var images = { "image/png": ".png", "image/jpeg": ".jpg", "image/gif": ".gif", "image/webp": ".webp" };

            function extension(name) { var at = name.lastIndexOf("."); return at < 0 ? "" : name.slice(at).toLowerCase(); }

            function carriesFiles(e) { return e.dataTransfer && [].indexOf.call(e.dataTransfer.types || [], "Files") >= 0; }

            function pastedName(ext) {
                var now = new Date();
                var two = function (n) { return String(n).padStart(2, "0"); };
                var random = Math.floor(Math.random() * 65536).toString(16).padStart(4, "0");

                return "pasted-" + now.getFullYear() + two(now.getMonth() + 1) + two(now.getDate())
                    + "-" + two(now.getHours()) + two(now.getMinutes()) + two(now.getSeconds()) + "-" + random + ext;
            }

            function attach(holder) {
                var form = holder.closest("form");
                var box = holder.querySelector("textarea[data-composer]");
                var list = holder.querySelector(".attachments");
                var input = holder.querySelector("input.attach-files");
                var note = holder.querySelector(".attach-note");

                if (!form || !box || !list || !input || !note) { return; }

                var types = (list.getAttribute("data-types") || "").split(" ");
                var limit = Number(list.getAttribute("data-paste-limit"));
                var needed = box.required;
                var files = [];

                function say(words) { note.textContent = words || ""; note.hidden = !words; }

                function sync() {
                    var carried = new DataTransfer();

                    files.forEach(function (f) { carried.items.add(f); });
                    input.files = carried.files;
                    box.required = needed && list.querySelector(".attachment") === null;
                }

                function add(file) {
                    if (types.indexOf(extension(file.name)) < 0) {
                        say(file.name + " was not attached. Only " + list.getAttribute("data-types-in-words") + " files can be.");
                        return;
                    }

                    if (files.some(function (f) { return f.name === file.name; })) {
                        say(file.name + " is already attached.");
                        return;
                    }

                    files.push(file);

                    var item = document.createElement("li");
                    var name = document.createElement("span");
                    var remove = document.createElement("button");
                    var mark = document.createElement("span");

                    item.className = "attachment";

                    if (images[file.type]) {
                        var image = document.createElement("img");

                        image.className = "attachment-tile";
                        image.alt = "";
                        image.src = URL.createObjectURL(file);
                        item.appendChild(image);
                    } else {
                        var tile = document.createElement("span");

                        tile.className = "attachment-tile";
                        tile.textContent = extension(file.name).slice(1).toUpperCase();
                        item.appendChild(tile);
                    }

                    name.className = "attachment-name";
                    name.title = file.name;
                    name.textContent = file.name;
                    item.appendChild(name);

                    remove.type = "button";
                    remove.className = "attachment-remove";
                    remove.setAttribute("aria-label", "Remove " + file.name);
                    mark.className = "icon";
                    mark.setAttribute("aria-hidden", "true");
                    mark.textContent = "close";
                    remove.appendChild(mark);
                    item.appendChild(remove);
                    item.parleyFile = file;
                    list.appendChild(item);
                }

                function addAll(chosen) { say(""); chosen.forEach(add); sync(); document.dispatchEvent(new CustomEvent("parley:compose")); }

                list.addEventListener("click", function (e) {
                    var button = e.target.closest ? e.target.closest(".attachment-remove") : null;

                    if (!button) { return; }

                    var item = button.closest(".attachment");
                    var image = item.querySelector("img");

                    if (image) { URL.revokeObjectURL(image.src); }

                    files = files.filter(function (f) { return f !== item.parleyFile; });
                    item.remove();
                    sync();
                    say("");
                    box.focus({ preventScroll: true });
                });

                // Words first when the clipboard holds both: a spreadsheet's cells arrive as text and as a picture of themselves.
                box.addEventListener("paste", function (e) {
                    var clip = e.clipboardData;

                    if (!clip) { return; }

                    var text = clip.getData("text/plain") || "";

                    if (text.length > limit) {
                        e.preventDefault();
                        addAll([new File([text], pastedName(".txt"), { type: "text/plain" })]);
                        return;
                    }

                    if (text.length > 0) { return; }

                    var pasted = [].slice.call(clip.files || []);

                    if (pasted.length === 0) { return; }

                    e.preventDefault();
                    addAll(pasted.map(function (f) {
                        return images[f.type] ? new File([f], pastedName(images[f.type]), { type: f.type }) : f;
                    }));
                });

                holder.parleyAttach = addAll;
                sync();
            }

            var holders = [].slice.call(document.querySelectorAll("[data-attach]"));

            holders.forEach(attach);

            // A drop goes to the box it lands on, or the one being written in, or the page's only one. Anywhere else it is
            // still taken, since a file let fall outside a box would otherwise make the browser leave the page.
            function holderFor(e) {
                var at = e.target instanceof Element ? e.target.closest("form") : null;
                var inForm = at ? at.querySelector("[data-attach]") : null;
                var focused = document.activeElement instanceof Element ? document.activeElement.closest("[data-attach]") : null;

                return inForm || focused || (holders.length === 1 ? holders[0] : null);
            }

            if (holders.length === 0) { return; }

            var shown = null;

            function unmark() { if (shown) { shown.classList.remove("dropping"); shown = null; } }

            document.addEventListener("dragover", function (e) {
                if (!carriesFiles(e)) { return; }

                e.preventDefault();

                var holder = holderFor(e);
                var form = holder ? holder.closest("form") : null;

                if (form !== shown) { unmark(); if (form) { form.classList.add("dropping"); shown = form; } }
            });

            document.addEventListener("dragleave", function (e) {
                if (!e.relatedTarget) { unmark(); }
            });

            document.addEventListener("drop", function (e) {
                unmark();

                if (!carriesFiles(e)) { return; }

                e.preventDefault();

                var holder = holderFor(e);

                if (holder && holder.parleyAttach) { holder.parleyAttach([].slice.call(e.dataTransfer.files)); }
            });
        })();
    </script>
    @* **Typing @@ offers the project's agents, in every message box** (ComposerBox; owner, 2026-11-13: it worked on the
       conversation page and not in the Inbox). The names are the box's `data-mentions`, which its page read from the
       registry. Choosing one completes the @@name in the words, which stay: it is part of what the person said. It never
       addresses anybody (a payload is never parsed for addressing, SPEC.md §13); where the form carries a `Targets` box for
       that agent, as the conversation page and a spin-off do, that box is ticked, and that is what addresses them. Arrow
       keys move, Enter or Tab choose, Escape closes. Taken in the capture phase, before the frame's Enter-sends handler. *@
    <script>
        (function () {
            var list = document.createElement("ul");
            var box = null;
            var shown = [];
            var at = 0;
            var start = -1;
            var choosing = false;

            list.id = "mention-list";
            list.className = "mention-list";
            list.setAttribute("role", "listbox");
            list.hidden = true;

            function close() { list.hidden = true; shown = []; start = -1; }

            function names(of) {
                return (of.getAttribute("data-mentions") || "").split(" ").filter(function (n) { return n !== ""; });
            }

            // The @@word being typed, if the caret is at the end of one that begins at a word boundary.
            function word(of) {
                var upto = of.value.slice(0, of.selectionStart);
                var m = /(^|\s)@@([A-Za-z0-9@@._\-]*)$/.exec(upto);

                return m ? { from: upto.length - m[2].length - 1, query: m[2].toLowerCase() } : null;
            }

            function target(form, name) {
                return form ? [].slice.call(form.elements).filter(function (el) {
                    return el instanceof HTMLInputElement && el.name === "Targets" && el.value === name;
                })[0] || null : null;
            }

            // Just above the box, inside its form, which is made the list's frame if nothing else positions it.
            function place() {
                var form = box.form;

                if (!form) { close(); return; }
                if (list.parentNode !== form) { form.appendChild(list); }
                if (getComputedStyle(form).position === "static") { form.style.position = "relative"; }

                list.style.left = box.offsetLeft + "px";
                list.style.width = box.offsetWidth + "px";
                list.style.bottom = (form.clientHeight - box.offsetTop) + "px";
            }

            function draw() {
                list.replaceChildren();

                shown.forEach(function (name, i) {
                    var li = document.createElement("li");
                    var ticked = target(box.form, name);

                    li.setAttribute("role", "option");
                    li.setAttribute("aria-selected", i === at ? "true" : "false");
                    li.textContent = name + (ticked && ticked.checked ? " (chosen)" : "");
                    li.addEventListener("mousedown", function (e) { e.preventDefault(); choose(name); });
                    list.appendChild(li);
                });

                list.hidden = shown.length === 0;

                if (!list.hidden) { place(); }
            }

            function update(e) {
                var typed = e.target;

                if (choosing || !(typed instanceof HTMLTextAreaElement) || !typed.hasAttribute("data-mentions")) { return; }

                box = typed;

                var w = word(box);

                if (!w) { close(); return; }

                start = w.from;
                shown = names(box).filter(function (n) { return n.toLowerCase().indexOf(w.query) >= 0; })
                    .sort(function (a, b) {
                        var x = a.toLowerCase().indexOf(w.query) === 0 ? 0 : 1;
                        var y = b.toLowerCase().indexOf(w.query) === 0 ? 0 : 1;

                        return x - y || a.localeCompare(b);
                    }).slice(0, 8);
                at = 0;
                draw();
            }

            function choose(name) {
                var end = box.selectionStart;
                var before = box.value.slice(0, start);
                var after = box.value.slice(end);

                // The mention stays in the words: it may be an instruction to that agent the others should see.
                var mention = "@@" + name + (/^\s/.test(after) ? "" : " ");

                box.value = before + mention + after;
                box.selectionStart = box.selectionEnd = before.length + mention.length;

                var ticked = target(box.form, name);

                if (ticked && !ticked.checked) {
                    ticked.checked = true;
                    ticked.dispatchEvent(new Event("change", { bubbles: true }));
                }

                close();
                box.focus();

                // Told as typing is, so the draft keeps the name; not offered again for the name just completed.
                choosing = true;
                box.dispatchEvent(new Event("input", { bubbles: true }));
                choosing = false;
            }

            document.addEventListener("input", update);
            document.addEventListener("click", update);
            document.addEventListener("focusout", function (e) { if (e.target === box) { close(); } });

            document.addEventListener("keydown", function (e) {
                if (list.hidden || e.target !== box) { return; }

                if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                    e.preventDefault();
                    at = (at + (e.key === "ArrowDown" ? 1 : shown.length - 1)) % shown.length;
                    draw();
                } else if (e.key === "Enter" || e.key === "Tab") {
                    e.preventDefault();
                    e.stopPropagation();
                    choose(shown[at]);
                } else if (e.key === "Escape") {
                    e.preventDefault();
                    close();
                }
            }, true);
        })();
    </script>
    @* Where an open grid row's line sticks: just under its grid's header, however tall the header is drawn (density, a
       wrapped label). *@
    <script>
        (function () {
            function measure(grid) {
                var head = grid.querySelector(".dgrid-head");

                if (head) { grid.style.setProperty("--dgrid-head-h", head.offsetHeight + "px"); }
            }

            document.querySelectorAll(".dgrid").forEach(function (grid) {
                measure(grid);

                var head = grid.querySelector(".dgrid-head");

                if (head && window.ResizeObserver) { new ResizeObserver(function () { measure(grid); }).observe(head); }
            });
        })();
    </script>
    @* **A message half written is kept until it is sent** (ComposerBox; owner, 2026-11-13: a reply half written in the Inbox
       was gone after answering another message first). Every box with a `data-draft` key saves its words in this browser as
       they are typed, and gets them back when it is drawn empty again: after a reload, a send elsewhere, or a return another
       day. A box the server drew with words in it shows those, since a refused send keeps exactly what was sent. A form
       that is sent drops its drafts; a send the page itself stopped was never sent and keeps them. Files are not kept: a
       page cannot hand back files the browser chose. *@
    <script>
        (function () {
            var prefix = "parley-draft:";
            var keepFor = 14 * 24 * 60 * 60 * 1000;
            var store;

            try { store = window.localStorage; store.getItem(prefix); } catch (e) { return; }

            function read(key) {
                try {
                    var kept = JSON.parse(store.getItem(prefix + key) || "null");

                    return kept && typeof kept.text === "string" ? kept.text : "";
                } catch (e) { return ""; }
            }

            function write(key, text) {
                try {
                    if (text.trim() === "") { store.removeItem(prefix + key); }
                    else { store.setItem(prefix + key, JSON.stringify({ text: text, at: Date.now() })); }
                } catch (e) { }
            }

            // A draft nobody came back to in two weeks answers something long settled.
            try {
                for (var i = store.length - 1; i >= 0; i--) {
                    var name = store.key(i);

                    if (name && name.indexOf(prefix) === 0) {
                        var old = null;

                        try { old = JSON.parse(store.getItem(name)); } catch (e) { }
                        if (!old || typeof old.at !== "number" || Date.now() - old.at > keepFor) { store.removeItem(name); }
                    }
                }
            } catch (e) { }

            document.querySelectorAll("textarea[data-composer][data-draft]").forEach(function (box) {
                var key = box.getAttribute("data-draft");

                if (box.value.trim() !== "") { write(key, box.value); return; }

                var text = read(key);

                if (text === "") { return; }

                box.value = text;

                // Shown, not only kept: a reply in a closed Inbox row opens it, and the conversation page's box comes back.
                var row = box.closest("details");

                if (row) { row.open = true; }
                box.dispatchEvent(new Event("input", { bubbles: true }));
                document.dispatchEvent(new CustomEvent("parley:compose"));
            });

            document.addEventListener("input", function (e) {
                var box = e.target;

                if (box instanceof HTMLTextAreaElement && box.hasAttribute("data-draft")) { write(box.getAttribute("data-draft"), box.value); }
            });

            document.addEventListener("submit", function (e) {
                if (e.defaultPrevented || !(e.target instanceof HTMLFormElement)) { return; }

                e.target.querySelectorAll("textarea[data-draft]").forEach(function (box) { write(box.getAttribute("data-draft"), ""); });
            });
        })();
    </script>
    @* **A reference to an exchange opens it under its line** (spec 036). MarkdownText draws "exchange #N" as a button with
       the number and nothing else; this asks the console for that exchange in the project of the message it is in, and
       puts it in a panel after the paragraph or list item the button is on. A second press closes it. Reading it changes
       nothing in the broker. *@
    <script>
        (function () {
            var made = 0;

            document.addEventListener("click", function (e) {
                var button = e.target instanceof Element ? e.target.closest("button.exchange-ref") : null;

                if (!button) { return; }

                e.preventDefault();

                var open = button.getAttribute("data-panel");

                if (open) {
                    var shown = document.getElementById(open);
                    if (shown) { shown.remove(); }
                    button.removeAttribute("data-panel");
                    button.setAttribute("aria-expanded", "false");
                    return;
                }

                var holder = button.closest("[data-project]");
                var number = button.getAttribute("data-exchange");

                if (!holder || !/^[0-9]+$/.test(number || "")) { return; }

                var line = button.closest("p, li, blockquote, td, th, h1, h2, h3, h4, h5, h6") || button.parentElement;
                var panel = document.createElement("div");

                panel.id = "exchange-panel-" + (++made);
                panel.className = "exchange-panel";
                panel.setAttribute("role", "region");
                panel.setAttribute("aria-label", "Exchange #" + number);
                panel.textContent = "Reading exchange #" + number + "…";
                line.insertAdjacentElement("afterend", panel);

                button.setAttribute("data-panel", panel.id);
                button.setAttribute("aria-expanded", "true");
                button.setAttribute("aria-controls", panel.id);

                var url = "/Exchanges/Panel?project=" + encodeURIComponent(holder.getAttribute("data-project")) + "&id=" + number;

                fetch(url, { credentials: "same-origin", headers: { "Accept": "text/html" } })
                    .then(function (answer) {
                        if (!answer.ok) { throw new Error(String(answer.status)); }
                        return answer.text();
                    })
                    .then(function (html) { panel.innerHTML = html; })
                    .catch(function () { panel.textContent = "Exchange #" + number + " could not be read. Press it again to close this."; });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
