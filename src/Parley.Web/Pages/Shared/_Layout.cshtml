                var tab = document.getElementById("pg-tab");
                var panel = document.getElementById("pg-panel");
                var body = document.getElementById("pg-body");
                var pin = document.getElementById("pg-pin");
                var hideClosed = document.getElementById("pg-hide-closed");
                var key = "parley.graph";
                var timer = null;
                var state = { open: false, pinned: false, hideClosed: false };

                function load() { try { var s = JSON.parse(localStorage.getItem(key) || "{}"); if (s && s.pinned) { state.pinned = true; state.open = !!s.open; } if (s && s.hideClosed) { state.hideClosed = true; } } catch (e) { } }
                function save() { try { localStorage.setItem(key, JSON.stringify(state)); } catch (e) { } }

                var drawn = null;
                var asked = 0;

                // Refreshed in place. The answer is swapped in only when it differs from what is drawn (its stamp aside), and what
                // the person had done to the panel is put back: the list they opened stays open, the link they were on keeps the
                // focus, and the panel stays where it was scrolled. The list is the picture's equal, so it must be readable for
                // longer than one refresh.
                function read() {
                    var mine = ++asked;

                    fetch("/Graph", { credentials: "same-origin", cache: "no-store", headers: { "Accept": "text/html" } })
                        .then(function (r) { if (!r.ok) { throw new Error(String(r.status)); } return r.text(); })
                        .then(function (html) {
                            // An older answer that lands after a newer one is dropped.
                            if (mine !== asked) { return; }

                            var same = html.replace(/data-asof="[^"]*"/, "");

                            if (same === drawn) { return; }

                            var list = body.querySelector(".pg-list");
                            var open = !!(list && list.open);
                            var on = document.activeElement;
                            var href = on && body.contains(on) ? on.getAttribute("href") : null;
                            var top = body.scrollTop;

                            body.innerHTML = html;
                            drawn = same;

                            if (open) { var again = body.querySelector(".pg-list"); if (again) { again.open = true; } }

                            if (href) {
                                var links = body.querySelectorAll("a[href]");
                                for (var i = 0; i < links.length; i++) {
                                    if (links[i].getAttribute("href") === href) { links[i].focus(); break; }
                                }
                            }

                            body.scrollTop = top;
                        })
                        .catch(function () {
                            if (mine !== asked) { return; }

                            // A graph already drawn stays: it is tried again on the timer, and one failed read is not worth losing it.
                            if (drawn === null) { body.textContent = "The graph could not be read. It is tried again every fifteen seconds while the panel is open."; }
                        });
                }

                // Pinned beside the page only in a large window (1200px and up). Below it the panel lays over the page, so a pin
                // would cover what it was pinned beside: it is not offered, Escape closes the panel, and a new page does not
                // reopen it.
                var wide = window.matchMedia("(min-width: 75rem)");
                function docked() { return state.pinned && wide.matches; }

                function draw() {
                    panel.hidden = !state.open;
                    tab.hidden = state.open && docked();
                    tab.setAttribute("aria-expanded", state.open ? "true" : "false");
                    Array.prototype.forEach.call(opens, function (b) { b.setAttribute("aria-expanded", state.open ? "true" : "false"); });
                    panel.classList.toggle("pg-pinned", docked());
                    panel.classList.toggle("pg-hide-closed", state.hideClosed);
                    document.body.classList.toggle("pg-docked", state.open && docked());
                    pin.hidden = !wide.matches;
                    pin.setAttribute("aria-pressed", state.pinned ? "true" : "false");
                    pin.textContent = state.pinned ? "Unpin" : "Pin";
                    hideClosed.checked = state.hideClosed;

                    if (timer) { clearInterval(timer); timer = null; }

                    if (state.open) {
                        read();
                        // Only while it is open, and no faster than a person can take it in.
                        timer = setInterval(read, 15000);
                    }
                }

                tab.addEventListener("click", function () { state.open = true; save(); draw(); });
                // On a phone the tab gives way to Graph under the bottom bar's More, which opens the same panel.
                var opens = document.querySelectorAll("[data-pg-open]");
                Array.prototype.forEach.call(opens, function (b) {
                    b.hidden = false;
                    b.addEventListener("click", function () { var menu = b.closest("details"); if (menu) { menu.open = false; } state.open = true; save(); draw(); });
                });
                document.getElementById("pg-close").addEventListener("click", function () { state.open = false; state.pinned = false; save(); draw(); });
                pin.addEventListener("click", function () { state.pinned = !state.pinned; save(); draw(); });
                hideClosed.addEventListener("change", function () { state.hideClosed = hideClosed.checked; save(); draw(); });
                document.addEventListener("keydown", function (e) { if (e.key === "Escape" && state.open && !docked()) { state.open = false; save(); draw(); } });

                if (wide.addEventListener) { wide.addEventListener("change", draw); }

                load();
                if (!wide.matches) { state.open = false; }
                draw();
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
