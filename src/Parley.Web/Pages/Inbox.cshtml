@page
@model Parley.Web.Pages.InboxModel
@using Parley.Core
@{
    ViewData["Title"] = "Waiting on you";
    ViewData["Grid"] = true;
    var waiting = Model.Projects.Sum(p => p.Waiting);
    var held = Model.Projects.Sum(p => p.Delivered.Count);

    var everything = Model.Projects
        .SelectMany(p => p.Delivered.Select(item => (Project: p.Project, Item: item)))
        .ToList();
    var shown = everything.Where(row => Model.Keep(row.Project, row.Item)).ToList();
}

@* The page is a data grid: a title, then Create, Filters and the grid, in that order. The first three stay where they are
   and the grid is what scrolls, with its header row held at its top. A message is one row; opening it shows the whole of it
   and the ways to answer it, and its line stays at the top of the grid while it is read, so who it is with and where are
   always in sight and a press closes it from anywhere in it. There is no column for what was said: a line of it never fit
   and told nothing the opened row does not (owner, 2026-11-13). *@

<div class="view">
    <div class="view-title">
        <h1>Waiting on you</h1>
        <p class="as-of" role="status">
            Results to send and questions to answer, across every project.
        </p>
    </div>

    @if (Model.Outcome is { Length: > 0 } said)
    {
        <p class="as-of" role="status">@said</p>
    }

    @{
        // The same view, as the page's own reload: the filters kept, and marked so it is not counted as somebody here.
        var reloadQuery = Microsoft.AspNetCore.Http.QueryString.Create(
            new[] { ("q", Model.Q), ("scope", Model.Scope), ("view", Model.View), ("older", Model.Older > 0 ? Model.Older.ToString(System.Globalization.CultureInfo.InvariantCulture) : null) }
                .Where(pair => !string.IsNullOrEmpty(pair.Item2))
                .Select(pair => new KeyValuePair<string, string?>(pair.Item1, pair.Item2))
                .Append(new KeyValuePair<string, string?>(Parley.Web.Seating.PersonSeats.Reloaded, "1")));
        var reloadUrl = "/Inbox" + reloadQuery;
    }
    @* **Following what changes** (owner's report, 2026-11-06). The page asks every five seconds whether what waits on or for
       the person moved, and reloads when it did; while somebody is writing here, or has a message opened, a reload would
       lose that, so the page says something changed and waits. The ask collects nothing. Without script, the link is
       how to see it. *@
    <p class="inbox-changed" role="status" id="inbox-changed" hidden
       data-digest="@Model.Digest" data-ask="/Inbox?handler=Digest" data-url="@reloadUrl">
        Something changed. <a href="@reloadUrl">Show it</a>
    </p>
    <script>
        (function () {
            var note = document.getElementById("inbox-changed");
            var seen = note.getAttribute("data-digest");
            var asking = false;

            function busy() {
                var focused = document.activeElement;
                if (focused && focused.matches("input, textarea, select")) { return true; }
                if (document.querySelector("dialog[open], details[open], .exchange-panel, main .attachment")) { return true; }
                return Array.prototype.some.call(document.querySelectorAll("main textarea"), function (box) { return box.value.trim() !== ""; });
            }

            function ask() {
                if (asking || document.hidden) { return; }
                asking = true;
                fetch(note.getAttribute("data-ask"), { headers: { "Accept": "application/json" }, cache: "no-store" })
                    .then(function (reply) { return reply.ok ? reply.json() : null; })
                    .then(function (said) {
                        if (!said || said.digest === seen) { return; }
                        if (busy()) { note.hidden = false; } else { location.replace(note.getAttribute("data-url")); }
                    })
                    .catch(function () { })
                    .then(function () { asking = false; });
            }

            setInterval(ask, 5000);
            document.addEventListener("visibilitychange", ask);
        })();
    </script>

    @if (everything.Count > 0)
    {
        @* **Asking, never closing** (SPEC.md §5.6). The words go out under the person's name, so they are shown before the
           press. Each agent closes the questions already answered when it replies; this page closes nothing. *@
        <form method="post" asp-page-handler="StillOpen" class="view-card still-open" aria-label="Ask which are still open">
            <p>
                Some of these may have been answered somewhere else. Ask each agent which of its questions are still open:
                each one gets a request from you in every conversation it has questions in, and closes the ones already
                answered when it replies.
            </p>
            <details>
                <summary>What each agent is sent</summary>
                <blockquote>@Parley.Client.Seating.StillOpen.Opening</blockquote>
                <p class="composer-note">Then each of its questions in that conversation, by exchange number, with the first
                    @Parley.Client.Seating.StillOpen.Quoted characters of what it asked.</p>
            </details>
            <button type="submit">Ask which are still open</button>
        </form>
    }

    @if (Model.Asked.Count > 0)
    {
        @* **Where each answer stands, read again on every load** (SPEC.md §5.6): the Request's exchange says whether the agent
           replied, and each question's says whether it is still open. Only the latest press is listed. *@
        <section class="view-card still-open-asked" aria-label="Agents asked which questions are still open">
            <h2>Asked which are still open</h2>
            <table>
                <thead>
                    <tr>
                        <th scope="col">Agent</th>
                        <th scope="col">Project</th>
                        <th scope="col">Conversation</th>
                        <th scope="col">Closed</th>
                        <th scope="col">State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Asked)
                    {
                        <tr>
                            <td><strong title="@row.Ask.Agent.Value">@row.Ask.Agent.Role</strong> <span class="faint">@@@row.Ask.Agent.Machine</span></td>
                            <td>@row.Ask.Project</td>
                            <td>
                                @if (row.Ask.Exchange is { } opened)
                                {
                                    <a href="/Conversations/Detail?project=@Uri.EscapeDataString(row.Ask.Project)&amp;id=@Uri.EscapeDataString(row.Ask.Conversation)">@row.Ask.Conversation</a>
                                }
                                else
                                {
                                    @row.Ask.Conversation
                                }
                            </td>
                            <td>@row.Closed of @row.Ask.Questions.Count</td>
                            <td><span class="asked-state">@row.State</span> <span class="faint">@row.Detail</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <details class="view-card view-create">
        <summary>Start a conversation</summary>
        @* **Starting one belongs beside the messages that come out of them.** Naming a conversation is what creates it, and
           the composer opens on the name. *@
        <form method="get" action="/Conversations/Detail">
            <div class="field">
                <label for="new-conversation-project">Project</label>
                <select id="new-conversation-project" name="project" required>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Project">@project.Project</option>
                    }
                </select>
            </div>
            <div class="field wide">
                <label for="new-conversation">Called</label>
                <input id="new-conversation" name="id" placeholder="what-it-is-about" required
                       maxlength="@ConversationName.Longest" pattern="@ConversationName.Pattern"
                       data-correct="@ConversationName.Allowed"
                       autocomplete="off" spellcheck="false"
                       aria-describedby="new-conversation-rule" />
            </div>
            <button type="submit">Start</button>
            <p id="new-conversation-rule" class="composer-note">
                @ConversationName.Rule
                <span id="new-conversation-corrected" role="status" hidden>
                    @ConversationName.WasCorrected.
                </span>
            </p>
        </form>
    </details>

    <form method="get" class="view-card view-filters" aria-label="Filter what is waiting on you">
        <div class="field wide">
            <label for="f-q">Search</label>
            <input id="f-q" name="q" value="@Model.Q" placeholder="who, conversation or words" autocomplete="off" />
        </div>
        <div class="field">
            <label for="f-scope">Project</label>
            <select id="f-scope" name="scope">
                <option value="">All projects</option>
                @foreach (var project in Model.Projects)
                {
                    <option value="@project.Project" selected="@(Model.Scope == project.Project ? "selected" : null)">@project.Project</option>
                }
            </select>
        </div>
        @if (Model.View is { Length: > 0 } keptView)
        {
            <input type="hidden" name="view" value="@keptView" />
        }
        <button type="submit">Filter</button>
        <a class="button quiet" href="/Inbox@(Model.View is { Length: > 0 } v ? $"?view={v}" : string.Empty)">Clear</a>
        @if (Model.Showing == Parley.Client.Seating.InboxView.WaitingOnYou)
        {
            <span class="tally">@shown.Count of @everything.Count</span>
        }
    </form>

    @{
        // The three views (spec 036), each a page of its own so it works with no script; the filters go with them.
        string ViewUrl(string? view)
        {
            var query = Microsoft.AspNetCore.Http.QueryString.Create(
                new[] { ("view", view), ("q", Model.Q), ("scope", Model.Scope) }
                    .Where(pair => !string.IsNullOrEmpty(pair.Item2))
                    .Select(pair => new KeyValuePair<string, string?>(pair.Item1, pair.Item2)));

            return "/Inbox" + query;
        }
    }
    <nav aria-label="Inbox views">
        <ul class="inbox-views">
            <li><a href="@ViewUrl(null)" aria-current="@(Model.Showing == Parley.Client.Seating.InboxView.WaitingOnYou ? "page" : null)">Waiting on you <span class="count">@Model.CountOf(Parley.Client.Seating.InboxView.WaitingOnYou)</span></a></li>
            <li><a href="@ViewUrl("flight")" aria-current="@(Model.Showing == Parley.Client.Seating.InboxView.InFlight ? "page" : null)">In flight <span class="count">@Model.CountOf(Parley.Client.Seating.InboxView.InFlight)</span></a></li>
            <li><a href="@ViewUrl("closed")" aria-current="@(Model.Showing == Parley.Client.Seating.InboxView.Closed ? "page" : null)">Closed <span class="count">@(Model.Older == 0 ? Model.CountOf(Parley.Client.Seating.InboxView.Closed).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")</span></a></li>
        </ul>
    </nav>

    @foreach (var (project, _, problem) in Model.Readings.Where(r => r.Problem is { Length: > 0 }))
    {
        @if (Model.Showing != Parley.Client.Seating.InboxView.WaitingOnYou)
        {
            <p class="unreachable" role="alert"><strong>@project</strong>: could not be read, so its exchanges are not listed. @problem</p>
        }
    }

    @if (Model.Showing != Parley.Client.Seating.InboxView.WaitingOnYou)
    {
        <partial name="_InboxRows" model="Model" />
    }
    else
    {

    @* What is waiting on the person is read from the broker, so it survives a restart of this console and is never what the
       console happened to show. Delivery is recorded as the page is drawn. A project whose broker did not answer says so. *@
    @foreach (var project in Model.Projects.Where(p => p.Problem is { Length: > 0 }))
    {
        <p class="unreachable" role="alert"><strong>@project.Project</strong>: @project.Problem</p>
    }

    @foreach (var line in Model.NotDelivered)
    {
        <p class="unreachable" role="alert">@line</p>
    }

    <section class="view-card dgrid" style="--cols: minmax(9rem, 1.2fr) 6rem minmax(7rem, 0.8fr) minmax(8rem, 1.2fr) 8rem 8rem; --min: 46rem;" aria-label="Waiting on you">
        <div class="dgrid-inner" role="table">
            <div class="dgrid-head" role="row">
                <span role="columnheader">From</span>
                <span role="columnheader">Type</span>
                <span role="columnheader">Project</span>
                <span role="columnheader">Conversation</span>
                <span role="columnheader">When</span>
                <span role="columnheader">Status</span>
            </div>

            @foreach (var (projectName, item) in shown)
            {
                var payload = Payload.Read(item.Message.PayloadJson);
                var owed = item.Items();

                <details class="dgrid-row" role="row" open="@Model.Kept(item.Message.ExchangeId)">
                    <summary class="dgrid-line">
                        <span role="cell">
                            <span class="who slot-@Palette.SlotFor(item.Message.From)" aria-hidden="true" style="display:inline-grid;vertical-align:middle;margin-right:0.5rem;width:1.6rem;height:1.6rem;font-size:0.58rem;">@Palette.BadgeFor(item.Message.From)</span>
                            <strong class="name" title="@item.Message.From.Value">@item.Message.From.Role</strong>
                            <span class="faint from-machine">@@@item.Message.From.Machine</span>
                        </span>
                        <span role="cell"><span class="tag">@item.Message.Type.ToString().ToLowerInvariant()</span></span>
                        <span role="cell">@projectName</span>
                        <span role="cell" class="faint">@(item.Message.ConversationId is { Length: > 0 } c ? c : "")</span>
                        <span role="cell" class="faint">@item.Message.CreatedUtc.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <span role="cell" class="alarm">@(item.OwesResult ? "Owes a result" : "Owes a reply")</span>
                    </summary>

                    <div class="dgrid-detail">
                        <article class="letter@(item.Owes ? " owed" : null)" data-project="@projectName">
                            <p class="attribution">
                                @* The name is the attested half and this is not: §11.3 constrains only the `parley:` prefix, so an
                                   agent may report any responder it likes. Shown because §11.3 exists so a reader can calibrate on
                                   what produced the words, and worded as a claim because that is all it is. *@
                                <span class="claims" title="What that agent says produced this. Not verified.">
                                    says @item.Message.ResponderModel
                                </span>
                                @if (item.Message.ConversationId is { Length: > 0 } conversation)
                                {
                                    <a href="/Conversations/Detail?project=@projectName&amp;id=@conversation#m@(item.Message.Id)">Open in @conversation, with what led to it</a>
                                }
                            </p>

                            <partial name="_MessageBody" model="payload" />

                            @if (item.OwesResult && owed.Count > 0)
                            {
                                @* One field per item the request carried. The broker checks the result against the
                                   stored request and names the items it expected when they differ, so this form
                                   cannot close the exchange on items nobody asked about. *@
                                <form method="post" asp-page-handler="Result" class="reply" enctype="multipart/form-data">
                                    <input type="hidden" name="For" value="@projectName" />
                                    <input type="hidden" name="Exchange" value="@item.Message.ExchangeId" />
                                    <input type="hidden" name="Conversation" value="@item.Message.ConversationId" />

                                    @* Files go with the first item's words: the form sends one Result, and its files are named once. *@
                                    @foreach (var id in owed)
                                    {
                                        <input type="hidden" name="Ids" value="@id" />
                                        <partial name="_Composer" model="@(new Parley.Web.ComposerBox(
                                            "Texts",
                                            Model.KeptText(item.Message.ExchangeId, id),
                                            Id: $"t-{item.Message.ExchangeId}-{id}",
                                            Rows: 2,
                                            Label: $"{id} — what was done, the answer, or what blocks it",
                                            ShowKeys: false,
                                            Attach: id == owed[0],
                                            Attached: id == owed[0] ? Model.KeptFiles(item.Message.ExchangeId, "Result") : null,
                                            Draft: $"{projectName}/result/{item.Message.ExchangeId}/{id}"))" />
                                        @* Labelled on screen, not only for a screen reader: an unlabelled "Done" read as a
                                           button or a state, not as the outcome the agent is told. *@
                                        <label for="v-@item.Message.ExchangeId-@id">Outcome for @id</label>
                                        <select name="Verdicts" id="v-@item.Message.ExchangeId-@id">
                                            @foreach (var (value, says) in SeatVoice.Outcomes)
                                            {
                                                <option value="@value" selected="@(Model.KeptVerdict(item.Message.ExchangeId, id) == value)">@says</option>
                                            }
                                        </select>
                                    }

                                    <p class="composer-note">
                                        Blocked is for a concrete blocker: something missing, a conflict, or a
                                        permission you do not have. Name who can resolve it. @ComposerBox.Keys
                                    </p>

                                    <button type="submit">Send result and close</button>
                                </form>
                            }

                            @if (item.Owes)
                            {
                                @* The other move a holder has: ask what was meant, or answer what they asked you.
                                   Either way the turn goes to them. *@
                                <form method="post" asp-page-handler="Clarify" class="reply" enctype="multipart/form-data">
                                    <input type="hidden" name="For" value="@projectName" />
                                    <input type="hidden" name="Exchange" value="@item.Message.ExchangeId" />
                                    <input type="hidden" name="Conversation" value="@item.Message.ConversationId" />
                                    <partial name="_Composer" model="@(new Parley.Web.ComposerBox(
                                        "Clarification",
                                        Model.Kept(item.Message.ExchangeId) ? Model.Clarification : null,
                                        Id: $"c-{item.Message.ExchangeId}",
                                        Rows: 2,
                                        Label: item.OwesReply ? "Your reply" : "Or ask them to clarify",
                                        Attach: true,
                                        Attached: Model.KeptFiles(item.Message.ExchangeId, "Clarify"),
                                        Draft: $"{projectName}/clarify/{item.Message.ExchangeId}"))" />
                                    <button type="submit">@(item.OwesReply ? "Reply" : "Ask")</button>
                                </form>
                                @* For a question gone stale or answered elsewhere. Nothing is said on the person's behalf: the
                                   broker writes that they closed it, and the conversation stays open. *@
                                <form method="post" asp-page-handler="Close" class="reply">
                                    <input type="hidden" name="For" value="@projectName" />
                                    <input type="hidden" name="Exchange" value="@item.Message.ExchangeId" />
                                    <label for="x-@item.Message.ExchangeId">Close without answering. Reason (optional; they are told it)</label>
                                    <input id="x-@item.Message.ExchangeId" name="Clarification" maxlength="1000" />
                                    <button type="submit" class="quiet">Close without answering</button>
                                </form>
                            }
                        </article>
                    </div>
                </details>
            }

            @if (shown.Count == 0)
            {
                <p class="dgrid-empty">
                    @if (Model.Projects.Count == 0)
                    {
                        @* **Not connected.** The broker provides the person seat and this console takes it on every
                           page. What this branch means is that no project's broker could be reached as the person
                           just then, and the next page load tries again. Mail waits against the name regardless,
                           which is why the count is still asked for. *@
                        @if (Model.Away is { Certain: true, Waiting: > 0 })
                        {
                            <text>Not connected as you just now. @Model.Away.Waiting
                            @(Model.Away.Waiting == 1 ? "message is" : "messages are") waiting for you. Load this page again to collect @(Model.Away.Waiting == 1 ? "it" : "them").</text>
                        }
                        else if (!Model.Away.Certain)
                        {
                            @* "Nothing waiting" and "could not ask" are different facts, and only one of them means stop looking
                               -- the same rule the frame's count is held to. *@
                            <text>Not connected as you just now, and the brokers could not be asked what is waiting for you. Load this page
                            again.</text>
                        }
                        else
                        {
                            <text>Not connected as you just now, and nothing is waiting for you.</text>
                        }
                    }
                    else if (waiting == 0 && held == 0)
                    {
                        <text>Nothing is waiting on you.</text>
                    }
                    else if (everything.Count > 0)
                    {
                        <text>Nothing waiting on you matches these filters.</text>
                    }
                    else
                    {
                        <text>Nothing is waiting on you.</text>
                    }
                </p>
            }
        </div>
    </section>
    }
</div>
