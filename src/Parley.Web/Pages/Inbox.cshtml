@page
@model Parley.Web.Pages.InboxModel
@{
    ViewData["Title"] = "Your messages";
    var waiting = Model.Projects.Sum(p => p.Waiting);
    var held = Model.Projects.Sum(p => p.Delivered.Count);
}

<h1>Your messages</h1>

@if (Model.Outcome is { Length: > 0 } said)
{
    <p class="as-of" role="status">@said</p>
}

<p class="lede">
    What participants have sent to <strong>@(Model.Me?.Name.Value)</strong>. Taking delivery is
    something you do on purpose rather than something that happens by opening this page: it marks
    what you were asked to do as picked up, and work picked up and left is shown to the person
    running the deployment. Until you take them, nothing is counted against you.
</p>

@foreach (var project in Model.Projects)
{
    <h2>@project.Project</h2>

    @if (project.Problem is { Length: > 0 } problem)
    {
        <p class="unreachable" role="alert">@problem</p>
    }
    else if (project.Waiting == 0 && project.Polls == 0)
    {
        <p class="because">Nothing is waiting here.</p>
    }
    else
    {
        <form method="post" asp-page-handler="Take">
            <input type="hidden" name="For" value="@project.Project" />
            <p class="composer-note">
                <strong>@project.Waiting</strong>
                message@(project.Waiting == 1 ? "" : "s")
                @if (project.Polls > 0)
                {
                    <text>and <strong>@project.Polls</strong> closure poll@(project.Polls == 1 ? "" : "s")</text>
                }
                waiting. Taking them marks them collected, and anything you are asked to do then
                counts as picked up. You cannot put them back.
            </p>
            <button type="submit">Take delivery</button>
        </form>
    }

    @foreach (var item in project.Delivered)
    {
        var payload = Payload.Read(item.Message.PayloadJson);
        var owed = item.Items();

        <article class="letter@(item.Owes ? " owed" : null)">
            <p class="attribution">
                <span class="who slot-@Palette.SlotFor(item.Message.From)" aria-hidden="true">@Palette.BadgeFor(item.Message.From)</span>
                <strong>@item.Message.From.Value</strong>
                <span class="tag">@item.Message.Type.ToString().ToLowerInvariant()</span>
                @* The name above is the attested half and this is not: §11.3 constrains only
                   the `parley:` prefix, so an agent may report any responder it likes — a peer
                   demonstrated it by sending a message here claiming `human:` and having it
                   stored. Shown because §11.3 exists so a reader can calibrate on what produced
                   the words, and worded as a claim because that is all it is. *@
                <span class="claims" title="What that agent says produced this. Not verified.">
                    says @item.Message.ResponderModel
                </span>
                <span class="stamp">@item.Message.CreatedUtc.ToLocalTime().ToString("d MMM HH:mm")</span>
                @if (item.Message.ConversationId is { Length: > 0 } conversation)
                {
                    <a href="/Conversations/Detail?project=@project.Project&amp;id=@conversation">in @conversation</a>
                }
            </p>

            @if (payload.Said is { Length: > 0 })
            {
                <p class="said">@payload.Said</p>
            }

            @if (payload.Points.Count > 0)
            {
                <ol class="points">
                    @foreach (var point in payload.Points)
                    {
                        <li>
                            <span class="label">@point.Id</span>
                            <span class="point-text">@point.Text</span>
                            @if (point.Outcome is { Length: > 0 } verdict)
                            {
                                <span class="verdict">@(point.Blocker is { } blocker ? $"{verdict}: {blocker.Replace('_', ' ')}" : verdict)</span>
                            }
                            else if (point.Kind is { Length: > 0 } kind)
                            {
                                <span class="verdict">@kind</span>
                            }
                        </li>
                    }
                </ol>
            }

            @if (payload.DoneWhen is { Length: > 0 } doneWhen)
            {
                <p class="because"><strong>Done when:</strong> @doneWhen</p>
            }

            @if (payload.Raw is { Length: > 0 } raw)
            {
                <pre><code>@raw</code></pre>
            }

            @if (item.OwesResult && owed.Count > 0)
            {
                @* One field per item the request carried. The broker checks the result against the
                   stored request and names the items it expected when they differ, so this form
                   cannot close the exchange on items nobody asked about. *@
                <form method="post" asp-page-handler="Result" class="reply">
                    <input type="hidden" name="For" value="@project.Project" />
                    <input type="hidden" name="Exchange" value="@item.Message.ExchangeId" />

                    @foreach (var id in owed)
                    {
                        <input type="hidden" name="Ids" value="@id" />
                        <label for="t-@item.Message.ExchangeId-@id">@id — what was done, the answer, or what blocks it</label>
                        <textarea id="t-@item.Message.ExchangeId-@id" name="Texts" rows="2"
                                  required></textarea>
                        <select name="Verdicts" aria-label="Outcome for @id">
                            @foreach (var (value, says) in SeatVoice.Outcomes)
                            {
                                <option value="@value">@says</option>
                            }
                        </select>
                    }

                    <p class="composer-note">
                        Blocked is for a concrete blocker: something missing, a conflict, or a
                        permission you do not have. Name who can resolve it.
                    </p>

                    <button type="submit">Send result and close</button>
                </form>
            }

            @if (item.Owes)
            {
                @* The other move a holder has: ask what was meant, or answer what they asked you.
                   Either way the turn goes to them. *@
                <form method="post" asp-page-handler="Clarify" class="reply">
                    <input type="hidden" name="For" value="@project.Project" />
                    <input type="hidden" name="Exchange" value="@item.Message.ExchangeId" />
                    <label for="c-@item.Message.ExchangeId">@(item.OwesReply ? "Your reply" : "Or ask them to clarify")</label>
                    <textarea id="c-@item.Message.ExchangeId" name="Clarification" rows="2" required></textarea>
                    <button type="submit">@(item.OwesReply ? "Reply" : "Ask")</button>
                </form>
            }
        </article>
    }
}

@if (held > 0 && Model.Projects.Any(p => p.Delivered.Any(one => !one.Owes)))
{
    <form method="post" asp-page-handler="Clear">
        <input type="hidden" name="For" value="@Model.Projects[0].Project" />
        <p class="composer-note">
            Results are finished once you have read them, and nothing takes them off this page but
            you. A request stays until you send its result — it is a debt, and a button that made
            it disappear would only hide an exchange somebody is still waiting on.
        </p>
        <button type="submit">Clear what I have read</button>
    </form>
}

@if (Model.Projects.Count == 0)
{
    <p class="unreachable">
        You are seated nowhere, so nothing can be waiting. <a href="/Join">Join</a> first.
    </p>
}
else if (waiting == 0 && held == 0)
{
    <p class="because">
        Nothing waiting and nothing outstanding. This page fills up when a participant sends you
        a request.
    </p>
}
