@page
@model Parley.Web.Pages.GraphModel
@using Parley.Client.Views
@{
    Layout = null;
    var picture = Model.Picture;
    static string Enc(string value) => Uri.EscapeDataString(value);
    static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n} {many}";
    var hiddenWords = picture.Hidden == 0 ? null : $"{Plural(picture.Hidden, "agent", "agents")} not working {(picture.Hidden == 1 ? "is" : "are")} hidden";
    var workingWords = Plural(picture.Working.Count, "agent", "agents") + " working";
    var filtered = Model.ChosenProjects.Count + Model.ChosenAgents.Count > 0;
    // The list is redrawn on every refresh, so its queue is bounded too; the rest is counted.
    const int ListedQueued = 20;
}
@* What is being worked on now (spec 041, reworked by feature 042 from the person's feedback). A fragment: the console's script
   puts it in the panel, sends the filter's choices back and moves and zooms the picture. Every fact in the picture is also in
   the list below it, so nothing depends on seeing a colour, a line or the picture at all. *@
<div class="pg" data-asof="@Model.AsOf.ToString("O")">
    <div class="pg-filters">
        <details class="pg-filter" data-pg-keep="filter">
            <summary class="button tonal"><span class="icon" aria-hidden="true">tune</span> Filter</summary>
            <div class="pg-filter-body">
                <fieldset>
                    <legend>Projects</legend>
                    @foreach (var name in picture.Projects)
                    {
                        <label class="toggle"><input type="checkbox" name="project" value="@name" checked="@Model.ChosenProjects.Contains(name)" /> <span>@name</span></label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Agents</legend>
                    @if (picture.Agents.Count == 0)
                    {
                        <p class="hint">No agent is registered yet.</p>
                    }
                    @foreach (var name in picture.Agents)
                    {
                        <label class="toggle"><input type="checkbox" name="agent" value="@name" checked="@Model.ChosenAgents.Contains(name)" /> <span>@name</span></label>
                    }
                </fieldset>
            </div>
        </details>
        @if (filtered)
        {
            <ul class="filter-chips" aria-label="Filtered on">
                @foreach (var name in Model.ChosenProjects)
                {
                    <li><button type="button" class="chip" data-pg-drop="project" value="@name" title="Take this filter off">Project: @name<span class="visually-hidden">, remove this filter</span> <span class="icon" aria-hidden="true">close</span></button></li>
                }
                @foreach (var name in Model.ChosenAgents)
                {
                    <li><button type="button" class="chip" data-pg-drop="agent" value="@name" title="Take this filter off">Agent: @name<span class="visually-hidden">, remove this filter</span> <span class="icon" aria-hidden="true">close</span></button></li>
                }
            </ul>
        }
    </div>

    @foreach (var problem in picture.Problems)
    {
        <p class="pg-note" role="status"><strong>@problem.Project</strong> @(problem.Unreachable ? "project, unreachable." : "project, could not be read in full.") @problem.Problem</p>
    }

    @if (picture.Working.Count == 0)
    {
        <p class="pg-empty">Nothing is being worked on right now@(filtered ? " in what is chosen" : "").@(hiddenWords is null ? "" : $" {hiddenWords}.")</p>
    }
    else
    {
        <div class="pg-canvas" tabindex="0" data-w="@picture.Width" data-h="@picture.Height"
             aria-label="The picture of what is being worked on. Drag or use the arrow keys to move it; plus and minus zoom.">
            <svg class="pg-svg" viewBox="0 0 @picture.Width @picture.Height" role="img" preserveAspectRatio="xMinYMin meet"
                 aria-label="Each working agent, what it holds, what waits for it and its background tasks. The same facts follow as a list.">
                @foreach (var edge in picture.Edges)
                {
                    <path class="pg-edge pg-edge-@edge.Kind" d="@edge.Path" />
                }
                @foreach (var box in picture.Boxes)
                {
                    var agent = box.Agent is { } a ? picture.Working[a] : null;
                    var x = box.X;
                    var y = box.Y;

                    @switch (box.Kind)
                    {
                        case WorkBoxKind.Root:
                            <g class="pg-node pg-root">
                                <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="14" />
                                <text x="@(x + (box.Width / 2))" y="@(y + 23)" text-anchor="middle" class="pg-title">Parley, now</text>
                                <text x="@(x + (box.Width / 2))" y="@(y + 41)" text-anchor="middle" class="pg-sub">@workingWords@(picture.Hidden > 0 ? $" · {picture.Hidden} hidden" : "")</text>
                            </g>
                            break;
                        case WorkBoxKind.Agent:
                            var home = agent!.Posts[0];
                            var frozen = agent.Posts.Any(p => p.Frozen);
                            <g class="pg-node pg-agent@(frozen ? " pg-frozen" : "")">
                                <title>@agent.Name: @agent.Now.Words</title>
                                <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="14" />
                                <a href="/Projects/Agent?project=@Enc(home.Project)&amp;agent=@Enc(home.Name)"><text x="@(x + 16)" y="@(y + 25)" class="pg-title">@WorkNow.NameLine(agent.Name)</text></a>
                                <text x="@(x + 16)" y="@(y + 45)" class="pg-sub">@agent.Now.Words@(agent.Posts.Count > 1 ? $" · {agent.Posts.Count} projects" : "")</text>
                            </g>
                            break;
                        case WorkBoxKind.Now:
                            var held = box.Index < agent!.Current.Count ? agent.Current[box.Index] : null;
                            @if (held is null)
                            {
                                <g class="pg-node pg-now">
                                    <title>A turn does not say what it is for, and it holds nothing it has not answered.</title>
                                    <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="12" />
                                    <text x="@(x + 14)" y="@(y + 22)" class="pg-tag">NOW</text>
                                    <text x="@(x + 14)" y="@(y + 42)" class="pg-title">Nothing it holds</text>
                                    <text x="@(x + 14)" y="@(y + 59)" class="pg-sub">It has answered everything it collected</text>
                                </g>
                            }
                            else
                            {
                                <g class="pg-node pg-now">
                                    <title>@held.Project, @held.Conversation, exchange #@held.Exchange: @held.Whole</title>
                                    <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="12" />
                                    <text x="@(x + 14)" y="@(y + 22)" class="pg-tag">NOW · @held.Project</text>
                                    <a href="/Conversations/Detail?project=@Enc(held.Project)&amp;id=@Enc(held.Conversation)"><text x="@(x + 14)" y="@(y + 42)" class="pg-title">@WorkNow.NameLine(held.Conversation) <tspan class="pg-sub">#@held.Exchange</tspan></text></a>
                                    <text x="@(x + 14)" y="@(y + 59)" class="pg-sub">@(held.Ask.Length > 0 ? held.Ask : "What was asked could not be read")</text>
                                </g>
                            }
                            break;
                        case WorkBoxKind.Queued:
                            var waits = agent!.Queued[box.Index];
                            <g class="pg-node pg-queued">
                                <title>@waits.Project, @waits.Conversation, exchange #@waits.Exchange, @(waits.AnswerWaits ? "a reply waits, not collected yet" : "not collected yet"): @waits.Whole</title>
                                <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="12" />
                                <text x="@(x + 14)" y="@(y + 21)" class="pg-tag">@(waits.AnswerWaits ? "REPLY WAITS" : "QUEUED") @(box.Index + 1) · @waits.Project</text>
                                <a href="/Conversations/Detail?project=@Enc(waits.Project)&amp;id=@Enc(waits.Conversation)"><text x="@(x + 14)" y="@(y + 40)" class="pg-title">@WorkNow.NameLine(waits.Conversation) <tspan class="pg-sub">#@waits.Exchange</tspan></text></a>
                                <text x="@(x + 14)" y="@(y + 56)" class="pg-sub">@(waits.Ask.Length > 0 ? waits.Ask : "What was asked could not be read")</text>
                            </g>
                            break;
                        case WorkBoxKind.Task:
                            <g class="pg-node pg-task">
                                <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="12" />
                                <text x="@(x + 14)" y="@(y + 18)" class="pg-tag">BACKGROUND</text>
                                <text x="@(x + 14)" y="@(y + 35)" class="pg-title">Background task @(box.Index + 1)</text>
                            </g>
                            break;
                        default:
                            var counted = box.Kind switch
                            {
                                WorkBoxKind.MoreHeld => "more it holds",
                                WorkBoxKind.MoreQueued => "more queued",
                                _ => "more background tasks",
                            };
                            <g class="pg-node pg-more">
                                <rect x="@x" y="@y" width="@box.Width" height="@box.Height" rx="10" />
                                <text x="@(x + 14)" y="@(y + 20)" class="pg-sub">@box.Index @counted</text>
                            </g>
                            break;
                    }
                }
            </svg>
        </div>
        <div class="pg-zoom" role="group" aria-label="Zoom">
            <button type="button" class="quiet" data-pg-zoom="out" aria-label="Zoom out"><span class="icon" aria-hidden="true">remove</span></button>
            <button type="button" class="quiet" data-pg-zoom="fit">Fit</button>
            <button type="button" class="quiet" data-pg-zoom="in" aria-label="Zoom in"><span class="icon" aria-hidden="true">add</span></button>
            @if (hiddenWords is not null)
            {
                <span class="pg-sub">@hiddenWords.</span>
            }
        </div>
    }

    <details class="pg-list" data-pg-keep="list">
        <summary>The same, as a list</summary>
        @if (picture.Working.Count == 0)
        {
            <p>No agent is working.</p>
        }
        @foreach (var agent in picture.Working)
        {
            <h3>@agent.Name</h3>
            <p>@agent.Now.Words</p>
            <ul>
                @if (agent.Current.Count == 0)
                {
                    <li>Holds nothing it has not answered.</li>
                }
                @foreach (var held in agent.Current.Take(ListedQueued))
                {
                    <li>Holds: <a href="/Conversations/Detail?project=@Enc(held.Project)&amp;id=@Enc(held.Conversation)">@held.Project, @held.Conversation</a>, exchange #@held.Exchange@(held.Whole.Length > 0 ? ": " + held.Whole : "")</li>
                }
                @if (agent.Current.Count > ListedQueued)
                {
                    <li>@(agent.Current.Count - ListedQueued) more it holds, not listed.</li>
                }
                @for (var n = 0; n < Math.Min(agent.Queued.Count, ListedQueued); n++)
                {
                    var waits = agent.Queued[n];
                    <li>Queued @(n + 1), @(waits.AnswerWaits ? "a reply waits, not collected yet" : "not collected yet"): <a href="/Conversations/Detail?project=@Enc(waits.Project)&amp;id=@Enc(waits.Conversation)">@waits.Project, @waits.Conversation</a>, exchange #@waits.Exchange@(waits.Whole.Length > 0 ? ": " + waits.Whole : "")</li>
                }
                @if (agent.Queued.Count > ListedQueued)
                {
                    <li>@(agent.Queued.Count - ListedQueued) more queued, not listed.</li>
                }
                @if (agent.Background > 0)
                {
                    <li>@(agent.Background == 1 ? "1 background task" : $"{agent.Background} background tasks") running.</li>
                }
            </ul>
            <p class="pg-acts">
                @foreach (var post in agent.Posts)
                {
                    var project = Enc(post.Project);
                    <a href="/Projects/Act?project=@project&amp;action=@(post.Frozen ? "unfreeze" : "freeze")&amp;subject=@Enc(post.Name)">@(post.Frozen ? "Unfreeze" : "Freeze") @(post.Name == agent.Name ? "" : post.Name + " ")in @post.Project</a>
                }
            </p>
        }
    </details>

    <details class="pg-list" data-pg-keep="projects">
        <summary>Every project</summary>
        <ul>
            @foreach (var name in picture.Projects)
            {
                var project = Enc(name);
                <li>
                    <a href="/Projects/Agents?project=@project">@name</a>:
                    <a href="/Projects/Act?project=@project&amp;action=freezeall&amp;subject=@project">Freeze all</a>,
                    <a href="/Projects/Act?project=@project&amp;action=unfreezeall&amp;subject=@project">Unfreeze all</a>
                </li>
            }
        </ul>
    </details>
</div>
