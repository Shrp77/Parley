@page
@model Parley.Web.Pages.IndexModel
@{
    ViewData["Refresh"] = "30";
    ViewData["Title"] = "Projects";
    ViewData["AsOf"] = Model.AsOf.ToString("HH:mm:ss");
}

<h1>Projects</h1>

@if (Model.ManifestProblem is { Length: > 0 } problem)
{
    <p class="unreachable" role="alert">
        This machine has a project manifest that could not be read: @problem
    </p>
}
else if (Model.Projects.Count == 0)
{
    @* An ordinary machine, not a broken one -- and the two must not render alike. *@
    <p>
        No projects are named on this machine. A deployment configured entirely by explicit paths
        is a supported way to run; to name one, use <code>parley project add</code>.
    </p>
}
else
{
    <ul>
        @foreach (var project in Model.Projects)
        {
            var health = Model.Health.TryGetValue(project.Name.Value, out var said)
                ? said
                : new ProjectHealth(null, "This project was not asked.");

            <li>
                <a href="/Projects/Agents?project=@project.Name.Value">@project.Name.Value</a>
                <span> — @project.Endpoint</span>
                @if (project.Description is { Length: > 0 } description)
                {
                    <p>@description</p>
                }
                @if (Model.Summaries.TryGetValue(project.Name.Value, out var summary) && summary.Reachable)
                {
                    @* What is in it, so "which project do I want" is answered before anything is
                       opened. Unreachable projects say so above instead; a count of zero there
                       would read as a project somebody has emptied. *@
                    <p class="summary">@summary.Line()</p>
                }
                @if (!health.Reachable)
                {
                    @* Contained here: one broker being down says nothing about the others, and
                       the row stays clickable because the operator may know something the
                       console does not. *@
                    <p class="unreachable" role="alert">@health.Problem</p>
                }
                else if (!health.Agrees)
                {
                    @* Named, never refused. What a version disagreement means for any particular
                       read is not knowable from the two numbers, and a console that locked the
                       operator out would remove the view at the moment it is most needed. Both
                       numbers are given, because "incompatible" alone cannot be acted on. *@
                    <p class="unreachable" role="alert">
                        This project's broker speaks @health.Speaks and this console was built
                        against @IndexModel.ConsoleSpeaks. The pages below still
                        open; what they show may be incomplete.
                    </p>
                }
            </li>
        }
    </ul>
}
