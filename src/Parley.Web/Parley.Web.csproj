<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The operator's console, and a third binary rather than a page bolted onto an existing one.

    It is a client of the Operators service exactly as Parley.Cli is, and it deliberately does not
    live inside Parley.Server. SPEC.md section 4 gives the store to one process; putting a web host
    in that process would hand it a route to the database that the architecture spends section 4
    denying it. Nor does it live in Parley.Cli: that is a short-lived console tool distributed as a
    dotnet tool, and fusing the two would put Kestrel on the dependency graph of every operator who
    only ever runs `parley agents`.

    Reading a deployment and seating a person are not web concerns, and they live in
    Parley.Client, which a terminal reads too. What is here is the part that knows what HTTP is:
    the host, the pages and the brand.

    References Client for all of that, plus Transport for the wire and Configuration for the
    project manifest. There is no SQLite here and there must never be one.
  -->
  <PropertyGroup>
    <RootNamespace>Parley.Web</RootNamespace>
    <AssemblyName>Parley.Web</AssemblyName>
    <IsPackable>false</IsPackable>

    <!--
      No static assets, so no manifest describing where they are. The console's one stylesheet
      is inlined in the layout, because a file has to survive `dotnet pack` into the tool that
      starts this console.

      Off rather than merely unused: the generated manifest records an absolute path to a
      wwwroot folder, and a stale one points at a directory that no longer exists, which fails
      every request at startup rather than degrading.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parley.Client\Parley.Client.csproj" />
    <ProjectReference Include="..\Parley.Configuration\Parley.Configuration.csproj" />
    <ProjectReference Include="..\Parley.Transport\Parley.Transport.csproj" />

    <!--
      Accepting an ownership line is something both surfaces do, and the component that
      writes those files is Parley.Setup, so the console references it.

      The rule is "no surface writes for an agent whose machine is not this one": a launch
      configuration is a file on the agent's machine and neither surface is guaranteed to be
      there. OwnershipLine.NotHere is that check, applied by both.

      Graph-legal and checked, not assumed: Parley.Setup reaches no store, so GraphTests'
      `Nothing_reachable_from_a_client_can_open_a_store` still holds for this project.
    -->
    <ProjectReference Include="..\Parley.Setup\Parley.Setup.csproj" />
  </ItemGroup>

  <!--
    The brand, embedded in the assembly rather than sitting beside it.

    Same reason the stylesheet is inlined in the layout: a file next to the binary has to survive
    `dotnet pack` into the tool that starts this console. A resource compiled into the DLL
    travels wherever the DLL does, so no arrangement of packing, publishing or installing can
    leave the page without its logo.

    Served by a route rather than embedded in the markup as data, because these are the only two
    things on the page a browser can cache; inlining them would put 19 KB into the HTML of every
    request instead of one.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Brand\icon.png" />
    <EmbeddedResource Include="Brand\wordmark.png" />
    <EmbeddedResource Include="Brand\material-symbols.woff2" />
  </ItemGroup>



</Project>
