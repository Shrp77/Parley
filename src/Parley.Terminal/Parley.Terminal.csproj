<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The operator's terminal surface, and its own tool rather than a subcommand of the broker's.

    Windows cannot replace a running executable, so while this lived inside `parley` every
    terminal change required stopping the broker. SPEC.md section 12 says what that costs: the
    node stops and tells every agent it started to quit, and the process holds everything the
    agent has learned. The churniest component in the repository was forcing the most expensive
    restart. `parley terminal` forwards here, parsing nothing.

    **There is no store here and there must never be.** GraphTests walks this project
    transitively, under the same rule Parley.Client and Parley.Web are held to. Everything on
    screen arrived over the transport from a broker that owns one, or out of a per-machine file
    the broker never sees.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>parley-terminal</AssemblyName>
    <RootNamespace>Parley.Terminal</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>parley-terminal</ToolCommandName>
    <PackageId>Parley.Terminal</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parley.Client\Parley.Client.csproj" />
    <ProjectReference Include="..\Parley.Configuration\Parley.Configuration.csproj" />
    <ProjectReference Include="..\Parley.Setup\Parley.Setup.csproj" />
    <ProjectReference Include="..\Parley.Transport\Parley.Transport.csproj" />
  </ItemGroup>

  <!--
    Version lives in Directory.Packages.props, as central package management requires: a Version
    attribute here is a restore error, not a preference.
  -->
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

</Project>
