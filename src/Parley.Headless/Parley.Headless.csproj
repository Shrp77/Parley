<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Headless adapter of SPEC.md section 11.1: the tier where the broker invokes the agent
    rather than waiting for it to call in. It is a project of its own rather than a folder in
    Parley.Mcp because it is a different adapter, and because Parley.Broker documents that it
    must not learn about adapters, and starting a process is exactly the knowledge that
    comment keeps out of the broker.

    It references Configuration (the node catalogue) and nothing that opens a store: a node
    reaches the broker over the wire.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Parley.Configuration\Parley.Configuration.csproj" />
  </ItemGroup>

</Project>
